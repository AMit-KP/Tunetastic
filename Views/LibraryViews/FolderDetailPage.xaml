<?xml version="1.0" encoding="utf-8" ?>
<views:SongListPageBase x:Class="Tunetastic.Views.LibraryViews.FolderDetailPage"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
                        xmlns:common="using:Tunetastic.Common"
                        xmlns:controls="using:CommunityToolkit.WinUI.Controls"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:dev="using:DevWinUI"
                        xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:scrubber="using:Tunetastic.Common.Controls"
                        xmlns:views="using:Tunetastic.Views.Common"
                        Loaded="Page_Loaded"
                        SizeChanged="Page_SizeChanged"
                        mc:Ignorable="d">

	<views:SongListPageBase.Resources>
		<MenuFlyout x:Key="RightClickMenu"
		            Opened="MenuFlyout_Opened">
			<MenuFlyoutItem Click="MenuFlyoutItemPlay_OnClick"
			                Text="Play"
			                ToolTipService.ToolTip="Play this item">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE768;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator x:Name="PlaylistSeparator" />
			<MenuFlyoutSubItem x:Name="AddToPlaylist"
			                   Text="Add to playlist">
				<MenuFlyoutSubItem.Icon>
					<FontIcon Glyph="&#xE728;" />
				</MenuFlyoutSubItem.Icon>
			</MenuFlyoutSubItem>
			<MenuFlyoutItem Click="MenuFlyoutItemAddToQueue_OnClick"
			                Text="Add to queue"
			                ToolTipService.ToolTip="Add this item to the queue">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE84F;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator x:Name="InfoSeparator" />
			<MenuFlyoutItem x:Name="InfoTagMenuItem"
			                Click="MenuFlyoutItemInfoTag_OnClick"
			                Text="Info/Tag">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE946;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator x:Name="DeleteSeparator" />
			<MenuFlyoutItem x:Name="DeleteMenuItem"
			                Click="MenuFlyoutItemDelete_OnClick"
			                Text="Delete"
			                ToolTipService.ToolTip="Delete this song/track">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE74D;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
		</MenuFlyout>
	</views:SongListPageBase.Resources>

	<Grid Margin="10,10,10,-10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid x:Name="HeaderRowGrid"
		      Grid.Row="0"
		      Margin="15,10,45,10"
		      ColumnSpacing="15"
		      RowSpacing="4">
			<Grid.RowDefinitions>
				<RowDefinition x:Name="BreadcrumbRowDef" Height="Auto" />
				<RowDefinition x:Name="TitleRowDef" Height="0" />
			</Grid.RowDefinitions>
			<Grid.ColumnDefinitions>
				<ColumnDefinition x:Name="BreadcrumbsColDef" Width="Auto" />
				<ColumnDefinition x:Name="TitleColDef" Width="*" />
				<ColumnDefinition x:Name="ButtonsColDef" Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel x:Name="BreadcrumbTrailContainer"
			            Grid.Row="0"
			            Grid.Column="0"
			            Orientation="Horizontal"
			            Spacing="8"
			            VerticalAlignment="Center">
				<Grid BorderBrush="Transparent"
				      Tapped="Folders_Tapped">
					<TextBlock x:Name="FoldersBreadcrumbText"
					           HorizontalAlignment="Left"
					           VerticalAlignment="Center"
					           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					           Style="{ThemeResource TitleTextBlockStyle}"
					           Text="Folders" />
				</Grid>
				<FontIcon x:Name="FoldersBreadcrumbChevron"
				          Margin="0,4,0,0"
				          HorizontalAlignment="Center"
				          VerticalAlignment="Center"
				          Glyph="&#xE974;" />
				<DropDownButton x:Name="BreadcrumbEllipsisButton"
				                Visibility="Collapsed"
				                Padding="6,2"
				                VerticalAlignment="Center">
					<TextBlock Text="···" FontSize="14" FontWeight="Bold" />
					<DropDownButton.Flyout>
						<MenuFlyout x:Name="BreadcrumbEllipsisFlyout" Placement="BottomEdgeAlignedLeft" />
					</DropDownButton.Flyout>
				</DropDownButton>
				<FontIcon x:Name="BreadcrumbEllipsisChevron"
				          Visibility="Collapsed"
				          Margin="0,4,0,0"
				          HorizontalAlignment="Center"
				          VerticalAlignment="Center"
				          Glyph="&#xE974;" />
				<StackPanel x:Name="BreadcrumbSegmentsPanel"
				            Orientation="Horizontal"
				            Spacing="8"
				            Visibility="Collapsed" />
			</StackPanel>

			<Grid x:Name="HeaderContainerGrid"
			      Grid.Row="0"
			      Grid.Column="1">
				<dev:AutoScrollView x:Name="AutoScrollHeader"
				                    IsPlaying="False">
					<TextBlock x:Name="ActualFolderGroup"
					           HorizontalAlignment="Left"
					           VerticalAlignment="Center"
					           Style="{ThemeResource TitleTextBlockStyle}"
					           TextTrimming="CharacterEllipsis"
					           TextWrapping="NoWrap" />
				</dev:AutoScrollView>
			</Grid>

			<StackPanel x:Name="PageButtons"
			            Grid.Row="0"
			            Grid.Column="2"
			            HorizontalAlignment="Right"
			            Orientation="Horizontal"
			            Spacing="15">
				<ToggleButton x:Name="MultiSelectButton"
				              Click="MultiSelectButton_Click"
				              ToolTipService.ToolTip="Turn on multi-select mode">
					<FontIcon Glyph="&#xE73A;" />
				</ToggleButton>
				<StackPanel x:Name="PlayAllButtonStackPanel"
				            Orientation="Horizontal"
				            Spacing="5">
					<Button x:Name="ShuffleAndPlay"
					        HorizontalAlignment="Right"
					        Click="ShuffleAndPlayButton_OnClick"
					        ToolTipService.ToolTip="Shuffle And Play All">
						<FontIcon Glyph="&#xE8B1;" />
					</Button>
					<Button x:Name="PlayAll"
					        HorizontalAlignment="Right"
					        Click="PlayAllButton_OnClick"
					        ToolTipService.ToolTip="Play All">
						<FontIcon Glyph="&#xF5B0;" />
					</Button>
				</StackPanel>
				<StackPanel x:Name="SortAndViewButtonPanel"
				            Orientation="Horizontal"
				            Spacing="5">
					<DropDownButton x:Name="SortDropDown"
					                HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="Sort"
							            Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="TitleSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Title" />
								<RadioMenuFlyoutItem x:Name="ArtistsSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Artists" />
								<RadioMenuFlyoutItem x:Name="AlbumSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Album" />
								<RadioMenuFlyoutItem x:Name="DurationSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Duration" />
								<RadioMenuFlyoutItem x:Name="TrackSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Track" />
								<MenuFlyoutSeparator />
								<RadioMenuFlyoutItem x:Name="Ascending"
								                     Click="SortButton_OnClick"
								                     GroupName="Order"
								                     Text="Ascending" />
								<RadioMenuFlyoutItem x:Name="Descending"
								                     Click="SortButton_OnClick"
								                     GroupName="Order"
								                     Text="Descending" />
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
					<DropDownButton x:Name="ViewButton"
					                HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="ViewStyle"
							            Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="ListViewStyle"
								                     Click="ViewButton_OnClick"
								                     GroupName="View"
								                     Text="List View">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE8FD;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
								<RadioMenuFlyoutItem x:Name="CompactViewStyle"
								                     Click="ViewButton_OnClick"
								                     GroupName="View"
								                     Text="Compact View">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE71D;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
				</StackPanel>
				<Button x:Name="MoreButton"
				        Visibility="Collapsed">
					<FontIcon Glyph="&#xE712;" />
					<Button.Flyout>
						<MenuFlyout x:Name="More"
						            Opened="MenuFlyout_Opened"
						            Placement="BottomEdgeAlignedRight">
							<MenuFlyoutSubItem Text="Add to playlist">
								<MenuFlyoutSubItem.Icon>
									<FontIcon Glyph="&#xE728;" />
								</MenuFlyoutSubItem.Icon>
							</MenuFlyoutSubItem>
							<MenuFlyoutItem Click="MenuFlyoutMultiItemAddToQueue_OnClick"
							                Text="Add to queue"
							                ToolTipService.ToolTip="Add selected songs/tracks to the queue">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE84F;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Click="MenuFlyoutMultiItemDelete_OnClick"
							                Text="Delete"
							                ToolTipService.ToolTip="Delete selected songs/tracks">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE74D;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</StackPanel>
		</Grid>
		<Grid x:Name="ContentGrid"
		      Grid.Row="1">
			<StackPanel x:Name="GoToSettings"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            Visibility="Collapsed">
				<TextBlock HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           HorizontalTextAlignment="Center"
				           Style="{ThemeResource SubtitleTextBlockStyle}"
				           Text="No songs or tracks found in this folder."
				           TextAlignment="Center"
				           TextWrapping="WrapWholeWords" />
				<Button HorizontalAlignment="Center"
				        VerticalAlignment="Center"
				        Click="GotoSettigsButton_Click"
				        Content="Open Settings" />
			</StackPanel>
			<StackPanel x:Name="LoadingProgress"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            Visibility="Collapsed">
				<dev:LoadingIndicator Mode="Arcs" />
				<Grid x:Name="CustomProgressBar"
				      Width="400"
				      Height="50"
				      Background="{ThemeResource AccentAAFillColorDisabled}"
				      BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
				      BorderThickness="2"
				      CornerRadius="5">
					<Rectangle x:Name="ProgressFill"
					           Height="50"
					           HorizontalAlignment="Left"
					           Fill="{ThemeResource AccentAAFillColorDefaultBrush}" />
					<Grid>
						<TextBlock x:Name="ProgressFillText"
						           HorizontalAlignment="Center"
						           VerticalAlignment="Center"
						           Style="{ThemeResource BodyStrongTextBlockStyle}" />
					</Grid>
				</Grid>
			</StackPanel>
			<Grid Width="Auto"
			      Height="Auto"
			      HorizontalAlignment="Center"
			      VerticalAlignment="Center">
				<ContentDialog x:Name="DeleteDialog"
				               Title="Confirm Deletion"
				               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
				               DefaultButton="Secondary"
				               PrimaryButtonText="Delete"
				               SecondaryButtonText="Cancel"
				               Visibility="Collapsed">
					<StackPanel Spacing="10">
						<TextBlock x:Name="DeleteDialogText"
						           Style="{ThemeResource BodyTextBlockStyle}"
						           TextWrapping="WrapWholeWords" />
						<TextBlock Foreground="Red"
						           Style="{ThemeResource BodyStrongTextBlockStyle}"
						           Text="This action cannot be undone."
						           TextWrapping="WrapWholeWords" />
					</StackPanel>
				</ContentDialog>
			</Grid>

			<Grid x:Name="FolderDetailListViewGrid">
				<ListView x:Name="FolderDetailListView"
				          Margin="10,10,10,10"
				          Padding="0,0,35,0"
				          VerticalAlignment="Top"
				          IsItemClickEnabled="True"
				          IsMultiSelectCheckBoxEnabled="False"
				          IsRightTapEnabled="True"
				          ItemClick="ListView_ItemClick"
				          ItemsSource="{x:Bind FolderGroupSongs}"
				          ScrollViewer.CanContentRenderOutsideBounds="False"
				          ScrollViewer.VerticalScrollBarVisibility="Hidden"
				          ScrollViewer.VerticalScrollMode="Enabled"
				          SelectionChanged="ListView_SelectionChanged"
				          SelectionMode="Single">

					<ListView.ItemsPanel>
						<ItemsPanelTemplate>
							<ItemsStackPanel Orientation="Vertical" />
						</ItemsPanelTemplate>
					</ListView.ItemsPanel>

					<ListView.Header>
						<Border Height="40"
						        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
						        BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
						        BorderThickness="0,0,0,2"
						        CornerRadius="8">

							<interactivity:Interaction.Behaviors>
								<behaviors:StickyHeaderBehavior />
							</interactivity:Interaction.Behaviors>

							<controls:DataTable x:Name="Header"
							                    Margin="12,0,0,0"
							                    ColumnSpacing="10">
								<controls:DataColumn DesiredWidth="40" />
								<controls:DataColumn Content="Title"
								                     DesiredWidth="350"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
								<controls:DataColumn Content="Artists"
								                     DesiredWidth="*"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
								<controls:DataColumn DesiredWidth="*">
									<TextBlock FontWeight="Bold"
									           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
									           Text="Album" />
								</controls:DataColumn>
								<controls:DataColumn Content="Duration"
								                     DesiredWidth="120"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
							</controls:DataTable>
						</Border>
					</ListView.Header>

					<ListView.ItemTemplate>
						<DataTemplate x:DataType="common:Song">
							<controls:DataRow HorizontalAlignment="Left"
							                  Background="Transparent"
							                  ContextFlyout="{StaticResource RightClickMenu}">
								<Grid Width="40"
								      Height="60"
								      Margin="0,2,0,2"
								      CornerRadius="10">
									<Image VerticalAlignment="Center"
									       Source="{x:Bind Cover, Converter={StaticResource CoverImageConverter}}"
									       Visibility="{x:Bind IsFolder, Converter={StaticResource InvertedBoolToVisibility}}" />
									<Grid HorizontalAlignment="Center"
									      VerticalAlignment="Center"
									      Visibility="{x:Bind IsFolder, Converter={StaticResource BoolToVisibility}}">
										<FontIcon HorizontalAlignment="Center"
										          VerticalAlignment="Center"
										          FontSize="22"
										          Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
										          Glyph="&#xE838;" />
										<Border HorizontalAlignment="Right"
										        VerticalAlignment="Bottom"
										        Margin="0,0,-8,-12"
										        MinWidth="15"
										        Height="14"
										        Padding="3,0"
										        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
										        BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
										        BorderThickness="1"
										        CornerRadius="7">
											<ToolTipService.ToolTip>
												<TextBlock>
													<Run FontWeight="Bold" Text="{x:Bind FolderSongCount}" />
													<Run Text=" songs" />
												</TextBlock>
											</ToolTipService.ToolTip>
											<TextBlock HorizontalAlignment="Center"
											           VerticalAlignment="Center"
											           FontSize="9"
											           FontWeight="SemiBold"
											           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
											           Text="{x:Bind FolderSongCount}"
											           TextAlignment="Center" />
										</Border>
									</Grid>
								</Grid>
								<TextBlock x:Name="FolderTitleTextBlock"
								           HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Text="{x:Bind Title}"
								           TextTrimming="CharacterEllipsis">
									<ToolTipService.ToolTip>
										<TextBlock TextTrimming="CharacterEllipsis"
										           TextWrapping="WrapWholeWords">
											<Run Text="{x:Bind Title}" />
										</TextBlock>
									</ToolTipService.ToolTip>
								</TextBlock>
								<Grid HorizontalAlignment="Stretch"
								      VerticalAlignment="Center">
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           Text="{x:Bind Artists}"
									           TextTrimming="CharacterEllipsis"
									           Visibility="{x:Bind IsFolder, Converter={StaticResource InvertedBoolToVisibility}}">
										<ToolTipService.ToolTip>
											<TextBlock TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<Run Text="Artists: " />
												<Run FontWeight="Bold"
												     Text="{x:Bind Artists}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
								</Grid>
								<Grid HorizontalAlignment="Stretch"
								      VerticalAlignment="Center">
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           Text="{x:Bind Album}"
									           TextTrimming="CharacterEllipsis"
									           Visibility="{x:Bind IsFolder, Converter={StaticResource InvertedBoolToVisibility}}">
										<ToolTipService.ToolTip>
											<TextBlock TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<Run Text="Album: " />
												<Run FontWeight="Bold"
												     Text="{x:Bind Album}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
								</Grid>
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           HorizontalTextAlignment="Left"
								           Text="{x:Bind Duration, Converter={StaticResource DurationConverter}}"
								           TextTrimming="CharacterEllipsis">
									<ToolTipService.ToolTip>
										<TextBlock>
											<Run Text="Duration: " />
											<Run FontWeight="Bold"
											     Text="{x:Bind Duration, Converter={StaticResource DurationToFullTimeConverter}}" />
										</TextBlock>
									</ToolTipService.ToolTip>
								</TextBlock>
							</controls:DataRow>
						</DataTemplate>
					</ListView.ItemTemplate>
					<ListView.ItemContainerStyle>
						<Style BasedOn="{StaticResource DefaultListViewItemStyle}"
						       TargetType="ListViewItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListView.ItemContainerStyle>
					<ListView.ItemContainerTransitions>
						<TransitionCollection>
							<AddDeleteThemeTransition />
						</TransitionCollection>
					</ListView.ItemContainerTransitions>
				</ListView>
			</Grid>

			<Grid x:Name="FolderDetailCompactViewGrid">
				<ListView x:Name="FolderDetailCompactView"
				          Margin="10,10,10,10"
				          Padding="0,0,35,0"
				          VerticalAlignment="Top"
				          IsItemClickEnabled="True"
				          IsMultiSelectCheckBoxEnabled="False"
				          IsRightTapEnabled="True"
				          ItemClick="ListView_ItemClick"
				          ItemsSource="{x:Bind FolderGroupSongs}"
				          ScrollViewer.CanContentRenderOutsideBounds="False"
				          ScrollViewer.VerticalScrollBarVisibility="Hidden"
				          ScrollViewer.VerticalScrollMode="Enabled"
				          SelectionChanged="ListView_SelectionChanged"
				          SelectionMode="Single">

					<ListView.ItemsPanel>
						<ItemsPanelTemplate>
							<ItemsStackPanel Orientation="Vertical" />
						</ItemsPanelTemplate>
					</ListView.ItemsPanel>

					<ListView.ItemTemplate>
						<DataTemplate x:DataType="common:Song">
							<Grid Background="Transparent"
							      ContextFlyout="{StaticResource RightClickMenu}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Grid Grid.Column="0"
								      HorizontalAlignment="Left"
								      VerticalAlignment="Center">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="100" />
											<ColumnDefinition Width="20" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Grid Grid.Column="0"
										      Width="100"
										      Height="100"
										      Margin="0,10,0,10">
											<Grid HorizontalAlignment="Center"
											      VerticalAlignment="Center"
											      CornerRadius="10">
												<Image HorizontalAlignment="Center"
												       VerticalAlignment="Center"
												       Source="{x:Bind Cover, Converter={StaticResource CoverImageConverter}}"
												       Visibility="{x:Bind IsFolder, Converter={StaticResource InvertedBoolToVisibility}}" />
											</Grid>
											<Grid HorizontalAlignment="Center"
											      VerticalAlignment="Center"
											      Visibility="{x:Bind IsFolder, Converter={StaticResource BoolToVisibility}}">
												<FontIcon HorizontalAlignment="Center"
												          VerticalAlignment="Center"
												          FontSize="54"
												          Foreground="{ThemeResource AccentAAFillColorDefaultBrush}"
												          Glyph="&#xE838;" />
												<Border HorizontalAlignment="Right"
												        VerticalAlignment="Bottom"
												        Margin="0,0,-12,-18"
												        MinWidth="20"
												        Height="19"
												        Padding="5,1"
												        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
												        BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
												        BorderThickness="1"
												        CornerRadius="9.5">
													<ToolTipService.ToolTip>
														<TextBlock>
															<Run FontWeight="Bold" Text="{x:Bind FolderSongCount}" />
															<Run Text=" songs" />
														</TextBlock>
													</ToolTipService.ToolTip>
													<TextBlock HorizontalAlignment="Center"
													           VerticalAlignment="Center"
													           FontSize="10"
													           FontWeight="SemiBold"
													           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
													           Text="{x:Bind FolderSongCount}"
													           TextAlignment="Center" />
												</Border>
											</Grid>
										</Grid>
										<StackPanel Grid.Column="2"
										            HorizontalAlignment="Left"
										            VerticalAlignment="Center"
										            Orientation="Vertical"
										            Spacing="5">
											<TextBlock x:Name="FolderTitleTextBlock"
											           HorizontalAlignment="Left"
											           VerticalAlignment="Center"
											           MaxLines="2"
											           Style="{ThemeResource SubtitleTextBlockStyle}"
											           Text="{x:Bind Title}"
											           TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<ToolTipService.ToolTip>
													<TextBlock TextTrimming="CharacterEllipsis"
													           TextWrapping="WrapWholeWords">
														<Run Text="{x:Bind Title}" />
													</TextBlock>
												</ToolTipService.ToolTip>
											</TextBlock>
											<TextBlock HorizontalAlignment="Left"
											           VerticalAlignment="Center"
											           MaxLines="2"
											           Style="{ThemeResource BodyStrongTextBlockStyle}"
											           Text="{x:Bind Artists}"
											           TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords"
											           Visibility="{x:Bind IsFolder, Converter={StaticResource InvertedBoolToVisibility}}">
												<ToolTipService.ToolTip>
													<TextBlock TextTrimming="CharacterEllipsis"
													           TextWrapping="WrapWholeWords">
														<Run Text="Artists: " />
														<Run FontWeight="Bold"
														     Text="{x:Bind Artists}" />
													</TextBlock>
												</ToolTipService.ToolTip>
											</TextBlock>
											<TextBlock HorizontalAlignment="Left"
											           VerticalAlignment="Center"
											           MaxLines="2"
											           Style="{ThemeResource BodyStrongTextBlockStyle}"
											           Text="{x:Bind Album}"
											           TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords"
											           Visibility="{x:Bind IsFolder, Converter={StaticResource InvertedBoolToVisibility}}">
												<ToolTipService.ToolTip>
													<TextBlock TextTrimming="CharacterEllipsis"
													           TextWrapping="WrapWholeWords">
														<Run Text="Album: " />
														<Run FontWeight="Bold"
														     Text="{x:Bind Album}" />
													</TextBlock>
												</ToolTipService.ToolTip>
											</TextBlock>
										</StackPanel>
									</Grid>
								</Grid>
								<Grid Grid.Column="1"
								      Width="120"
								      HorizontalAlignment="Right"
								      VerticalAlignment="Center">
									<Grid.RowDefinitions>
										<RowDefinition Height="60" />
										<RowDefinition Height="45" />
									</Grid.RowDefinitions>
									<Grid Grid.Row="1"
									      VerticalAlignment="Center">
										<TextBlock HorizontalAlignment="Right"
										           VerticalAlignment="Bottom"
										           HorizontalTextAlignment="Right"
										           Style="{ThemeResource BodyStrongTextBlockStyle}"
										           Text="{x:Bind Duration, Converter={StaticResource DurationConverter}}">
											<ToolTipService.ToolTip>
												<TextBlock>
													<Run Text="Duration: " />
													<Run FontWeight="Bold"
													     Text="{x:Bind Duration, Converter={StaticResource DurationToFullTimeConverter}}" />
												</TextBlock>
											</ToolTipService.ToolTip>
										</TextBlock>
									</Grid>
									<Grid Grid.Row="0"
									      VerticalAlignment="Center"
									      Visibility="{x:Bind IsFolder, Converter={StaticResource InvertedBoolToVisibility}}">
										<TextBlock HorizontalAlignment="Right"
										           VerticalAlignment="Top"
										           Style="{ThemeResource BodyStrongTextBlockStyle}"
										           Text="{x:Bind Year}">
											<ToolTipService.ToolTip>
												<TextBlock>
													<Run Text="Year: " />
													<Run FontWeight="Bold"
													     Text="{x:Bind Year}" />
												</TextBlock>
											</ToolTipService.ToolTip>
										</TextBlock>
									</Grid>
								</Grid>
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
					<ListView.ItemContainerStyle>
						<Style BasedOn="{StaticResource DefaultListViewItemStyle}"
						       TargetType="ListViewItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListView.ItemContainerStyle>
					<ListView.ItemContainerTransitions>
						<TransitionCollection>
							<AddDeleteThemeTransition />
						</TransitionCollection>
					</ListView.ItemContainerTransitions>
				</ListView>
			</Grid>

			<scrubber:AlphabetScrubber x:Name="AlphabetScrubber" />
		</Grid>
	</Grid>
</views:SongListPageBase>
