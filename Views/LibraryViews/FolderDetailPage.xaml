<?xml version="1.0" encoding="utf-8" ?>
<views:SongListPageBase x:Class="Tunetastic.Views.LibraryViews.FolderDetailPage"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
                        xmlns:common="using:Tunetastic.Common"
                        xmlns:controls="using:CommunityToolkit.WinUI.Controls"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:dev="using:DevWinUI"
                        xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:scrubber="using:Tunetastic.Common.Controls"
                        xmlns:views="using:Tunetastic.Views.Common"
                        Loaded="Page_Loaded"
                        SizeChanged="Page_SizeChanged"
                        mc:Ignorable="d">

	<views:SongListPageBase.Resources>
		<MenuFlyout x:Key="RightClickMenu"
		            Opened="MenuFlyout_Opened">
			<MenuFlyoutItem Click="MenuFlyoutItemPlay_OnClick"
			                Text="Play"
			                ToolTipService.ToolTip="Play this song/track">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE768;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutSubItem x:Name="AddToPlaylist"
			                   Text="Add to playlist">
				<MenuFlyoutSubItem.Icon>
					<FontIcon Glyph="&#xE728;" />
				</MenuFlyoutSubItem.Icon>
			</MenuFlyoutSubItem>
			<MenuFlyoutItem Click="MenuFlyoutItemAddToQueue_OnClick"
			                Text="Add to queue"
			                ToolTipService.ToolTip="Add this song/track to the queue">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE84F;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutItem Click="MenuFlyoutItemInfoTag_OnClick"
			                Text="Info/Tag">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE946;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutItem Click="MenuFlyoutItemDelete_OnClick"
			                Text="Delete"
			                ToolTipService.ToolTip="Delete this song/track">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE74D;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
		</MenuFlyout>

		<MenuFlyout x:Key="SubFolderRightClickMenu">
			<MenuFlyoutItem Click="SubFolderPlay_OnClick"
			                Text="Play"
			                ToolTipService.ToolTip="Play this folder">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE768;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutItem Click="SubFolderAddToQueue_OnClick"
			                Text="Add to queue"
			                ToolTipService.ToolTip="Add this folder to the queue">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE84F;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
		</MenuFlyout>
	</views:SongListPageBase.Resources>

	<Grid Margin="10,10,10,-10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid Grid.Row="0"
		      Margin="15,10,45,10"
		      ColumnSpacing="15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<Grid Grid.Column="0"
			      HorizontalAlignment="Stretch"
			      ColumnSpacing="10">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>
				<Grid Grid.Column="0"
				      BorderBrush="Transparent"
				      Tapped="Folders_Tapped">
					<TextBlock HorizontalAlignment="Left"
					           VerticalAlignment="Center"
					           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					           Style="{ThemeResource TitleTextBlockStyle}"
					           Text="Folders" />
				</Grid>
				<FontIcon Grid.Column="1"
				          Margin="0,4,0,0"
				          HorizontalAlignment="Center"
				          VerticalAlignment="Center"
				          Glyph="&#xE974;" />
				<StackPanel x:Name="BreadcrumbSegmentsPanel"
				            Grid.Column="2"
				            Orientation="Horizontal"
				            Spacing="10"
				            Visibility="Collapsed" />
				<Grid Grid.Column="3">
					<dev:AutoScrollView x:Name="AutoScrollHeader"
					                    IsPlaying="False">
						<TextBlock x:Name="ActualFolderGroup"
						           HorizontalAlignment="Left"
						           VerticalAlignment="Center"
						           Style="{ThemeResource TitleTextBlockStyle}" />
					</dev:AutoScrollView>
				</Grid>
			</Grid>

			<StackPanel x:Name="PageButtons"
			            Grid.Column="1"
			            HorizontalAlignment="Right"
			            Orientation="Horizontal"
			            Spacing="15">
				<ToggleButton x:Name="MultiSelectButton"
				              Click="MultiSelectButton_Click"
				              ToolTipService.ToolTip="Turn on multi-select mode">
					<FontIcon Glyph="&#xE73A;" />
				</ToggleButton>
				<StackPanel x:Name="PlayAllButtonStackPanel"
				            Orientation="Horizontal"
				            Spacing="5">
					<Button x:Name="ShuffleAndPlay"
					        HorizontalAlignment="Right"
					        Click="ShuffleAndPlayButton_OnClick"
					        ToolTipService.ToolTip="Shuffle And Play All">
						<FontIcon Glyph="&#xE8B1;" />
					</Button>
					<Button x:Name="PlayAll"
					        HorizontalAlignment="Right"
					        Click="PlayAllButton_OnClick"
					        ToolTipService.ToolTip="Play All">
						<FontIcon Glyph="&#xF5B0;" />
					</Button>
				</StackPanel>
				<StackPanel x:Name="SortAndViewButtonPanel"
				            Orientation="Horizontal"
				            Spacing="5">
					<DropDownButton x:Name="SortDropDown"
					                HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="Sort"
							            Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="TitleSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Title" />
								<RadioMenuFlyoutItem x:Name="ArtistsSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Artists" />
								<RadioMenuFlyoutItem x:Name="AlbumSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Album" />
								<RadioMenuFlyoutItem x:Name="DurationSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Duration" />
								<RadioMenuFlyoutItem x:Name="TrackSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Track" />
								<MenuFlyoutSeparator />
								<RadioMenuFlyoutItem x:Name="Ascending"
								                     Click="SortButton_OnClick"
								                     GroupName="Order"
								                     Text="Ascending" />
								<RadioMenuFlyoutItem x:Name="Descending"
								                     Click="SortButton_OnClick"
								                     GroupName="Order"
								                     Text="Descending" />
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
					<DropDownButton x:Name="ViewButton"
					                HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="ViewStyle"
							            Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="ListViewStyle"
								                     Click="ViewButton_OnClick"
								                     GroupName="View"
								                     Text="List View">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE8FD;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
								<RadioMenuFlyoutItem x:Name="CompactViewStyle"
								                     Click="ViewButton_OnClick"
								                     GroupName="View"
								                     Text="Compact View">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE71D;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
				</StackPanel>
				<Button x:Name="MoreButton"
				        Visibility="Collapsed">
					<FontIcon Glyph="&#xE712;" />
					<Button.Flyout>
						<MenuFlyout x:Name="More"
						            Opened="MenuFlyout_Opened"
						            Placement="BottomEdgeAlignedRight">
							<MenuFlyoutSubItem Text="Add to playlist">
								<MenuFlyoutSubItem.Icon>
									<FontIcon Glyph="&#xE728;" />
								</MenuFlyoutSubItem.Icon>
							</MenuFlyoutSubItem>
							<MenuFlyoutItem Click="MenuFlyoutMultiItemAddToQueue_OnClick"
							                Text="Add to queue"
							                ToolTipService.ToolTip="Add selected songs/tracks to the queue">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE84F;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Click="MenuFlyoutMultiItemDelete_OnClick"
							                Text="Delete"
							                ToolTipService.ToolTip="Delete selected songs/tracks">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE74D;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</StackPanel>
		</Grid>
		<Grid x:Name="ContentGrid"
		      Grid.Row="1">
			<Grid.RowDefinitions>
				<RowDefinition x:Name="SubFoldersRowDefinition" Height="Auto" />
				<RowDefinition x:Name="SongsRowDefinition" Height="*" />
			</Grid.RowDefinitions>

			<StackPanel x:Name="GoToSettings"
			            Grid.RowSpan="2"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            Visibility="Collapsed">
				<TextBlock HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           HorizontalTextAlignment="Center"
				           Style="{ThemeResource SubtitleTextBlockStyle}"
				           Text="No songs or tracks found in this folder."
				           TextAlignment="Center"
				           TextWrapping="WrapWholeWords" />
				<Button HorizontalAlignment="Center"
				        VerticalAlignment="Center"
				        Click="GotoSettigsButton_Click"
				        Content="Open Settings" />
			</StackPanel>
			<StackPanel x:Name="LoadingProgress"
			            Grid.RowSpan="2"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            Visibility="Collapsed">
				<dev:LoadingIndicator Mode="Arcs" />
				<Grid x:Name="CustomProgressBar"
				      Width="400"
				      Height="50"
				      Background="{ThemeResource AccentAAFillColorDisabled}"
				      BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
				      BorderThickness="2"
				      CornerRadius="5">
					<Rectangle x:Name="ProgressFill"
					           Height="50"
					           HorizontalAlignment="Left"
					           Fill="{ThemeResource AccentAAFillColorDefaultBrush}" />
					<Grid>
						<TextBlock x:Name="ProgressFillText"
						           HorizontalAlignment="Center"
						           VerticalAlignment="Center"
						           Style="{ThemeResource BodyStrongTextBlockStyle}" />
					</Grid>
				</Grid>
			</StackPanel>
			<Grid Grid.RowSpan="2"
			      Width="Auto"
			      Height="Auto"
			      HorizontalAlignment="Center"
			      VerticalAlignment="Center">
				<ContentDialog x:Name="DeleteDialog"
				               Title="Confirm Deletion"
				               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
				               DefaultButton="Secondary"
				               PrimaryButtonText="Delete"
				               SecondaryButtonText="Cancel"
				               Visibility="Collapsed">
					<StackPanel Spacing="10">
						<TextBlock x:Name="DeleteDialogText"
						           Style="{ThemeResource BodyTextBlockStyle}"
						           TextWrapping="WrapWholeWords" />
						<TextBlock Foreground="Red"
						           Style="{ThemeResource BodyStrongTextBlockStyle}"
						           Text="This action cannot be undone."
						           TextWrapping="WrapWholeWords" />
					</StackPanel>
				</ContentDialog>
			</Grid>

			<!-- Subfolders section (for hierarchical view) -->
			<Grid x:Name="SubFoldersSection"
			      Grid.Row="0"
			      Margin="0,0,0,10"
			      Visibility="Collapsed">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>
				<TextBlock x:Name="SubFoldersHeader"
				           Grid.Row="0"
				           Margin="15,0,0,5"
				           Style="{ThemeResource SubtitleTextBlockStyle}"
				           Text="Subfolders" />
				<ListView x:Name="SubFolderTileView"
				          Grid.Row="1"
				          Margin="10,0,10,0"
				          Padding="12,0"
				          ScrollViewer.VerticalScrollBarVisibility="Hidden"
				          VerticalAlignment="Top"
				          HorizontalContentAlignment="Stretch"
				          ContainerContentChanging="SubFolderTileView_ContainerContentChanging"
				          IsItemClickEnabled="True"
				          IsMultiSelectCheckBoxEnabled="False"
				          IsRightTapEnabled="True"
				          ItemClick="SubFolderTileView_ItemClick"
				          ItemsSource="{x:Bind SubFolders}"
				          SelectionMode="None"
				          SizeChanged="SubFolderTileView_SizeChanged">
					<ListView.ItemsPanel>
						<ItemsPanelTemplate>
							<ItemsWrapGrid ItemHeight="170"
							               ItemWidth="220"
							               Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ListView.ItemsPanel>

					<ListView.ItemContainerTransitions>
						<TransitionCollection>
							<RepositionThemeTransition />
						</TransitionCollection>
					</ListView.ItemContainerTransitions>

					<ListView.ItemContainerStyle>
						<Style TargetType="ListViewItem">
							<Setter Property="Margin" Value="10,15,10,15" />
							<Setter Property="Template">
								<Setter.Value>
									<ControlTemplate TargetType="ListViewItem">
										<Grid x:Name="TileRoot"
										      Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondary}"
										      BorderBrush="{ThemeResource SystemAccentColor}"
										      BorderThickness="2"
										      CornerRadius="25">
											<VisualStateManager.VisualStateGroups>
												<VisualStateGroup x:Name="CommonStates">
													<VisualState x:Name="Normal" />
													<VisualState x:Name="PointerOver">
														<Storyboard>
															<ColorAnimation Storyboard.TargetName="TileRoot"
															                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
															                To="{StaticResource SystemAccentColor}"
															                Duration="0:0:0.2" />
														</Storyboard>
													</VisualState>
													<VisualState x:Name="Pressed">
														<Storyboard>
															<ColorAnimation Storyboard.TargetName="TileRoot"
															                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
															                To="{StaticResource AccentFillColorDisabled}"
															                Duration="0:0:0.1" />
														</Storyboard>
													</VisualState>
													<VisualState x:Name="Selected">
														<Storyboard>
															<ColorAnimation Storyboard.TargetName="TileRoot"
															                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
															                To="{ThemeResource SystemAccentColor}"
															                Duration="0:0:0.2" />
														</Storyboard>
													</VisualState>
												</VisualStateGroup>
											</VisualStateManager.VisualStateGroups>

											<ContentPresenter Width="150"
											                  Height="110"
											                  Margin="0"
											                  HorizontalAlignment="Center"
											                  VerticalAlignment="Center" />
										</Grid>
									</ControlTemplate>
								</Setter.Value>
							</Setter>
						</Style>
					</ListView.ItemContainerStyle>

					<ListView.ItemTemplate>
						<DataTemplate x:DataType="common:FolderModel">
							<Grid Background="Transparent"
							      ContextFlyout="{StaticResource SubFolderRightClickMenu}">
								<ToolTipService.ToolTip>
									<TextBlock TextTrimming="CharacterEllipsis"
									           TextWrapping="WrapWholeWords">
										<Run FontWeight="Bold"
										     Text="{x:Bind Name}" />
										<LineBreak />
										<Run Text="Path: " />
										<Run Text="{x:Bind Path}" />
										<LineBreak />
										<Run Text="Songs: " />
										<Run FontWeight="Bold"
										     Text="{x:Bind TotalSongCount}" />
										<LineBreak />
										<Run Text="Total Duration: " />
										<LineBreak />
										<Run FontWeight="Bold"
										     Text="{x:Bind TotalDuration, Converter={StaticResource DurationToFullTimeConverter}}" />
									</TextBlock>
								</ToolTipService.ToolTip>
								<TextBlock x:Name="SubFolderTextBlock"
								           HorizontalAlignment="Center"
								           VerticalAlignment="Center"
								           FontStyle="Normal"
								           FontWeight="Bold"
								           Style="{ThemeResource TitleTextBlockStyle}"
								           Text="{x:Bind Name}"
								           TextAlignment="Center"
								           TextTrimming="CharacterEllipsis"
								           TextWrapping="WrapWholeWords" />
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Bottom"
								           FontStyle="Normal"
								           FontWeight="SemiBold"
								           Style="{ThemeResource CaptionTextBlockStyle}"
								           Text="{x:Bind TotalSongCount}" />
								<TextBlock HorizontalAlignment="Right"
								           VerticalAlignment="Bottom"
								           FontStyle="Normal"
								           FontWeight="SemiBold"
								           Style="{ThemeResource CaptionTextBlockStyle}"
								           Text="{x:Bind TotalDuration, Converter={StaticResource DurationConverter}}" />
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
				</ListView>
			</Grid>

			<!-- Songs list row -->
			<Grid Grid.Row="1">
				<Grid x:Name="FolderDetailListViewGrid">
					<ListView x:Name="FolderDetailListView"
					          Margin="10,10,10,10"
					          Padding="0,0,35,0"
					          VerticalAlignment="Top"
					          IsItemClickEnabled="True"
					          IsMultiSelectCheckBoxEnabled="False"
					          IsRightTapEnabled="True"
					          ItemClick="ListView_ItemClick"
					          ItemsSource="{x:Bind FolderGroupSongs}"
					          ScrollViewer.CanContentRenderOutsideBounds="False"
					          ScrollViewer.VerticalScrollBarVisibility="Hidden"
					          ScrollViewer.VerticalScrollMode="Enabled"
					          SelectionChanged="ListView_SelectionChanged"
					          SelectionMode="Single">

						<ListView.ItemsPanel>
							<ItemsPanelTemplate>
								<ItemsStackPanel Orientation="Vertical" />
							</ItemsPanelTemplate>
						</ListView.ItemsPanel>

						<ListView.Header>
							<Border Height="40"
							        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
							        BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
							        BorderThickness="0,0,0,2"
							        CornerRadius="8">

								<interactivity:Interaction.Behaviors>
									<behaviors:StickyHeaderBehavior />
								</interactivity:Interaction.Behaviors>

								<controls:DataTable x:Name="Header"
								                    Margin="12,0,0,0"
								                    ColumnSpacing="10">
									<controls:DataColumn DesiredWidth="40" />
									<controls:DataColumn Content="Title"
									                     DesiredWidth="350"
									                     FontWeight="Bold"
									                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
									<controls:DataColumn Content="Artists"
									                     DesiredWidth="*"
									                     FontWeight="Bold"
									                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
									<controls:DataColumn DesiredWidth="*">
										<TextBlock FontWeight="Bold"
										           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
										           Text="Album" />
									</controls:DataColumn>
									<controls:DataColumn Content="Duration"
									                     DesiredWidth="120"
									                     FontWeight="Bold"
									                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
								</controls:DataTable>
							</Border>
						</ListView.Header>

						<ListView.ItemTemplate>
							<DataTemplate x:DataType="common:Song">
								<controls:DataRow HorizontalAlignment="Left"
								                  Background="Transparent"
								                  ContextFlyout="{StaticResource RightClickMenu}">
									<Grid Width="40"
									      Height="60"
									      Margin="0,2,0,2"
									      CornerRadius="10">
										<Image VerticalAlignment="Center"
										       Source="{x:Bind Cover, Converter={StaticResource CoverImageConverter}}" />
									</Grid>
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           Text="{x:Bind Title}"
									           TextTrimming="CharacterEllipsis">
										<ToolTipService.ToolTip>
											<TextBlock TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<Run Text="Title: " />
												<Run FontWeight="Bold"
												     Text="{x:Bind Title}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           Text="{x:Bind Artists}"
									           TextTrimming="CharacterEllipsis">
										<ToolTipService.ToolTip>
											<TextBlock TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<Run Text="Artists: " />
												<Run FontWeight="Bold"
												     Text="{x:Bind Artists}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           Text="{x:Bind Album}"
									           TextTrimming="CharacterEllipsis">
										<ToolTipService.ToolTip>
											<TextBlock TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<Run Text="Album: " />
												<Run FontWeight="Bold"
												     Text="{x:Bind Album}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           HorizontalTextAlignment="Left"
									           Text="{x:Bind Duration, Converter={StaticResource DurationConverter}}"
									           TextTrimming="CharacterEllipsis">
										<ToolTipService.ToolTip>
											<TextBlock>
												<Run Text="Duration: " />
												<Run FontWeight="Bold"
												     Text="{x:Bind Duration, Converter={StaticResource DurationToFullTimeConverter}}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
								</controls:DataRow>
							</DataTemplate>
						</ListView.ItemTemplate>
						<ListView.ItemContainerStyle>
							<Style BasedOn="{StaticResource DefaultListViewItemStyle}"
							       TargetType="ListViewItem">
								<Setter Property="HorizontalContentAlignment" Value="Stretch" />
							</Style>
						</ListView.ItemContainerStyle>
						<ListView.ItemContainerTransitions>
							<TransitionCollection>
								<AddDeleteThemeTransition />
							</TransitionCollection>
						</ListView.ItemContainerTransitions>
					</ListView>
				</Grid>

				<Grid x:Name="FolderDetailCompactViewGrid">
					<ListView x:Name="FolderDetailCompactView"
					          Margin="10,10,10,10"
					          Padding="0,0,35,0"
					          VerticalAlignment="Top"
					          IsItemClickEnabled="True"
					          IsMultiSelectCheckBoxEnabled="False"
					          IsRightTapEnabled="True"
					          ItemClick="ListView_ItemClick"
					          ItemsSource="{x:Bind FolderGroupSongs}"
					          ScrollViewer.CanContentRenderOutsideBounds="False"
					          ScrollViewer.VerticalScrollBarVisibility="Hidden"
					          ScrollViewer.VerticalScrollMode="Enabled"
					          SelectionChanged="ListView_SelectionChanged"
					          SelectionMode="Single">

						<ListView.ItemsPanel>
							<ItemsPanelTemplate>
								<ItemsStackPanel Orientation="Vertical" />
							</ItemsPanelTemplate>
						</ListView.ItemsPanel>

						<ListView.ItemTemplate>
							<DataTemplate x:DataType="common:Song">
								<Grid Background="Transparent"
								      ContextFlyout="{StaticResource RightClickMenu}">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Grid Grid.Column="0"
									      HorizontalAlignment="Left"
									      VerticalAlignment="Center">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="100" />
												<ColumnDefinition Width="20" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Grid Grid.Column="0"
											      Width="100"
											      Height="100"
											      Margin="0,10,0,10">
												<Grid Width="Auto"
												      Height="Auto"
												      HorizontalAlignment="Center"
												      VerticalAlignment="Center"
												      CornerRadius="10">
													<Image HorizontalAlignment="Center"
													       VerticalAlignment="Center"
													       Source="{x:Bind Cover, Converter={StaticResource CoverImageConverter}}" />
												</Grid>
											</Grid>
											<StackPanel Grid.Column="2"
											            HorizontalAlignment="Center"
											            VerticalAlignment="Center"
											            Orientation="Vertical"
											            Spacing="5">
												<TextBlock HorizontalAlignment="Left"
												           VerticalAlignment="Center"
												           MaxLines="2"
												           Style="{ThemeResource SubtitleTextBlockStyle}"
												           Text="{x:Bind Title}"
												           TextTrimming="CharacterEllipsis"
												           TextWrapping="WrapWholeWords">
													<ToolTipService.ToolTip>
														<TextBlock TextTrimming="CharacterEllipsis"
														           TextWrapping="WrapWholeWords">
															<Run Text="Title: " />
															<Run FontWeight="Bold"
															     Text="{x:Bind Title}" />
														</TextBlock>
													</ToolTipService.ToolTip>
												</TextBlock>
												<TextBlock HorizontalAlignment="Left"
												           VerticalAlignment="Center"
												           MaxLines="2"
												           Style="{ThemeResource BodyStrongTextBlockStyle}"
												           Text="{x:Bind Artists}"
												           TextTrimming="CharacterEllipsis"
												           TextWrapping="WrapWholeWords">
													<ToolTipService.ToolTip>
														<TextBlock TextTrimming="CharacterEllipsis"
														           TextWrapping="WrapWholeWords">
															<Run Text="Artists: " />
															<Run FontWeight="Bold"
															     Text="{x:Bind Artists}" />
														</TextBlock>
													</ToolTipService.ToolTip>
												</TextBlock>
												<TextBlock HorizontalAlignment="Left"
												           VerticalAlignment="Center"
												           MaxLines="2"
												           Style="{ThemeResource BodyStrongTextBlockStyle}"
												           Text="{x:Bind Album}"
												           TextTrimming="CharacterEllipsis"
												           TextWrapping="WrapWholeWords">
													<ToolTipService.ToolTip>
														<TextBlock TextTrimming="CharacterEllipsis"
														           TextWrapping="WrapWholeWords">
															<Run Text="Album: " />
															<Run FontWeight="Bold"
															     Text="{x:Bind Album}" />
														</TextBlock>
													</ToolTipService.ToolTip>
												</TextBlock>
											</StackPanel>
										</Grid>
									</Grid>
									<Grid Grid.Column="1"
									      Width="120"
									      HorizontalAlignment="Right"
									      VerticalAlignment="Center">
										<Grid.RowDefinitions>
											<RowDefinition Height="60" />
											<RowDefinition Height="45" />
										</Grid.RowDefinitions>
										<Grid Grid.Row="0"
										      HorizontalAlignment="Right"
										      VerticalAlignment="Center">
											<TextBlock HorizontalAlignment="Right"
											           VerticalAlignment="Center"
											           HorizontalTextAlignment="Right"
											           Style="{ThemeResource TitleTextBlockStyle}"
											           Text="{x:Bind Duration, Converter={StaticResource DurationConverter}}"
											           TextTrimming="CharacterEllipsis">
												<ToolTipService.ToolTip>
													<TextBlock>
														<Run Text="Duration: " />
														<Run FontWeight="Bold"
														     Text="{x:Bind Duration, Converter={StaticResource DurationToFullTimeConverter}}" />
													</TextBlock>
												</ToolTipService.ToolTip>
											</TextBlock>
										</Grid>
										<Grid Grid.Row="1"
										      HorizontalAlignment="Right"
										      VerticalAlignment="Center">
											<TextBlock HorizontalAlignment="Right"
											           VerticalAlignment="Center"
											           HorizontalTextAlignment="Right"
											           Style="{ThemeResource SubtitleTextBlockStyle}"
											           Text="{x:Bind Year}"
											           TextTrimming="CharacterEllipsis" />
										</Grid>
									</Grid>
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
						<ListView.ItemContainerStyle>
							<Style BasedOn="{StaticResource DefaultListViewItemStyle}"
							       TargetType="ListViewItem">
								<Setter Property="HorizontalContentAlignment" Value="Stretch" />
							</Style>
						</ListView.ItemContainerStyle>
						<ListView.ItemContainerTransitions>
							<TransitionCollection>
								<AddDeleteThemeTransition />
							</TransitionCollection>
						</ListView.ItemContainerTransitions>
					</ListView>
				</Grid>

				<scrubber:AlphabetScrubber x:Name="AlphabetScrubber" />
			</Grid>
		</Grid>
	</Grid>
</views:SongListPageBase>
