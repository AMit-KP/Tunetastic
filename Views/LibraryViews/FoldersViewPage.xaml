<?xml version="1.0" encoding="utf-8" ?>
<views:SongListPageBase x:Class="Tunetastic.Views.LibraryViews.FoldersViewPage"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
                        xmlns:common="using:Tunetastic.Common"
                        xmlns:controls="using:CommunityToolkit.WinUI.Controls"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:dev="using:DevWinUI"
                        xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:scrubber="using:Tunetastic.Common.Controls"
                        xmlns:views="using:Tunetastic.Views.Common"
                        Loaded="Page_Loaded"
                        SizeChanged="Page_SizeChanged"
                        mc:Ignorable="d">

	<views:SongListPageBase.Resources>
		<MenuFlyout x:Key="RightClickMenu"
		            Opened="MenuFlyout_Opened">
			<MenuFlyoutItem Click="MenuFlyoutItemPlay_OnClick"
			                Text="Play"
			                ToolTipService.ToolTip="Play this song/track">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE768;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutSubItem x:Name="AddToPlaylist"
			                   Text="Add to playlist">
				<MenuFlyoutSubItem.Icon>
					<FontIcon Glyph="&#xE728;" />
				</MenuFlyoutSubItem.Icon>
			</MenuFlyoutSubItem>
			<MenuFlyoutItem Click="MenuFlyoutItemAddToQueue_OnClick"
			                Text="Add to queue"
			                ToolTipService.ToolTip="Add this song/track to the queue">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE84F;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutItem Click="MenuFlyoutItemInfoTag_OnClick"
			                Text="Info/Tag">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE946;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutItem Click="MenuFlyoutItemDelete_OnClick"
			                Text="Delete"
			                ToolTipService.ToolTip="Delete this song/track">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE74D;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
		</MenuFlyout>

		<MenuFlyout x:Key="FolderTileRightClickMenu">
			<MenuFlyoutItem Click="FolderTilePlay_OnClick"
			                Text="Play"
			                ToolTipService.ToolTip="Play all tracks in this folder">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE768;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutItem Click="FolderTileAddToQueue_OnClick"
			                Text="Add to queue"
			                ToolTipService.ToolTip="Add all tracks in this folder to the queue">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE84F;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
		</MenuFlyout>

		<MenuFlyout x:Key="SubFolderRightClickMenu">
			<MenuFlyoutItem Click="SubFolderPlay_OnClick"
			                Text="Play"
			                ToolTipService.ToolTip="Play all tracks in this folder">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE768;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutItem Click="SubFolderAddToQueue_OnClick"
			                Text="Add to queue"
			                ToolTipService.ToolTip="Add all tracks in this folder to the queue">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE84F;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
		</MenuFlyout>
	</views:SongListPageBase.Resources>

	<Grid Margin="10,10,10,-10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid Grid.Row="0"
		      Margin="15,10,45,10"
		      ColumnSpacing="15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>

			<StackPanel Grid.Column="0"
			            Orientation="Horizontal"
			            Spacing="10"
			            VerticalAlignment="Center">
				<Button x:Name="UpButton"
				        Click="UpButton_Click"
				        Visibility="Collapsed"
				        ToolTipService.ToolTip="Go up one folder">
					<FontIcon Glyph="&#xE74A;" />
				</Button>
				<TextBlock x:Name="FolderTitleTextBlock"
				           VerticalAlignment="Center"
				           Style="{ThemeResource TitleTextBlockStyle}"
				           Text="Folders" />
			</StackPanel>

			<StackPanel x:Name="PageButtons"
			            Grid.Column="1"
			            HorizontalAlignment="Right"
			            Orientation="Horizontal"
			            Spacing="15">
				<ToggleButton x:Name="MultiSelectButton"
				              Click="MultiSelectButton_Click"
				              ToolTipService.ToolTip="Turn on multi-select mode">
					<FontIcon Glyph="&#xE73A;" />
				</ToggleButton>
				<StackPanel x:Name="PlayAllButtonStackPanel"
				            Orientation="Horizontal"
				            Spacing="5">
					<Button x:Name="ShuffleAndPlay"
					        HorizontalAlignment="Right"
					        Click="ShuffleAndPlayButton_OnClick"
					        ToolTipService.ToolTip="Shuffle And Play All">
						<FontIcon Glyph="&#xE8B1;" />
					</Button>
					<Button x:Name="PlayAll"
					        HorizontalAlignment="Right"
					        Click="PlayAllButton_OnClick"
					        ToolTipService.ToolTip="Play All">
						<FontIcon Glyph="&#xF5B0;" />
					</Button>
				</StackPanel>
				<StackPanel x:Name="SortAndViewButtonPanel"
				            Orientation="Horizontal"
				            Spacing="5">
					<DropDownButton x:Name="SortDropDown"
					                HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="Sort"
							            Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="TitleSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Title" />
								<RadioMenuFlyoutItem x:Name="ArtistsSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Artists" />
								<RadioMenuFlyoutItem x:Name="AlbumSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Album" />
								<RadioMenuFlyoutItem x:Name="DurationSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Duration" />
								<RadioMenuFlyoutItem x:Name="TrackSort"
								                     Click="SortButton_OnClick"
								                     GroupName="SortBy"
								                     Text="Track" />
								<MenuFlyoutSeparator x:Name="SortSeparator" />
								<RadioMenuFlyoutItem x:Name="Ascending"
								                     Click="SortButton_OnClick"
								                     GroupName="Order"
								                     Text="Ascending" />
								<RadioMenuFlyoutItem x:Name="Descending"
								                     Click="SortButton_OnClick"
								                     GroupName="Order"
								                     Text="Descending" />
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
					<DropDownButton x:Name="ViewButton"
					                HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="ViewStyle"
							            Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="AllMusicFoldersViewStyle"
								                     Click="ModeButton_OnClick"
								                     GroupName="FolderMode"
								                     Text="All Music Folders">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE8FD;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
								<RadioMenuFlyoutItem x:Name="FolderHierarchyViewStyle"
								                     Click="ModeButton_OnClick"
								                     GroupName="FolderMode"
								                     Text="Folder Hierarchy">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE838;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
								<MenuFlyoutSeparator x:Name="ViewSeparator" />
								<RadioMenuFlyoutItem x:Name="ListViewStyle"
								                     Click="LayoutButton_OnClick"
								                     GroupName="View"
								                     Text="List View">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE8FD;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
								<RadioMenuFlyoutItem x:Name="CompactViewStyle"
								                     Click="LayoutButton_OnClick"
								                     GroupName="View"
								                     Text="Compact View">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE71D;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
				</StackPanel>
				<Button x:Name="MoreButton"
				        Visibility="Collapsed">
					<FontIcon Glyph="&#xE712;" />
					<Button.Flyout>
						<MenuFlyout x:Name="More"
						            Opened="MenuFlyout_Opened"
						            Placement="BottomEdgeAlignedRight">
							<MenuFlyoutSubItem Text="Add to playlist">
								<MenuFlyoutSubItem.Icon>
									<FontIcon Glyph="&#xE728;" />
								</MenuFlyoutSubItem.Icon>
							</MenuFlyoutSubItem>
							<MenuFlyoutItem Click="MenuFlyoutMultiItemAddToQueue_OnClick"
							                Text="Add to queue"
							                ToolTipService.ToolTip="Add selected songs/tracks to the queue">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE84F;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Click="MenuFlyoutMultiItemDelete_OnClick"
							                Text="Delete"
							                ToolTipService.ToolTip="Delete selected songs/tracks">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE74D;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</StackPanel>
		</Grid>
		<Grid x:Name="ContentGrid"
		      Grid.Row="1">
			<StackPanel x:Name="GoToSettings"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            Visibility="Visible">
				<TextBlock x:Name="GoToSettingsTextBlock"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           HorizontalTextAlignment="Center"
				           Style="{ThemeResource SubtitleTextBlockStyle}"
				           Text="No music folders found. Please check your settings to ensure your libraries are added and songs have been scanned."
				           TextAlignment="Center"
				           TextWrapping="WrapWholeWords" />
				<Button HorizontalAlignment="Center"
				        VerticalAlignment="Center"
				        Click="GotoSettigsButton_Click"
				        Content="Open Settings" />
			</StackPanel>
			<StackPanel x:Name="LoadingProgress"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            Visibility="Collapsed">
				<dev:LoadingIndicator Mode="Arcs" />
				<Grid x:Name="CustomProgressBar"
				      Width="400"
				      Height="50"
				      Background="{ThemeResource AccentAAFillColorDisabled}"
				      BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
				      BorderThickness="2"
				      CornerRadius="5">
					<Rectangle x:Name="ProgressFill"
					           Height="50"
					           HorizontalAlignment="Left"
					           Fill="{ThemeResource AccentAAFillColorDefaultBrush}" />
					<Grid>
						<TextBlock x:Name="ProgressFillText"
						           HorizontalAlignment="Center"
						           VerticalAlignment="Center"
						           Style="{ThemeResource BodyStrongTextBlockStyle}" />
					</Grid>
				</Grid>
			</StackPanel>
			<Grid Width="Auto"
			      Height="Auto"
			      HorizontalAlignment="Center"
			      VerticalAlignment="Center">
				<ContentDialog x:Name="DeleteDialog"
				               Title="Confirm Deletion"
				               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
				               DefaultButton="Secondary"
				               PrimaryButtonText="Delete"
				               SecondaryButtonText="Cancel"
				               Visibility="Collapsed">
					<StackPanel Spacing="10">
						<TextBlock x:Name="DeleteDialogText"
						           Style="{ThemeResource BodyTextBlockStyle}"
						           TextWrapping="WrapWholeWords" />
						<TextBlock Foreground="Red"
						           Style="{ThemeResource BodyStrongTextBlockStyle}"
						           Text="This action cannot be undone."
						           TextWrapping="WrapWholeWords" />
					</StackPanel>
				</ContentDialog>
			</Grid>

			<!-- 1. ROOT LEVEL FOLDER TILES (Visible when at root level) -->
			<ListView x:Name="FolderTileView"
			          Margin="10"
			          Padding="12"
			          ScrollViewer.VerticalScrollBarVisibility="Hidden"
			          VerticalAlignment="Top"
			          HorizontalContentAlignment="Stretch"
			          IsItemClickEnabled="True"
			          IsMultiSelectCheckBoxEnabled="False"
			          IsRightTapEnabled="True"
			          ItemClick="FolderTileView_ItemClick"
			          ItemsSource="{x:Bind RootFolders}"
			          SelectionMode="Single"
			          Visibility="Collapsed">
				<ListView.ItemsPanel>
					<ItemsPanelTemplate>
						<ItemsWrapGrid ItemHeight="270"
						               ItemWidth="220"
						               Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ListView.ItemsPanel>

				<ListView.ItemContainerStyle>
					<Style TargetType="ListViewItem">
						<Setter Property="Margin" Value="10,15,10,15" />
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ListViewItem">
									<Grid x:Name="TileRoot"
									      Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondary}"
									      BorderBrush="{ThemeResource SystemAccentColor}"
									      BorderThickness="2"
									      CornerRadius="25">
										<VisualStateManager.VisualStateGroups>
											<VisualStateGroup x:Name="CommonStates">
												<VisualState x:Name="Normal" />
												<VisualState x:Name="PointerOver">
													<Storyboard>
														<ColorAnimation Storyboard.TargetName="TileRoot"
														                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
														                To="{StaticResource SystemAccentColor}"
														                Duration="0:0:0.2" />
													</Storyboard>
												</VisualState>
												<VisualState x:Name="Pressed">
													<Storyboard>
														<ColorAnimation Storyboard.TargetName="TileRoot"
														                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
														                To="{StaticResource AccentFillColorDisabled}"
														                Duration="0:0:0.1" />
													</Storyboard>
												</VisualState>
												<VisualState x:Name="Selected">
													<Storyboard>
														<ColorAnimation Storyboard.TargetName="TileRoot"
														                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
														                To="{ThemeResource SystemAccentColor}"
														                Duration="0:0:0.2" />
													</Storyboard>
												</VisualState>
											</VisualStateGroup>
										</VisualStateManager.VisualStateGroups>

										<ContentPresenter Width="150"
										                  Height="220"
										                  Margin="10"
										                  HorizontalAlignment="Center"
										                  VerticalAlignment="Center" />
									</Grid>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="common:FolderModel">
						<Grid Background="Transparent"
						      ContextFlyout="{StaticResource FolderTileRightClickMenu}">
							<ToolTipService.ToolTip>
								<TextBlock TextTrimming="CharacterEllipsis"
								           TextWrapping="WrapWholeWords">
									<Run FontWeight="Bold"
									     Text="{x:Bind Name}" />
									<LineBreak />
									<Run Text="{x:Bind Path}" />
									<LineBreak />
									<Run Text="Tracks:" />
									<Run FontWeight="Bold"
									     Text="{x:Bind TotalSongCount}" />
									<LineBreak />
									<Run Text="Duration:" />
									<LineBreak />
									<Run FontWeight="Bold"
									     Text="{x:Bind TotalDuration, Converter={StaticResource DurationToFullTimeConverter}}" />
								</TextBlock>
							</ToolTipService.ToolTip>
							<Grid Width="150"
							      VerticalAlignment="Top">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="50" />
								</Grid.RowDefinitions>
								<Grid Grid.Row="0"
								      Width="150"
								      Height="150"
								      Margin="0,16,0,0"
								      VerticalAlignment="Top"
								      CornerRadius="15">
									<Grid Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
									      CornerRadius="15">
										<FontIcon Glyph="&#xE838;"
										          FontSize="56"
										          Foreground="{ThemeResource SystemAccentColor}"
										          HorizontalAlignment="Center"
										          VerticalAlignment="Center" />
									</Grid>
								</Grid>
								<TextBlock Grid.Row="1"
								           Padding="0,10,0,2"
								           HorizontalAlignment="Left"
								           VerticalAlignment="Top"
								           FontStyle="Normal"
								           FontWeight="Bold"
								           HorizontalTextAlignment="Left"
								           Style="{ThemeResource BodyStrongTextBlockStyle}"
								           Text="{x:Bind Name}"
								           TextAlignment="Left"
								           TextTrimming="CharacterEllipsis"
								           TextWrapping="NoWrap" />
							</Grid>
							<TextBlock Padding="0,0,0,2"
							           HorizontalAlignment="Left"
							           VerticalAlignment="Bottom"
							           FontStyle="Normal"
							           FontWeight="SemiBold"
							           Style="{ThemeResource CaptionTextBlockStyle}"
							           Text="{x:Bind TotalSongCount}" />
							<TextBlock Padding="0,0,0,2"
							           HorizontalAlignment="Right"
							           VerticalAlignment="Bottom"
							           FontStyle="Normal"
							           FontWeight="SemiBold"
							           Style="{ThemeResource CaptionTextBlockStyle}"
							           Text="{x:Bind TotalDuration, Converter={StaticResource DurationConverter}}" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>

			<!-- 2. INSIDE FOLDER VIEW (Folders 1st, Files 2nd) -->
			<Grid x:Name="FolderContentContainer"
			      Visibility="Collapsed">
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto" />
					<RowDefinition Height="*" />
				</Grid.RowDefinitions>

				<!-- Subfolders Section (Shown 1st in Folder Hierarchy mode when subfolders exist) -->
				<Grid x:Name="SubFoldersSection"
				      Grid.Row="0"
				      Margin="10,5,45,15"
				      Visibility="Collapsed">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<TextBlock Grid.Row="0"
					           Margin="5,0,0,8"
					           Text="Folders"
					           Style="{ThemeResource SubtitleTextBlockStyle}" />
					<ListView x:Name="SubFolderListView"
					          Grid.Row="1"
					          IsItemClickEnabled="True"
					          SelectionMode="None"
					          ItemClick="SubFolder_ItemClick"
					          ItemsSource="{x:Bind SubFolders}">
						<ListView.ItemsPanel>
							<ItemsPanelTemplate>
								<ItemsWrapGrid Orientation="Horizontal"
								               ItemWidth="240"
								               ItemHeight="70" />
							</ItemsPanelTemplate>
						</ListView.ItemsPanel>
						<ListView.ItemTemplate>
							<DataTemplate x:DataType="common:FolderModel">
								<Grid Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
								      BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
								      BorderThickness="1"
								      CornerRadius="10"
								      Padding="12,10"
								      Margin="0,0,12,12"
								      ContextFlyout="{StaticResource SubFolderRightClickMenu}">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="Auto" />
										<ColumnDefinition Width="*" />
									</Grid.ColumnDefinitions>
									<FontIcon Grid.Column="0"
									          Glyph="&#xE838;"
									          FontSize="28"
									          Foreground="{ThemeResource SystemAccentColor}"
									          VerticalAlignment="Center"
									          Margin="0,0,12,0" />
									<StackPanel Grid.Column="1"
									            VerticalAlignment="Center">
										<TextBlock Text="{x:Bind Name}"
										           FontWeight="SemiBold"
										           TextTrimming="CharacterEllipsis" />
										<TextBlock Text="{x:Bind TotalSongCount}"
										           Style="{ThemeResource CaptionTextBlockStyle}"
										           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
				</Grid>

				<!-- Song Lists (Files shown 2nd) -->
				<Grid x:Name="FolderDetailListViewGrid"
				      Grid.Row="1">
					<ListView x:Name="FolderDetailListView"
					          Margin="10,10,10,10"
					          Padding="0,0,35,0"
					          VerticalAlignment="Top"
					          IsItemClickEnabled="True"
					          IsMultiSelectCheckBoxEnabled="False"
					          IsRightTapEnabled="True"
					          ItemClick="ListView_ItemClick"
					          ItemsSource="{x:Bind FolderGroupSongs}"
					          ScrollViewer.CanContentRenderOutsideBounds="False"
					          ScrollViewer.VerticalScrollBarVisibility="Hidden"
					          ScrollViewer.VerticalScrollMode="Enabled"
					          SelectionChanged="ListView_SelectionChanged"
					          SelectionMode="Single">

						<ListView.ItemsPanel>
							<ItemsPanelTemplate>
								<ItemsStackPanel Orientation="Vertical" />
							</ItemsPanelTemplate>
						</ListView.ItemsPanel>

						<ListView.Header>
							<Border Height="40"
							        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
							        BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
							        BorderThickness="0,0,0,2"
							        CornerRadius="8">

								<interactivity:Interaction.Behaviors>
									<behaviors:StickyHeaderBehavior />
								</interactivity:Interaction.Behaviors>

								<controls:DataTable x:Name="Header"
								                    Margin="12,0,0,0"
								                    ColumnSpacing="10">
									<controls:DataColumn DesiredWidth="40" />
									<controls:DataColumn Content="Title"
									                     DesiredWidth="350"
									                     FontWeight="Bold"
									                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
									<controls:DataColumn Content="Artists"
									                     DesiredWidth="*"
									                     FontWeight="Bold"
									                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
									<controls:DataColumn DesiredWidth="*">
										<TextBlock FontWeight="Bold"
										           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
										           Text="Album" />
									</controls:DataColumn>
									<controls:DataColumn Content="Duration"
									                     DesiredWidth="120"
									                     FontWeight="Bold"
									                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
								</controls:DataTable>
							</Border>
						</ListView.Header>

						<ListView.ItemTemplate>
							<DataTemplate x:DataType="common:Song">
								<controls:DataRow HorizontalAlignment="Left"
								                  Background="Transparent"
								                  ContextFlyout="{StaticResource RightClickMenu}">
									<Grid Width="40"
									      Height="60"
									      Margin="0,2,0,2"
									      CornerRadius="10">
										<Image VerticalAlignment="Center"
										       Source="{x:Bind Cover, Converter={StaticResource CoverImageConverter}}" />
									</Grid>
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           Text="{x:Bind Title}"
									           TextTrimming="CharacterEllipsis">
										<ToolTipService.ToolTip>
											<TextBlock TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<Run Text="Title: " />
												<Run FontWeight="Bold"
												     Text="{x:Bind Title}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           Text="{x:Bind Artists}"
									           TextTrimming="CharacterEllipsis">
										<ToolTipService.ToolTip>
											<TextBlock TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<Run Text="Artists: " />
												<Run FontWeight="Bold"
												     Text="{x:Bind Artists}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           Text="{x:Bind Album}"
									           TextTrimming="CharacterEllipsis">
										<ToolTipService.ToolTip>
											<TextBlock TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<Run Text="Album: " />
												<Run FontWeight="Bold"
												     Text="{x:Bind Album}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           Text="{x:Bind Duration, Converter={StaticResource DurationConverter}}"
									           TextTrimming="CharacterEllipsis" />
								</controls:DataRow>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>

					<ListView x:Name="FolderDetailCompactView"
					          Margin="10,10,10,10"
					          Padding="0,0,35,0"
					          VerticalAlignment="Top"
					          IsItemClickEnabled="True"
					          IsMultiSelectCheckBoxEnabled="False"
					          IsRightTapEnabled="True"
					          ItemClick="ListView_ItemClick"
					          ItemsSource="{x:Bind FolderGroupSongs}"
					          ScrollViewer.CanContentRenderOutsideBounds="False"
					          ScrollViewer.VerticalScrollBarVisibility="Hidden"
					          ScrollViewer.VerticalScrollMode="Enabled"
					          SelectionChanged="ListView_SelectionChanged"
					          SelectionMode="Single"
					          Visibility="Collapsed">

						<ListView.ItemsPanel>
							<ItemsPanelTemplate>
								<ItemsStackPanel Orientation="Vertical" />
							</ItemsPanelTemplate>
						</ListView.ItemsPanel>

						<ListView.ItemTemplate>
							<DataTemplate x:DataType="common:Song">
								<Grid Margin="10,0,10,0"
								      HorizontalAlignment="Stretch"
								      Background="Transparent"
								      ContextFlyout="{StaticResource RightClickMenu}">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<Grid Grid.Column="0"
									      HorizontalAlignment="Left"
									      VerticalAlignment="Center">
										<Grid>
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="100" />
												<ColumnDefinition Width="20" />
												<ColumnDefinition Width="*" />
											</Grid.ColumnDefinitions>
											<Grid Grid.Column="0"
											      Width="100"
											      Height="100"
											      Margin="0,10,0,10">
												<Grid Width="Auto"
												      Height="Auto"
												      HorizontalAlignment="Center"
												      VerticalAlignment="Center"
												      CornerRadius="10">
													<Image HorizontalAlignment="Center"
													       VerticalAlignment="Center"
													       Source="{x:Bind Cover, Converter={StaticResource CoverImageConverter}}" />
												</Grid>
											</Grid>
											<StackPanel Grid.Column="2"
											            HorizontalAlignment="Center"
											            VerticalAlignment="Center"
											            Orientation="Vertical"
											            Spacing="5">
												<TextBlock HorizontalAlignment="Left"
												           VerticalAlignment="Center"
												           MaxLines="2"
												           Style="{ThemeResource SubtitleTextBlockStyle}"
												           Text="{x:Bind Title}"
												           TextTrimming="CharacterEllipsis"
												           TextWrapping="WrapWholeWords">
													<ToolTipService.ToolTip>
														<TextBlock TextTrimming="CharacterEllipsis"
														           TextWrapping="WrapWholeWords">
															<Run Text="Title: " />
															<Run FontWeight="Bold"
															     Text="{x:Bind Title}" />
														</TextBlock>
													</ToolTipService.ToolTip>
												</TextBlock>
												<TextBlock HorizontalAlignment="Left"
												           VerticalAlignment="Center"
												           MaxLines="2"
												           Style="{ThemeResource BodyStrongTextBlockStyle}"
												           Text="{x:Bind Artists}"
												           TextTrimming="CharacterEllipsis"
												           TextWrapping="WrapWholeWords">
													<ToolTipService.ToolTip>
														<TextBlock TextTrimming="CharacterEllipsis"
														           TextWrapping="WrapWholeWords">
															<Run Text="Artists: " />
															<Run FontWeight="Bold"
															     Text="{x:Bind Artists}" />
														</TextBlock>
													</ToolTipService.ToolTip>
												</TextBlock>
												<TextBlock HorizontalAlignment="Left"
												           VerticalAlignment="Center"
												           MaxLines="2"
												           Style="{ThemeResource BodyStrongTextBlockStyle}"
												           Text="{x:Bind Album}"
												           TextTrimming="CharacterEllipsis"
												           TextWrapping="WrapWholeWords">
													<ToolTipService.ToolTip>
														<TextBlock TextTrimming="CharacterEllipsis"
														           TextWrapping="WrapWholeWords">
															<Run Text="Album: " />
															<Run FontWeight="Bold"
															     Text="{x:Bind Album}" />
														</TextBlock>
													</ToolTipService.ToolTip>
												</TextBlock>
											</StackPanel>
										</Grid>
									</Grid>
									<Grid Grid.Column="1"
									      HorizontalAlignment="Right"
									      VerticalAlignment="Center">
										<TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
										           Text="{x:Bind Duration, Converter={StaticResource DurationConverter}}"
										           TextTrimming="CharacterEllipsis" />
									</Grid>
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>

					<scrubber:AlphabetScrubber x:Name="AlphabetScrubber" />
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</views:SongListPageBase>
