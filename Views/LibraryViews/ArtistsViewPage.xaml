<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Tunetastic.Views.LibraryViews.ArtistsViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
      xmlns:common="using:Tunetastic.Common"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:libraryviews="using:Tunetastic.Views.LibraryViews"
      xmlns:local="using:Tunetastic.Generated.Protos"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      ActualThemeChanged="Page_ActualThemeChanged"
      Loaded="Page_Loaded"
      SizeChanged="Page_SizeChanged"
      Unloaded="Page_Unloaded"
      mc:Ignorable="d">

	<Page.Resources>
		<MenuFlyout x:Key="RightClickMenu"
		            Opened="MenuFlyout_Opened">
			<MenuFlyoutItem Click="MenuFlyoutItemPlay_OnClick"
			                Text="Play"
			                ToolTipService.ToolTip="Play this group of songs/tracks">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE768;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutSubItem x:Name="AddToPlaylist"
			                   Text="Add to playlist">
				<MenuFlyoutSubItem.Icon>
					<FontIcon Glyph="&#xE728;" />
				</MenuFlyoutSubItem.Icon>
			</MenuFlyoutSubItem>
			<MenuFlyoutItem Click="MenuFlyoutItemAddToQueue_OnClick"
			                Text="Add to queue"
			                ToolTipService.ToolTip="Add this group of songs/tracks to the queue">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE84F;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>

			<MenuFlyoutSeparator />

			<MenuFlyoutItem Click="MenuFlyoutItemDelete_OnClick"
			                Text="Delete"
			                ToolTipService.ToolTip="Delete this group of songs/tracks">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE74D;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
		</MenuFlyout>
	</Page.Resources>

	<Grid Margin="10,10,10,0">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid Grid.Row="0"
		      Margin="15,10,45,10">
			<TextBlock HorizontalAlignment="Left"
			           Style="{ThemeResource TitleTextBlockStyle}"
			           Text="Artists"
			           ToolTipService.ToolTip="All songs/tracks will be grouped by artists and displayed here" />

			<StackPanel x:Name="PageButtons"
			            HorizontalAlignment="Right"
			            Orientation="Horizontal"
			            Spacing="15">
				<ToggleButton x:Name="MultiSelectButton"
				              Click="MultiSelectButton_Click"
				              ToolTipService.ToolTip="Turn on multi-select mode">
					<FontIcon Glyph="&#xE73A;" />
				</ToggleButton>
				<StackPanel x:Name="SortAndViewButtonPanel"
				            Orientation="Horizontal"
				            Spacing="5">
					<DropDownButton x:Name="SortDropDown"
					                HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="Sort"
							            Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="Ascending"
								                     Click="SortButton_OnClick"
								                     GroupName="Order"
								                     Text="Ascending" />
								<RadioMenuFlyoutItem x:Name="Descending"
								                     Click="SortButton_OnClick"
								                     GroupName="Order"
								                     Text="Descending" />
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
					<!--<DropDownButton x:Name="ViewButton"
									HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="ViewStyle"
										Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="ListViewStyle"
													 Click="ViewButton_OnClick"
													 GroupName="View"
													 Text="List View">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE8FD;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
								<RadioMenuFlyoutItem x:Name="CompactViewStyle"
													 Click="ViewButton_OnClick"
													 GroupName="View"
													 Text="Compact View">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE71D;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>-->
				</StackPanel>
				<Button x:Name="MoreButton"
				        Visibility="Collapsed">
					<FontIcon Glyph="&#xE712;" />
					<Button.Flyout>
						<MenuFlyout x:Name="More"
						            Opened="MenuFlyout_Opened"
						            Placement="BottomEdgeAlignedRight">
							<MenuFlyoutSubItem Text="Add to playlist">
								<MenuFlyoutSubItem.Icon>
									<FontIcon Glyph="&#xE728;" />
								</MenuFlyoutSubItem.Icon>
							</MenuFlyoutSubItem>
							<MenuFlyoutItem Click="MenuFlyoutMultiItemAddToQueue_OnClick"
							                Text="Add to queue"
							                ToolTipService.ToolTip="Add selected groups of songs/tracks to the queue">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE84F;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Click="MenuFlyoutMultiItemDelete_OnClick"
							                Text="Delete"
							                ToolTipService.ToolTip="Delete selected groups of songs/tracks">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE74D;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</StackPanel>
		</Grid>
		<Grid x:Name="ContentGrid"
		      Grid.Row="1">
			<StackPanel x:Name="GoToSettings"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            ToolTipService.ToolTip="No songs or tracks found. Please, check your settings to ensure your libraries are added and songs/tracks have been scanned."
			            Visibility="Visible">
				<TextBlock x:Name="GoToSettingsTextBlock"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           HorizontalTextAlignment="Center"
				           Style="{ThemeResource SubtitleTextBlockStyle}"
				           TextAlignment="Center"
				           TextWrapping="WrapWholeWords" />
				<Button HorizontalAlignment="Center"
				        VerticalAlignment="Center"
				        Click="GotoSettigsButton_Click"
				        Content="Open Settings" />
			</StackPanel>
			<StackPanel x:Name="LoadingProgress"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            Visibility="Collapsed">
				<dev:LoadingIndicator Mode="Arcs" />
				<Grid x:Name="CustomProgressBar"
				      Width="400"
				      Height="50"
				      Background="{ThemeResource AccentAAFillColorDisabled}"
				      BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
				      BorderThickness="2"
				      CornerRadius="5">
					<Rectangle x:Name="ProgressFill"
					           Height="50"
					           HorizontalAlignment="Left"
					           Fill="{ThemeResource AccentAAFillColorDefaultBrush}" />
					<Grid>
						<TextBlock x:Name="ProgressFillText"
						           HorizontalAlignment="Center"
						           VerticalAlignment="Center"
						           Style="{ThemeResource BodyStrongTextBlockStyle}" />
					</Grid>
				</Grid>
			</StackPanel>
			<Grid Width="Auto"
			      Height="Auto"
			      HorizontalAlignment="Center"
			      VerticalAlignment="Center">
				<ContentDialog x:Name="DeleteDialog"
				               Title="Confirm Deletion"
				               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
				               DefaultButton="Secondary"
				               PrimaryButtonText="Delete"
				               SecondaryButtonText="Cancel"
				               Visibility="Collapsed">
					<StackPanel Spacing="10">
						<TextBlock x:Name="DeleteDialogText"
						           Style="{ThemeResource BodyTextBlockStyle}"
						           TextWrapping="WrapWholeWords" />
						<TextBlock Foreground="Red"
						           Style="{ThemeResource BodyStrongTextBlockStyle}"
						           Text="This action cannot be undone."
						           TextWrapping="WrapWholeWords" />
					</StackPanel>
				</ContentDialog>
			</Grid>
			<ListView x:Name="ArtistTileView"
			          Margin="10"
			          Padding="12"
			          VerticalAlignment="Top"
			          HorizontalContentAlignment="Stretch"
			          IsItemClickEnabled="True"
			          IsMultiSelectCheckBoxEnabled="False"
			          IsRightTapEnabled="True"
			          ItemClick="ArtistTileView_ItemClick"
			          ItemsSource="{x:Bind ArtistsGroup}"
			          SelectionChanged="ListView_SelectionChanged"
			          SelectionMode="Single">
				<ListView.ItemsPanel>
					<ItemsPanelTemplate>
						<ItemsWrapGrid ItemHeight="170"
						               ItemWidth="220"
						               Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ListView.ItemsPanel>

				<ListView.ItemContainerTransitions>
					<TransitionCollection>
						<RepositionThemeTransition />
					</TransitionCollection>
				</ListView.ItemContainerTransitions>

				<ListView.ItemContainerStyle>
					<Style TargetType="ListViewItem">
						<Setter Property="Margin" Value="10,15,10,15" />
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ListViewItem">
									<Grid x:Name="TileRoot"
									      Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondary}"
									      BorderBrush="{ThemeResource SystemAccentColor}"
									      BorderThickness="2"
									      CornerRadius="25">
										<VisualStateManager.VisualStateGroups>
											<VisualStateGroup x:Name="CommonStates">
												<VisualState x:Name="Normal" />
												<VisualState x:Name="PointerOver">
													<Storyboard>
														<ColorAnimation Storyboard.TargetName="TileRoot"
														                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
														                To="{StaticResource SystemAccentColor}"
														                Duration="0:0:0.2" />
													</Storyboard>
												</VisualState>
												<VisualState x:Name="Pressed">
													<Storyboard>
														<ColorAnimation Storyboard.TargetName="TileRoot"
														                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
														                To="{StaticResource AccentFillColorDisabled}"
														                Duration="0:0:0.1" />
													</Storyboard>
												</VisualState>
												<VisualState x:Name="Selected">
													<Storyboard>
														<ColorAnimation Storyboard.TargetName="TileRoot"
														                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
														                To="{ThemeResource SystemAccentColor}"
														                Duration="0:0:0.2" />
													</Storyboard>
												</VisualState>
											</VisualStateGroup>
										</VisualStateManager.VisualStateGroups>

										<ContentPresenter Width="150"
										                  Height="110"
										                  Margin="0"
										                  HorizontalAlignment="Center"
										                  VerticalAlignment="Center" />
									</Grid>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="common:ArtistModel">
						<Grid Background="Transparent"
						      ContextFlyout="{StaticResource RightClickMenu}">
							<ToolTipService.ToolTip>
								<TextBlock TextTrimming="CharacterEllipsis"
								           TextWrapping="WrapWholeWords">
									<Run FontWeight="Bold"
									     Text="{x:Bind Artist}" />
									<LineBreak />
									<Run Text="Count of songs/tracks in the group:" />
									<Run FontWeight="Bold"
									     Text="{x:Bind Count}" />
									<LineBreak />
									<Run Text="Total Duration of songs/tracks in the group:" />
									<LineBreak />
									<Run FontWeight="Bold"
									     Text="{x:Bind TotalDuration, Converter={StaticResource DurationToFullTimeConverter}}" />
								</TextBlock>
							</ToolTipService.ToolTip>
							<TextBlock x:Name="ArtistTextBlock"
							           HorizontalAlignment="Center"
							           VerticalAlignment="Center"
							           FontStyle="Normal"
							           FontWeight="Bold"
							           Style="{ThemeResource TitleTextBlockStyle}"
							           Text="{x:Bind Artist}"
							           TextAlignment="Center"
							           TextTrimming="CharacterEllipsis"
							           TextWrapping="WrapWholeWords" />
							<TextBlock HorizontalAlignment="Left"
							           VerticalAlignment="Bottom"
							           FontStyle="Normal"
							           FontWeight="SemiBold"
							           Style="{ThemeResource CaptionTextBlockStyle}"
							           Text="{x:Bind Count}" />
							<TextBlock HorizontalAlignment="Right"
							           VerticalAlignment="Bottom"
							           FontStyle="Normal"
							           FontWeight="SemiBold"
							           Style="{ThemeResource CaptionTextBlockStyle}"
							           Text="{x:Bind TotalDuration, Converter={StaticResource DurationConverter}}" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
			<StackPanel x:Name="AlphabetNavigationPanel"
			            Margin="0,50,30,10"
			            HorizontalAlignment="Right"
			            VerticalAlignment="Stretch"
			            Orientation="Vertical"
			            Spacing="0">
			</StackPanel>
		</Grid>
	</Grid>
</Page>
