<?xml version="1.0" encoding="utf-8" ?>
<views:TileListPageBase x:Class="Tunetastic.Views.LibraryViews.AlbumsViewPage"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
                        xmlns:common="using:Tunetastic.Common"
                        xmlns:controls="using:CommunityToolkit.WinUI.Controls"
                        xmlns:customControls="using:Tunetastic.Common.Controls"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:dev="using:DevWinUI"
                        xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
                        xmlns:labs="using:CommunityToolkit.Labs.WinUI"
                        xmlns:libraryviews="using:Tunetastic.Views.LibraryViews"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:services="using:Tunetastic.Common.Services"
                         xmlns:views="using:Tunetastic.Views.Common"
                        Loaded="Page_Loaded"
                        SizeChanged="Page_SizeChanged"
                        mc:Ignorable="d">

	<views:TileListPageBase.Resources>
		<MenuFlyout x:Key="RightClickMenu"
		            Opened="MenuFlyout_Opened">
			<MenuFlyoutItem x:Uid="Action_PlayGroup" Click="MenuFlyoutItemPlay_OnClick"
			                Text="{services:Loc Key=Action_PlayGroup.Text}"
			                ToolTipService.ToolTip="{services:Loc Key=Action_PlayGroup_ToolTip}">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE768;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutSubItem x:Name="AddToPlaylist" x:Uid="Action_AddToPlaylist"
			                   Text="{services:Loc Key=Action_AddToPlaylist.Text}">
				<MenuFlyoutSubItem.Icon>
					<FontIcon Glyph="&#xE728;" />
				</MenuFlyoutSubItem.Icon>
			</MenuFlyoutSubItem>
			<MenuFlyoutItem x:Uid="Action_AddToQueueGroup" Click="MenuFlyoutItemAddToQueue_OnClick"
			                Text="{services:Loc Key=Action_AddToQueueGroup.Text}"
			                ToolTipService.ToolTip="{services:Loc Key=Action_AddToQueueGroup_ToolTip}">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE84F;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>

			<MenuFlyoutSeparator />

			<MenuFlyoutItem x:Uid="Action_DeleteGroup" Click="MenuFlyoutItemDelete_OnClick"
			                Text="{services:Loc Key=Action_DeleteGroup.Text}"
			                ToolTipService.ToolTip="{services:Loc Key=Action_DeleteGroup_ToolTip}">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE74D;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
		</MenuFlyout>
	</views:TileListPageBase.Resources>

	<Grid Margin="10,10,10,-10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid Grid.Row="0"
		      Margin="15,10,45,10">
			<TextBlock x:Uid="AlbumsView_Title"
			           HorizontalAlignment="Left"
			           Style="{ThemeResource TitleTextBlockStyle}"
			           Text="{services:Loc Key=AlbumsView_Title.Text}"
			           ToolTipService.ToolTip="{services:Loc Key=AlbumsView_Title_ToolTip}" />

			<StackPanel x:Name="PageButtons"
			            HorizontalAlignment="Right"
			            Orientation="Horizontal"
			            Spacing="15">
				<ToggleButton x:Name="MultiSelectButton" x:Uid="ActionBar_MultiSelect"
				              Click="MultiSelectButton_Click"
				              ToolTipService.ToolTip="{services:Loc Key=ActionBar_MultiSelect_ToolTip}">
					<FontIcon Glyph="&#xE73A;" />
				</ToggleButton>
				<StackPanel x:Name="SortAndViewButtonPanel"
				            Orientation="Horizontal"
				            Spacing="5">
					<DropDownButton x:Name="SortDropDown"
					                HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="Sort"
							            Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="Ascending"
								                     Click="SortButton_OnClick"
								                     GroupName="Order"
								                     Tag="Ascending" x:Uid="Sort_Ascending" Text="{services:Loc Key=Sort_Ascending.Text}" />
								<RadioMenuFlyoutItem x:Name="Descending"
								                     Click="SortButton_OnClick"
								                     GroupName="Order"
								                     Tag="Descending" x:Uid="Sort_Descending" Text="{services:Loc Key=Sort_Descending.Text}" />
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
				</StackPanel>
				<Button x:Name="MoreButton"
				        Visibility="Collapsed">
					<FontIcon Glyph="&#xE712;" />
					<Button.Flyout>
						<MenuFlyout x:Name="More"
						            Opened="MenuFlyout_Opened"
						            Placement="BottomEdgeAlignedRight">
							<MenuFlyoutSubItem x:Uid="ActionBar_Multi_AddToPlaylist" Text="{services:Loc Key=ActionBar_Multi_AddToPlaylist.Text}">
								<MenuFlyoutSubItem.Icon>
									<FontIcon Glyph="&#xE728;" />
								</MenuFlyoutSubItem.Icon>
							</MenuFlyoutSubItem>
							<MenuFlyoutItem x:Uid="ActionBar_Multi_AddToQueueGroup" Click="MenuFlyoutMultiItemAddToQueue_OnClick"
							                Text="{services:Loc Key=ActionBar_Multi_AddToQueueGroup.Text}"
							                ToolTipService.ToolTip="{services:Loc Key=ActionBar_Multi_AddToQueueGroup_ToolTip}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE84F;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem x:Uid="ActionBar_Multi_DeleteGroup" Click="MenuFlyoutMultiItemDelete_OnClick"
							                Text="{services:Loc Key=ActionBar_Multi_DeleteGroup.Text}"
							                ToolTipService.ToolTip="{services:Loc Key=ActionBar_Multi_DeleteGroup_ToolTip}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE74D;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</StackPanel>
		</Grid>
		<Grid x:Name="ContentGrid"
		      Grid.Row="1">
			<StackPanel x:Name="GoToSettings"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            ToolTipService.ToolTip="{services:Loc Key=EmptyState_NoSongs.Text}"
			            Visibility="Visible">
				<TextBlock x:Name="GoToSettingsTextBlock"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           HorizontalTextAlignment="Center"
				           Style="{ThemeResource SubtitleTextBlockStyle}"
				           TextAlignment="Center"
				           TextWrapping="WrapWholeWords" />
				<Button x:Uid="EmptyState_OpenSettings" HorizontalAlignment="Center" VerticalAlignment="Center" Click="GotoSettigsButton_Click" Content="{services:Loc Key=EmptyState_OpenSettings.Content}" />
			</StackPanel>
			<StackPanel x:Name="LoadingProgress"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            Visibility="Collapsed">
				<dev:LoadingIndicator Mode="Arcs" />
				<Grid x:Name="CustomProgressBar"
				      Width="400"
				      Height="50"
				      Background="{ThemeResource AccentAAFillColorDisabled}"
				      BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
				      BorderThickness="2"
				      CornerRadius="5">
					<Rectangle x:Name="ProgressFill"
					           Height="50"
					           HorizontalAlignment="Left"
					           Fill="{ThemeResource AccentAAFillColorDefaultBrush}" />
					<Grid>
						<TextBlock x:Name="ProgressFillText"
						           HorizontalAlignment="Center"
						           VerticalAlignment="Center"
						           Style="{ThemeResource BodyStrongTextBlockStyle}" />
					</Grid>
				</Grid>
			</StackPanel>
			<Grid Width="Auto"
			      Height="Auto"
			      HorizontalAlignment="Center"
			      VerticalAlignment="Center">
				<ContentDialog x:Name="DeleteDialog" x:Uid="DeleteDialog_ConfirmDialog"
				               Title="Confirm Deletion"
				               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
				               DefaultButton="Secondary"
				               PrimaryButtonText="Delete"
				               SecondaryButtonText="Cancel"
				               Visibility="Collapsed">
					<StackPanel Spacing="10">
						<TextBlock x:Name="DeleteDialogText"
						           Style="{ThemeResource BodyTextBlockStyle}"
						           TextWrapping="WrapWholeWords" />
						<TextBlock x:Uid="DeleteDialog_UndoneWarning" Foreground="Red" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="This action cannot be undone."
						           TextWrapping="WrapWholeWords" />
					</StackPanel>
				</ContentDialog>
			</Grid>

			<!--  Shimmer Not required anymore. But kept it in case for a potato PC  -->
			<Grid Margin="20,10,0,0"
			      Padding="12">
				<ItemsRepeater x:Name="ShimmerRepeater"
				               VerticalAlignment="Top"
				               Visibility="Collapsed">
					<ItemsRepeater.Layout>
						<customControls:SmartWrapVirtualizingLayout MinGap="30"
						                                            RowGap="40"
						                                            TileHeight="230"
						                                            TileWidth="190" />
					</ItemsRepeater.Layout>
					<ItemsRepeater.ItemTemplate>
						<DataTemplate x:DataType="x:Int32">
							<Grid Width="190"
							      Height="230"
							      CornerRadius="25">
								<labs:Shimmer IsEnabled="True" />
							</Grid>
						</DataTemplate>
					</ItemsRepeater.ItemTemplate>
				</ItemsRepeater>
			</Grid>

			<ListView x:Name="AlbumTileView"
			          Margin="10"
			          Padding="12"
			          ScrollViewer.VerticalScrollBarVisibility="Hidden"
			          VerticalAlignment="Top"
			          HorizontalContentAlignment="Stretch"
			          IsItemClickEnabled="True"
			          IsMultiSelectCheckBoxEnabled="False"
			          IsRightTapEnabled="True"
			          ItemClick="AlbumTileView_ItemClick"
			          ItemsSource="{x:Bind AlbumsGroup}"
			          SelectionChanged="ListView_SelectionChanged"
			          SelectionMode="Single">
				<ListView.ItemsPanel>
					<ItemsPanelTemplate>
						<ItemsWrapGrid ItemHeight="270"
						               ItemWidth="220"
						               Orientation="Horizontal" />
					</ItemsPanelTemplate>
				</ListView.ItemsPanel>

				<ListView.ItemContainerTransitions>
					<TransitionCollection>
						<RepositionThemeTransition />
					</TransitionCollection>
				</ListView.ItemContainerTransitions>

				<ListView.ItemContainerStyle>
					<Style TargetType="ListViewItem">
						<Setter Property="Margin" Value="10,15,10,15" />
						<Setter Property="Template">
							<Setter.Value>
								<ControlTemplate TargetType="ListViewItem">
									<Grid x:Name="TileRoot"
									      Background="{ThemeResource LayerOnMicaBaseAltFillColorSecondary}"
									      BorderBrush="{ThemeResource SystemAccentColor}"
									      BorderThickness="2"
									      CornerRadius="25">
										<VisualStateManager.VisualStateGroups>
											<VisualStateGroup x:Name="CommonStates">
												<VisualState x:Name="Normal" />
												<VisualState x:Name="PointerOver">
													<Storyboard>
														<ColorAnimation Storyboard.TargetName="TileRoot"
														                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
														                To="{StaticResource SystemAccentColor}"
														                Duration="0:0:0.2" />
													</Storyboard>
												</VisualState>
												<VisualState x:Name="Pressed">
													<Storyboard>
														<ColorAnimation Storyboard.TargetName="TileRoot"
														                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
														                To="{StaticResource AccentFillColorDisabled}"
														                Duration="0:0:0.1" />
													</Storyboard>
												</VisualState>
												<VisualState x:Name="Selected">
													<Storyboard>
														<ColorAnimation Storyboard.TargetName="TileRoot"
														                Storyboard.TargetProperty="(Grid.Background).(SolidColorBrush.Color)"
														                To="{ThemeResource SystemAccentColor}"
														                Duration="0:0:0.2" />
													</Storyboard>
												</VisualState>
											</VisualStateGroup>
										</VisualStateManager.VisualStateGroups>

										<ContentPresenter Width="150"
										                  Height="220"
										                  Margin="10"
										                  HorizontalAlignment="Center"
										                  VerticalAlignment="Center" />
									</Grid>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</ListView.ItemContainerStyle>
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="common:AlbumModel">
						<Grid Background="Transparent"
						      ContextFlyout="{StaticResource RightClickMenu}">
							<ToolTipService.ToolTip>
								<TextBlock TextTrimming="CharacterEllipsis"
								           TextWrapping="WrapWholeWords">
									<Run FontWeight="Bold"
									     Text="{x:Bind Album}" />
									<LineBreak />
									<Run Text="{services:Loc Key=Tooltip_CountOfSongs}" />
									<Run FontWeight="Bold"
									     Text="{x:Bind Count}" />
									<LineBreak />
									<Run Text="{services:Loc Key=Tooltip_TotalDuration}" />
									<LineBreak />
									<Run FontWeight="Bold"
									     Text="{x:Bind TotalDuration, Converter={StaticResource DurationToFullTimeConverter}}" />
								</TextBlock>
							</ToolTipService.ToolTip>
							<Grid Width="150"
							      VerticalAlignment="Top">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="50" />
								</Grid.RowDefinitions>
								<Grid Grid.Row="0"
								      Width="150"
								      Height="150"
								      Margin="0,16,0,0"
								      VerticalAlignment="Top">
									<Grid Width="150"
									      Height="Auto"
									      HorizontalAlignment="Center"
									      VerticalAlignment="Center"
									      CornerRadius="15">
										<Image x:Name="AlbumCover"
										       Width="150"
										       HorizontalAlignment="Center"
										       VerticalAlignment="Center" Source="{x:Bind Cover, Converter={StaticResource CoverImageConverter}}" />
									</Grid>
								</Grid>
								<TextBlock x:Name="AlbumTextBlock"
								           Grid.Row="1"
								           Padding="0,10,0,2"
								           HorizontalAlignment="Left"
								           VerticalAlignment="Top"
								           FontStyle="Normal"
								           FontWeight="Bold"
								           HorizontalTextAlignment="Left"
								           Style="{ThemeResource BodyStrongTextBlockStyle}"
								           Text="{x:Bind Album}"
								           TextAlignment="Left"
								           TextTrimming="CharacterEllipsis"
								           TextWrapping="NoWrap" />
							</Grid>
							<TextBlock Padding="0,0,0,2"
							           HorizontalAlignment="Left"
							           VerticalAlignment="Bottom"
							           FontStyle="Normal"
							           FontWeight="SemiBold"
							           Style="{ThemeResource CaptionTextBlockStyle}"
							           Text="{x:Bind Count}" />
							<TextBlock Padding="0,0,0,2"
							           HorizontalAlignment="Right"
							           VerticalAlignment="Bottom"
							           FontStyle="Normal"
							           FontWeight="SemiBold"
							           Style="{ThemeResource CaptionTextBlockStyle}"
							           Text="{x:Bind TotalDuration, Converter={StaticResource DurationConverter}}" />
						</Grid>
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
			<customControls:AlphabetScrubber x:Name="AlphabetScrubber" />
		</Grid>
	</Grid>
</views:TileListPageBase>
