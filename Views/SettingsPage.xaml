<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Tunetastic.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:Tunetastic.Common"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      ActualThemeChanged="Page_ActualThemeChanged"
      mc:Ignorable="d">
	<ScrollView Margin="{ThemeResource ContentPageMargin}"
	            Padding="{ThemeResource ContentPagePadding}"
	            HorizontalAlignment="Stretch"
	            VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="20"
		            Spacing="15">


			<!--  Library  -->
			<StackPanel Orientation="Horizontal"
			            Spacing="10">
				<FontIcon FontSize="{Binding ElementName=LibraryTextBlock, Path=FontSize}"
				          Glyph="&#xE8F7;" />
				<TextBlock x:Name="LibraryTextBlock"
				           Style="{ThemeResource TitleTextBlockStyle}"
				           Text="Library &amp; PlayLists" />
			</StackPanel>

			<dev:SettingsExpander Description="Click to view libraries added"
			                      Header="All Libraries"
			                      ItemsSource="{x:Bind Libraries}">
				<Button Click="AddNewFolder_ButtonClick"
				        Content="Add New Folder" />

				<dev:SettingsExpander.ItemTemplate>
					<DataTemplate x:DataType="common:LibraryModel">
						<dev:SettingsCard Description="{x:Bind Path}"
						                  Header="{x:Bind Name}">
							<Button Click="RemoveFolder_ButtonClick"
							        CommandParameter="{x:Bind}"
							        Content="Remove Folder" />
						</dev:SettingsCard>
					</DataTemplate>
				</dev:SettingsExpander.ItemTemplate>
			</dev:SettingsExpander>

			<dev:SettingsExpander x:Name="FileExt"
			                      Header="File Extensions"
			                      ItemsSource="{x:Bind AllFormats, Mode=TwoWay}">
				<dev:SettingsExpander.ItemTemplate>
					<DataTemplate x:DataType="common:MusicFormatModel">
						<dev:SettingsCard Description="{x:Bind Description}"
						                  Header="{x:Bind Extension}">
							<ToggleSwitch Name="{x:Bind Extension}"
							              IsOn="{x:Bind Enabled, Mode=TwoWay}"
							              Toggled="Ext_ToggleSwitch_OnToggled" />
						</dev:SettingsCard>
					</DataTemplate>
				</dev:SettingsExpander.ItemTemplate>
			</dev:SettingsExpander>

			<dev:SettingsExpander x:Name="Scan"
			                      Header="Scan Libraries for Songs">

				<StackPanel Orientation="Horizontal"
				            Spacing="15">
					<Grid x:Name="CustomProgressBar"
					      Width="200"
					      Height="30"
					      Background="{ThemeResource AccentAAFillColorDisabled}"
					      BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
					      BorderThickness="2"
					      CornerRadius="5"
					      Visibility="Collapsed">
						<Rectangle x:Name="ProgressFill"
						           Height="40"
						           HorizontalAlignment="Left"
						           Fill="{ThemeResource AccentAAFillColorDefaultBrush}" />
						<Grid>
							<TextBlock x:Name="ProgressFillText"
							           HorizontalAlignment="Center"
							           VerticalAlignment="Center"
							           Style="{ThemeResource BodyStrongTextBlockStyle}" />
						</Grid>
					</Grid>
					<Button Click="ScanButton_Click"
					        Content="Scan" />
				</StackPanel>
				<dev:SettingsExpander.Items>
					<dev:SettingsCard x:Name="IgnoreTrack"
					                  Header="Ignore Short Tracks">
						<NumberBox x:Name="IgnoretracksDuration"
						           Header="Duration"
						           SmallChange="1"
						           SpinButtonPlacementMode="Inline" />
					</dev:SettingsCard>
					<dev:SettingsCard Description="If turned on, the app will ignore tracks that are already scanned once based on Title, Album, and Artist."
					                  Header="Ignore Duplicate Tracks">
						<ToggleSwitch Name="IgnoreDup"
						              IsOn="False"
						              Toggled="IgnoreDup_Toggled" />
					</dev:SettingsCard>

					<dev:SettingsCard Description="Scans the library for tracks when the app starts. If turned on, it will increase the startup time."
					                  Header="Scan At Startup">
						<ToggleSwitch Name="ScanAtStart"
						              IsOn="False"
						              Toggled="ScanAtStart_Toggled" />
					</dev:SettingsCard>
				</dev:SettingsExpander.Items>
			</dev:SettingsExpander>

			<dev:SettingsExpander x:Name="LibaryPlayListVisiblity"
			                      Description="Select which Pre-defined Libraries and Playlists to show/hide on Navigation"
			                      Header="Libraries and Playlists to show">
				<dev:SettingsExpander.Items>
					<dev:SettingsCard Header="Artists">
						<ToggleSwitch x:Name="ArtistsToggle" />
					</dev:SettingsCard>
					<dev:SettingsCard Header="Albums">
						<ToggleSwitch x:Name="AlbumsToggle" />
					</dev:SettingsCard>
					<dev:SettingsCard Header="Genres">
						<ToggleSwitch x:Name="GenresToggle" />
					</dev:SettingsCard>
					<dev:SettingsCard Header="Years">
						<ToggleSwitch x:Name="YearsToggle" />
					</dev:SettingsCard>
					<dev:SettingsCard Header="Recently Added">
						<ToggleSwitch x:Name="RecentlyAddedToggle" />
					</dev:SettingsCard>
					<dev:SettingsCard Header="Recently Played">
						<ToggleSwitch x:Name="RecentlyPlayedToggle" />
					</dev:SettingsCard>
					<dev:SettingsCard Header="Most Played">
						<ToggleSwitch x:Name="MostPlayedToggle" />
					</dev:SettingsCard>
				</dev:SettingsExpander.Items>
			</dev:SettingsExpander>

			<!--  Audio & Playback  -->

			<StackPanel Orientation="Horizontal"
			            Spacing="10">
				<FontIcon FontSize="{Binding ElementName=AudioTextBlock, Path=FontSize}"
				          Glyph="&#xE8D6;" />
				<TextBlock x:Name="AudioTextBlock"
				           Style="{ThemeResource TitleTextBlockStyle}"
				           Text="Audio &amp; Playback" />
			</StackPanel>
			<dev:SettingsExpander Description="Click to view all crossfade/fade settings."
			                      Header="Crossfade/Fade">
				<dev:SettingsExpander.Items>
					<dev:SettingsCard x:Name="PlayPauseStopFadeCard"
					                  Header="Fade Play/Pause/Stop">
						<StackPanel>
							<ToggleSwitch x:Name="PlayPauseStopFadeSwitch"
							              HorizontalAlignment="Right"
							              Toggled="PlayPauseStopFadeSwitch_OnToggled" />
							<Slider x:Name="PlayPauseStopFadeSlider"
							        HorizontalAlignment="Right"
							        IsEnabledChanged="PlayPauseStopFadeSlider_OnIsEnabledChanged"
							        LargeChange="1000"
							        Maximum="1000"
							        Minimum="100"
							        SmallChange="10"
							        SnapsTo="Ticks"
							        TickFrequency="10"
							        TickPlacement="None" />
						</StackPanel>
					</dev:SettingsCard>
					<dev:SettingsCard x:Name="AutoAdvanceCard"
					                  Header="Auto advance Crossfading"
					                  Visibility="Collapsed">
						<StackPanel>
							<ToggleSwitch x:Name="AutoAdvanceSwitch"
							              HorizontalAlignment="Right"
							              Toggled="AutoAdvanceSwitch_OnToggled" />
							<Slider x:Name="AutoAdvanceSlider"
							        HorizontalAlignment="Right"
							        IsEnabledChanged="AutoAdvanceSlider_OnIsEnabledChanged"
							        LargeChange="1000"
							        Maximum="5000"
							        Minimum="100"
							        SmallChange="10"
							        SnapsTo="Ticks"
							        TickFrequency="10"
							        TickPlacement="None" />
						</StackPanel>
					</dev:SettingsCard>
					<dev:SettingsCard x:Name="ManualTrackChangeCard"
					                  Header="Manual Track Change Crossfading"
					                  Visibility="Collapsed">
						<StackPanel>
							<ToggleSwitch x:Name="ManualTrackChangeSwitch"
							              HorizontalAlignment="Right"
							              Toggled="ManualTrackChangeSwitch_OnToggled" />
							<Slider x:Name="ManualTrackChangeSlider"
							        HorizontalAlignment="Right"
							        IsEnabledChanged="ManualTrackChangeSlider_OnIsEnabledChanged"
							        LargeChange="1000"
							        Maximum="5000"
							        Minimum="100"
							        SmallChange="10"
							        SnapsTo="Ticks"
							        TickFrequency="10"
							        TickPlacement="None" />
						</StackPanel>
					</dev:SettingsCard>
				</dev:SettingsExpander.Items>
			</dev:SettingsExpander>
			<dev:SettingsCard Description="When turned on, the app will restart the track that is currently playing when previous button is pressed."
			                  Header="Previous button restarts the current track">
				<ToggleSwitch x:Name="PreviousReset"
				              Toggled="PreviousReset_OnToggled" />
			</dev:SettingsCard>
			<dev:SettingsCard Description="When turned on, the app will restart the track that is currently playing when it is selected again."
			                  Header="Restart Track on Selection">
				<ToggleSwitch x:Name="RestartTrackOnSelection"
				              Toggled="RestartTrackOnSelection_OnToggled" />
			</dev:SettingsCard>
			<dev:SettingsCard Description="When turned on, the app will use the system volume control. When turned off, the app will use the Tunetastic app volume control."
			                  Header="Use System Volume Control">
				<ToggleSwitch x:Name="UseSystemVolume"
				              Toggled="UseSystemVolume_OnToggled" />
			</dev:SettingsCard>
			<dev:SettingsCard Description="When turned on, the app will pause the track that is currently playing when the volume is muted."
			                  Header="Pause on Mute"
			                  Visibility="Collapsed">
				<ToggleSwitch x:Name="PauseOnMute"
				              Toggled="PauseOnMute_OnToggled" />
			</dev:SettingsCard>
			<dev:SettingsCard Description="When turned on, the app will start playing the track that was last playing."
			                  Header="Auto-Start playing track when app starts">
				<ToggleSwitch x:Name="AutoStart"
				              Toggled="AutoStart_OnToggled" />
			</dev:SettingsCard>

			<!--  Appearance & behavior  -->

			<StackPanel Orientation="Horizontal"
			            Spacing="10">
				<FontIcon FontSize="{Binding ElementName=AppearanceTextBlock, Path=FontSize}"
				          Glyph="&#xE790;" />
				<TextBlock x:Name="AppearanceTextBlock"
				           Style="{ThemeResource TitleTextBlockStyle}"
				           Text="Appearance &amp; Behavior" />
			</StackPanel>
			<dev:SettingsCard Description="Select the theme that suits your mood and preference. You can choose from dark, light, or system themes."
			                  Header="App theme">
				<ComboBox x:Name="Theme">
					<ComboBoxItem Content="Light"
					              Tag="Light" />
					<ComboBoxItem Content="Dark"
					              Tag="Dark" />
					<ComboBoxItem Content="Default"
					              Tag="Default" />
				</ComboBox>
			</dev:SettingsCard>
			<dev:SettingsCard Description="Change the appearance of the backdrop material behind your app. You can choose from mica, acrylic, or transparent options."
			                  Header="Material">
				<ComboBox x:Name="Backdrop">
					<ComboBoxItem Content="Mica"
					              Tag="Mica" />
					<ComboBoxItem Content="Mica Alt"
					              Tag="MicaAlt" />
					<ComboBoxItem Content="Acrylic"
					              Tag="Acrylic" />
					<ComboBoxItem Content="Acrylic Thin"
					              Tag="AcrylicThin" />
					<ComboBoxItem Content="Transparent"
					              Tag="Transparent" />
				</ComboBox>
			</dev:SettingsCard>
			<dev:SettingsExpander x:Name="TintSettings"
			                      Description="Add tint to your window to make your experience more personalized."
			                      Header="Tint Color"
			                      IsExpanded="True">
				<Button Padding="0">
					<StackPanel Orientation="Horizontal">
						<Border Width="24"
						        Height="24"
						        Margin="4"
						        Background="Gray"
						        CornerRadius="4">
							<Grid>
								<PathIcon Data="M0 6 L0 0 L6 0 L6 6 L12 6 L12 0 L18 0 L18 6 L12 6 L12 12 L18 12 L18 6 L24 6 L24 12 L18 12 L18 18 L24 18 L24 24 L6 24 L6 18 L0 18 L0 12 L6 12 L6 18 L12 18 L12 24 L18 24 L18 18 L12 18 L12 12 L6 12 L6 6 Z"
								          Foreground="LightGray" />
								<Rectangle x:Name="TintBox" />
							</Grid>
						</Border>
						<FontIcon Margin="8,4,10,4"
						          FontSize="12"
						          Glyph="&#xE70D;" />
					</StackPanel>
					<Button.Flyout>
						<Flyout>
							<ColorPicker ColorChanged="OnColorChanged"
							             IsAlphaEnabled="True"
							             IsMoreButtonVisible="True" />
						</Flyout>
					</Button.Flyout>
				</Button>
				<dev:SettingsExpander.ItemsHeader>
					<dev:SettingsCard>
						<dev:SettingsCard.Description>
							<dev:ColorPalette Margin="5,5,0,0"
							                  HorizontalAlignment="Left"
							                  ColorChanged="ColorPalette_ColorChanged"
							                  ColorSet="Extended"
							                  ItemHeight="40"
							                  ItemShape="Circle"
							                  ItemWidth="40"
							                  ShowColorName="True"
							                  ShowToolTip="True" />
						</dev:SettingsCard.Description>
					</dev:SettingsCard>
				</dev:SettingsExpander.ItemsHeader>
			</dev:SettingsExpander>
			<dev:SettingsCard ActionIcon="{dev:BitmapIcon Source=Assets/Fluent/External.png}"
			                  Description="Sync your app’s color with your Windows accent color. You can open the Windows accent color setting by clicking this card."
			                  Header="Accent color"
			                  IsClickEnabled="True"
			                  LaunchUri="ms-settings:colors" />
			<dev:SettingsCard Header="Main Player Background Blur Intensity">
				<Slider x:Name="MainPlayerBlurSlider"
				        Maximum="10"
				        Minimum="1"
				        SmallChange="1"
				        SnapsTo="StepValues"
				        TickFrequency="1"
				        TickPlacement="Inline" />
			</dev:SettingsCard>
			<dev:SettingsExpander Description="When turned on, starts a rainbow frame border around the app window."
			                      Header="Rainbow Frame Border">
				<ToggleSwitch x:Name="RainbowToggle"
				              Toggled="RainbowToggle_OnToggled" />
				<dev:SettingsExpander.Items>
					<dev:SettingsCard x:Name="RainbowSpeed"
					                  Header="Rainbow Speed">
						<Slider x:Name="RainbowSpeedSlider"
						        IsEnabledChanged="RainbowSpeedSlider_OnIsEnabledChanged"
						        Maximum="50"
						        Minimum="1"
						        SmallChange="1"
						        SnapsTo="StepValues"
						        TickFrequency="1"
						        TickPlacement="Inline" />
					</dev:SettingsCard>
					<dev:SettingsCard Description="When turned on, The rainbow frame border will be applied only when there's a track in playing"
					                  Header="Only during playback">
						<ToggleSwitch x:Name="RainbowOnlyDuringPlayback"
						              Toggled="RainbowOnlyDuringPlayback_OnToggled" />
					</dev:SettingsCard>
				</dev:SettingsExpander.Items>
			</dev:SettingsExpander>

			<dev:SettingsCard Description="When turned on, the app will minimize to system tray when the window is closed."
			                  Header="Minimize the app to system tray">
				<ToggleSwitch x:Name="MinimizeToTray"
				              Toggled="MinimizeToTray_OnToggled" />
			</dev:SettingsCard>

			<!--  About  -->

			<StackPanel Orientation="Horizontal"
			            Spacing="10">
				<FontIcon FontSize="{Binding ElementName=AboutTextBlock, Path=FontSize}"
				          Glyph="&#xE946;" />
				<TextBlock x:Name="AboutTextBlock"
				           Style="{ThemeResource TitleTextBlockStyle}"
				           Text="About" />
			</StackPanel>

			<!--<dev:SettingsCard Header="{x:Bind ViewModel.CurrentVersion}"
			                  HeaderIcon="{dev:BitmapIcon Source=Assets/Fluent/Update.png}">
				<dev:SettingsCard.Description>
					<StackPanel Orientation="Horizontal"
					            Spacing="5">
						<TextBlock Style="{StaticResource SecondaryTextStyle}"
						           Text="Last Update Check" />
						<TextBlock FlowDirection="LeftToRight"
						           Style="{StaticResource SecondaryTextStyle}"
						           Text="{x:Bind ViewModel.LastUpdateCheck}" />
					</StackPanel>
				</dev:SettingsCard.Description>
				<StackPanel Orientation="Horizontal"
				            Spacing="10">
					<ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
					<Button MinWidth="{StaticResource SettingActionControlMinWidth}"
					        Command="{x:Bind ViewModel.CheckForUpdateCommand}"
					        Content="Check for New Version"
					        IsEnabled="{x:Bind ViewModel.IsCheckButtonEnabled, Mode=OneWay}"
					        Style="{ThemeResource AccentButtonStyle}" />
				</StackPanel>
			</dev:SettingsCard>-->

			<dev:SettingsExpander Description="Tunetastic is a next gen music player for Windows 11 that blends sleek design and deep personalization, turning your library into an experience that’s as unique, expressive and captivating as the music you love. 🎶"
			                      Header="Tunetastic by AMit-KP"
			                      HeaderIcon="{dev:BitmapIcon Source=Assets/AppIcon.png}"
			                      IsExpanded="False">
				<StackPanel Orientation="Horizontal"
				            Spacing="10">
					<TextBlock VerticalAlignment="Center"
					           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
					           IsTextSelectionEnabled="True"
					           Text="{x:Bind dev:ProcessInfoHelper.VersionWithPrefix}" />
					<dev:ProgressButton x:Name="CheckForUpdates"
					                    Width="180"
					                    CheckedContent="Checking..."
					                    Click="CheckForUpdates_Click"
					                    Content="Check for New Version"
					                    IsIndeterminateProgressRing="true"
					                    ProgressRingVisibility="Visible" />
				</StackPanel>
				<dev:SettingsExpander.Items>
					<dev:SettingsCard Description="When turned on, the app will automatically check for updates at startup."
					                  Header="Check for updates at startup">
						<ToggleSwitch x:Name="CheckForUpdatesStartupToggle"
						              Toggled="CheckForUpdatesStartupToggle_Toggled" />
					</dev:SettingsCard>
					<dev:SettingsCard Description="When turned on, the current app version will be shown on the title bar."
					                  Header="Show version info on TitleBar">
						<ToggleSwitch x:Name="VersionInfoToggle"
						              Toggled="VersionInfoToggle_Toggled" />
					</dev:SettingsCard>
					<dev:SettingsCard HorizontalContentAlignment="Left"
					                  ContentAlignment="Left">
						<StackPanel Orientation="Vertical"
						            Spacing="8">
							<TextBlock Text="Related Links" />
							<StackPanel Orientation="Horizontal"
							            Spacing="2">
								<Image x:Name="SourceCodeImage"
								       Height="30" />
								<HyperlinkButton Content="Source Code"
								                 NavigateUri="https://github.com/AMit-KP/Tunetastic" />
							</StackPanel>
							<StackPanel Orientation="Horizontal"
							            Spacing="2">
								<Image x:Name="MicrosoftStoreImage"
								       Height="30" />
								<HyperlinkButton Content="Microsoft Store Page"
								                 NavigateUri="https://apps.microsoft.com/detail/9PCCNQZTD6PX?mode=full" />
							</StackPanel>
						</StackPanel>
					</dev:SettingsCard>
				</dev:SettingsExpander.Items>
			</dev:SettingsExpander>

			<!--  Reset  -->

			<StackPanel Orientation="Horizontal"
			            Spacing="10">
				<FontIcon FontSize="{Binding ElementName=ResetTextBlock, Path=FontSize}"
				          Glyph="&#xE777;" />
				<TextBlock x:Name="ResetTextBlock"
				           Style="{ThemeResource TitleTextBlockStyle}"
				           Text="Reset" />
			</StackPanel>
			<dev:SettingsCard Description="It will delete all saved data from Windows App Data. App will restart automatically."
			                  Header="Reset All Saved Settings">
				<Button Content="Reset">
					<Button.Flyout>
						<Flyout>
							<Flyout.FlyoutPresenterStyle>
								<Style TargetType="FlyoutPresenter">
									<Setter Property="Background" Value="{ThemeResource LayerOnMicaBaseAltFillColorDefault}" />
								</Style>
							</Flyout.FlyoutPresenterStyle>
							<StackPanel Spacing="5">
								<TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
								           Text="Are you sure?" />
								<Button Command="{x:Bind ViewModel.ResetCommand}"
								        Content="Yes" />
							</StackPanel>
						</Flyout>
					</Button.Flyout>
				</Button>
			</dev:SettingsCard>
		</StackPanel>
	</ScrollView>
</Page>

