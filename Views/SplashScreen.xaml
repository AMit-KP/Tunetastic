<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Tunetastic.Views.SplashScreen"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:Tunetastic.Views"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
	<StackPanel HorizontalAlignment="Center"
	            VerticalAlignment="Center"
	            Orientation="Vertical"
	            Spacing="50">
		<Image x:Name="SplashImage"
		       Width="500"
		       Height="500"
		       RenderTransformOrigin="0.5,0.5" />

		<ProgressRing IsActive="True" />
		<Grid x:Name="CustomProgressBar"
		      Width="400"
		      Height="50"
		      Background="{ThemeResource AccentAAFillColorDisabled}"
		      BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
		      BorderThickness="2"
		      CornerRadius="5"
		      Visibility="Collapsed">
			<Rectangle x:Name="ProgressFill"
			           Height="50"
			           HorizontalAlignment="Left"
			           Fill="{ThemeResource AccentAAFillColorDefaultBrush}" />
			<Grid>
				<TextBlock x:Name="ProgressFillText"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           Style="{ThemeResource BodyStrongTextBlockStyle}" />
			</Grid>
		</Grid>
	</StackPanel>
</Page>
