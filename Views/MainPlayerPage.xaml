<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Tunetastic.Views.MainPlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:Tunetastic.Common"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:Tunetastic"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:media="using:CommunityToolkit.WinUI.Media"
      xmlns:protos="using:Tunetastic.Generated.Protos"
      Loaded="Page_Loaded"
      SizeChanged="Page_SizeChanged"
      mc:Ignorable="d">
	<Grid>
		<Grid HorizontalAlignment="Stretch"
		      VerticalAlignment="Stretch">
			<Image x:Name="BackgroundImage"
			       Stretch="Fill" />
			<Border HorizontalAlignment="Stretch"
			        VerticalAlignment="Stretch"
			        BorderBrush="Transparent"
			        BorderThickness="0">
				<Border.Background>
					<media:BackdropBlurBrush x:Name="BlurEffect" />
				</Border.Background>
			</Border>
		</Grid>
		<Grid x:Name="CoverArt"
		      Margin="0,0,0,40">
			<Image x:Name="CoverArtImage"
			       Stretch="Fill" />
		</Grid>
		<Grid x:Name="MusicDetails"
		      Width="Auto"
		      Height="Auto"
		      Margin="0,0,0,5"
		      HorizontalAlignment="Center"
		      VerticalAlignment="Bottom">

			<Border Width="Auto"
			        Height="Auto"
			        Margin="140,-0,140,-0"
			        Padding="20,10,20,10"
			        VerticalAlignment="Bottom"
			        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
			        CornerRadius="25">
				<StackPanel VerticalAlignment="Center">
					<TextBlock Name="Title"
					           HorizontalAlignment="Center"
					           VerticalAlignment="Center"
					           FontWeight="ExtraBold"
					           HorizontalTextAlignment="Center"
					           TextAlignment="Center"
					           TextWrapping="WrapWholeWords" />
					<TextBlock Name="Artist"
					           HorizontalAlignment="Center"
					           VerticalAlignment="Center"
					           FontStyle="Italic"
					           FontWeight="Bold"
					           HorizontalTextAlignment="Center"
					           TextAlignment="Center"
					           TextWrapping="WrapWholeWords" />
					<TextBlock Name="Album"
					           HorizontalAlignment="Center"
					           VerticalAlignment="Center"
					           HorizontalTextAlignment="Center"
					           Style="{ThemeResource SubtitleTextBlockStyle}"
					           TextAlignment="Center"
					           TextWrapping="WrapWholeWords" />
				</StackPanel>
			</Border>
		</Grid>
	</Grid>
</Page>

