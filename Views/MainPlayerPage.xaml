<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Tunetastic.Views.MainPlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:Tunetastic"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:media="using:CommunityToolkit.WinUI.Media"
      SizeChanged="Page_SizeChanged"
      mc:Ignorable="d">

	<Page.Resources>

		<Storyboard x:Name="TiltInStoryboard">

			<DoubleAnimation Storyboard.TargetName="CoverArtTransform"
			                 Storyboard.TargetProperty="TranslateX"
			                 To="-110"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="CoverArtTransform"
			                 Storyboard.TargetProperty="ScaleX"
			                 To="0.93"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="CoverArtTransform"
			                 Storyboard.TargetProperty="ScaleY"
			                 To="0.93"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="CoverArtProjection"
			                 Storyboard.TargetProperty="RotationY"
			                 To="-38"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<!--  Fade in the left edge slab  -->
			<DoubleAnimation Storyboard.TargetName="LeftEdge"
			                 Storyboard.TargetProperty="Opacity"
			                 To="1"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<!--  Fade in the right-side darkening overlay  -->
			<DoubleAnimation Storyboard.TargetName="DepthShade"
			                 Storyboard.TargetProperty="Opacity"
			                 To="1"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<!--  Shadow grows when tilted  -->
			<DoubleAnimation Storyboard.TargetName="ShadowLayer"
			                 Storyboard.TargetProperty="Opacity"
			                 To="0.55"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

		</Storyboard>

		<Storyboard x:Name="TiltOutStoryboard">

			<DoubleAnimation Storyboard.TargetName="CoverArtTransform"
			                 Storyboard.TargetProperty="TranslateX"
			                 To="0"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="CoverArtTransform"
			                 Storyboard.TargetProperty="ScaleX"
			                 To="1"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="CoverArtTransform"
			                 Storyboard.TargetProperty="ScaleY"
			                 To="1"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="CoverArtProjection"
			                 Storyboard.TargetProperty="RotationY"
			                 To="0"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="LeftEdge"
			                 Storyboard.TargetProperty="Opacity"
			                 To="0"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="DepthShade"
			                 Storyboard.TargetProperty="Opacity"
			                 To="0"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="ShadowLayer"
			                 Storyboard.TargetProperty="Opacity"
			                 To="0"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

		</Storyboard>

		<Storyboard x:Name="LyricsFadeInStoryboard">
			<!--  Fade in  -->
			<DoubleAnimation Storyboard.TargetName="LyricsDisplay"
			                 Storyboard.TargetProperty="Opacity"
			                 From="0"
			                 To="1"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>
			<!--  Clip width expands from 0 to full — this IS the left-to-right reveal  -->
			<ObjectAnimationUsingKeyFrames Storyboard.TargetName="LyricsClip"
			                               Storyboard.TargetProperty="Rect">
				<!--  We'll drive this from code since Rect isn't directly animatable  -->
			</ObjectAnimationUsingKeyFrames>
		</Storyboard>

		<Style x:Key="LyricCapsuleStyle"
		       TargetType="Border">
			<Setter Property="Background" Value="{ThemeResource LayerOnMicaBaseAltFillColorDefault}" />
			<Setter Property="CornerRadius" Value="20" />
			<Setter Property="Padding" Value="10,6,10,10" />
			<Setter Property="Margin" Value="0,0,0,8" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<!--  was Stretch  -->
		</Style>

		<Style x:Key="LyricTextStyle"
		       TargetType="TextBlock">
			<Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
			<Setter Property="FontSize" Value="18" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="HorizontalTextAlignment" Value="Center" />
			<Setter Property="HorizontalAlignment" Value="Center" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="TextWrapping" Value="Wrap" />
		</Style>

		<Style x:Key="SyncedLyricTextStyle"
		       TargetType="TextBlock">
			<Setter Property="FontSize" Value="22" />
			<Setter Property="FontWeight" Value="Bold" />
			<Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
			<Setter Property="TextAlignment" Value="Center" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="HorizontalTextAlignment" Value="Center" />
		</Style>

		<Style x:Key="LyricButtonStyle"
		       TargetType="Button">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="8,4" />
			<Setter Property="HorizontalAlignment" Value="Stretch" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
						                  Background="Transparent"
						                  Content="{TemplateBinding Content}" />
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Page.Resources>

	<Grid>
		<Grid HorizontalAlignment="Stretch"
		      VerticalAlignment="Stretch">
			<Image x:Name="BackgroundImage"
			       Opacity="0"
			       Stretch="Fill" />
			<Border x:Name="BlurBorder"
			        HorizontalAlignment="Stretch"
			        VerticalAlignment="Stretch"
			        BorderBrush="Transparent"
			        BorderThickness="0">
				<Border.Background>
					<media:BackdropBlurBrush x:Name="BlurEffect" />
				</Border.Background>
			</Border>
		</Grid>

		<Border x:Name="ShadowLayer"
		        Margin="0,60,0,60"
		        HorizontalAlignment="Center"
		        VerticalAlignment="Stretch"
		        Background="Transparent"
		        IsHitTestVisible="False"
		        Opacity="0">
			<Border.RenderTransform>
				<TranslateTransform X="30" Y="20" />
			</Border.RenderTransform>
			<Border Background="#CC000000"
			        CornerRadius="40">
				<Border.RenderTransform>
					<ScaleTransform ScaleX="0.88" ScaleY="0.96" />
				</Border.RenderTransform>
			</Border>
		</Border>

		<Grid x:Name="CoverArt"
		      Margin="0,0,0,40">

			<Grid.Projection>
				<PlaneProjection x:Name="CoverArtProjection"
				                 CenterOfRotationX="0.5"
				                 CenterOfRotationY="0.5"
				                 RotationY="0" />
			</Grid.Projection>

			<Grid.RenderTransform>
				<CompositeTransform x:Name="CoverArtTransform"
				                    ScaleX="1"
				                    ScaleY="1"
				                    TranslateX="0" />
			</Grid.RenderTransform>

			<Image x:Name="CoverArtImage"
			       Stretch="Fill" />

			<Border x:Name="LeftEdge"
			        Width="18"
			        HorizontalAlignment="Left"
			        IsHitTestVisible="False"
			        Opacity="0">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0" Color="#CCFFFFFF" />
						<GradientStop Offset="1" Color="#00FFFFFF" />
					</LinearGradientBrush>
				</Border.Background>
			</Border>

			<Border x:Name="DepthShade"
			        IsHitTestVisible="False"
			        Opacity="0">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0" Color="#00000000" />
						<GradientStop Offset="0.6" Color="#00000000" />
						<GradientStop Offset="1" Color="#99000000" />
					</LinearGradientBrush>
				</Border.Background>
			</Border>

		</Grid>

		<Canvas x:Name="LyricsCanvas"
		        HorizontalAlignment="Stretch"
		        VerticalAlignment="Stretch"
		        IsHitTestVisible="True">
			<Grid x:Name="LyricsDisplay"
			      Opacity="0"
			      Visibility="Collapsed">
				<ScrollView x:Name="LyricsScrollView"
				            VerticalScrollBarVisibility="Hidden">
					<StackPanel x:Name="LyricsPanel"
					            Padding="24,12"
					            Spacing="0" />
				</ScrollView>
			</Grid>
		</Canvas>

		<Grid x:Name="MusicDetails"
		      Width="Auto"
		      Height="Auto"
		      Margin="-100,0,-100,5"
		      HorizontalAlignment="Center"
		      VerticalAlignment="Bottom"
		      Tapped="MusicDetails_Tapped">
			<Border Width="Auto"
			        Height="Auto"
			        MaxHeight="160"
			        Margin="140,-0,140,-0"
			        Padding="20,10,20,10"
			        VerticalAlignment="Bottom"
			        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
			        CornerRadius="25">
				<StackPanel VerticalAlignment="Center">
					<TextBlock Name="Title"
					           HorizontalAlignment="Center"
					           VerticalAlignment="Center"
					           FontWeight="ExtraBold"
					           HorizontalTextAlignment="Center"
					           MaxLines="1"
					           TextAlignment="Center"
					           TextTrimming="WordEllipsis"
					           TextWrapping="WrapWholeWords" />
					<TextBlock Name="Artist"
					           HorizontalAlignment="Center"
					           VerticalAlignment="Center"
					           FontStyle="Italic"
					           FontWeight="Bold"
					           HorizontalTextAlignment="Center"
					           MaxLines="2"
					           TextAlignment="Center"
					           TextTrimming="WordEllipsis"
					           TextWrapping="WrapWholeWords" />
					<TextBlock Name="Album"
					           HorizontalAlignment="Center"
					           VerticalAlignment="Center"
					           HorizontalTextAlignment="Center"
					           MaxLines="1"
					           Style="{ThemeResource SubtitleTextBlockStyle}"
					           TextAlignment="Center"
					           TextTrimming="WordEllipsis"
					           TextWrapping="WrapWholeWords" />
				</StackPanel>
			</Border>
		</Grid>

		<Grid Width="Auto"
		      Height="Auto"
		      Margin="0,0,5,0"
		      HorizontalAlignment="Right"
		      VerticalAlignment="Bottom"
		      RowSpacing="2">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Button x:Name="MusicInfoButton"
			        Grid.Row="2"
			        Width="40"
			        Height="40"
			        Margin="5"
			        Padding="3"
			        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
			        Click="MusicInfoButton_Click"
			        ToolTipService.ToolTip="Song/Track Info">
				<FontIcon Glyph="&#xE90B;" />
			</Button>
			<Button x:Name="ShowLyricsButton"
			        Grid.Row="1"
			        Width="40"
			        Height="40"
			        Margin="5"
			        Padding="3"
			        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
			        Click="ShowLyricsButton_Click"
			        ToolTipService.ToolTip="Show Lyrics"
			        Visibility="Collapsed">
				<FontIcon Glyph="&#xE7BC;" />
			</Button>
			<Button x:Name="CloseLyricsButton"
			        Grid.Row="1"
			        Width="40"
			        Height="40"
			        Margin="5"
			        Padding="3"
			        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
			        Click="CloseLyricsButton_Click"
			        ToolTipService.ToolTip="Hide Lyrics"
			        Visibility="Collapsed">
				<FontIcon Glyph="&#xE89F;" />
			</Button>
			<Button x:Name="LyricsMenuButton"
			        Grid.Row="0"
			        Width="40"
			        Height="40"
			        Margin="5"
			        Padding="0"
			        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
			        ToolTipService.ToolTip="Lyrics Menu"
			        Visibility="Collapsed">
				<FontIcon Glyph="&#xE712;" />
				<Button.Flyout>
					<MenuFlyout dev:MenuFlyoutAttach.AutoCloseByClickOnSecondaryMenuItems="true"
					            dev:MenuFlyoutAttach.SecondaryMenuPlacement="Top">
						<dev:MenuFlyoutAttach.SecondaryMenu>
							<dev:MenuFlyoutSecondaryItems>
								<AppBarButton x:Name="CopyLyricsButton"
								              Click="CopyAppBarButton_Click"
								              Icon="Copy"
								              Label="Copy"
								              ToolTipService.ToolTip="Copy the lyrics" />
								<AppBarSeparator x:Name="Separator1" />
								<AppBarButton x:Name="EditLyricsButton"
								              Click="EditAppBarButton_Click"
								              Icon="Edit"
								              Label="Edit"
								              ToolTipService.ToolTip="Edit the lyrics" />
								<!--<AppBarSeparator x:Name="Separator2"/>
								<AppBarButton x:Name="SearchLyricsButton"
								              Click="SearchAppBarButton_Click"
								              Icon="Find"
								              IsEnabled="False"
								              Label="Search"
								              ToolTipService.ToolTip="Search for lyrics on internet" />-->
								<AppBarSeparator x:Name="Separator3" />
								<AppBarButton x:Name="ClearLyricsButton"
								              Click="ClearAppBarButton_Click"
								              Icon="Delete"
								              Label="Clear"
								              ToolTipService.ToolTip="Clear the existing lyrics" />
								<AppBarButton x:Name="OpenLyricsButton"
								              Click="OpenAppBarButton_Click"
								              Icon="Folder"
								              Label="Open File"
								              ToolTipService.ToolTip="Open the lrc file" />
							</dev:MenuFlyoutSecondaryItems>
						</dev:MenuFlyoutAttach.SecondaryMenu>
					</MenuFlyout>
				</Button.Flyout>
			</Button>
		</Grid>

		<Grid MinWidth="800"
		      MinHeight="600"
		      HorizontalAlignment="Center"
		      VerticalAlignment="Center">
			<ContentDialog x:Name="LyricsEditBlock"
			               Title="Edit Lyrics"
			               MinWidth="800"
			               MinHeight="600"
			               HorizontalAlignment="Center"
			               VerticalAlignment="Center"
			               HorizontalContentAlignment="Center"
			               VerticalContentAlignment="Center"
			               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
			               DefaultButton="Primary"
			               PrimaryButtonText="Save"
			               SecondaryButtonText="Cancel"
			               Visibility="Visible">
				<Grid>
					<TextBox x:Name="LyricsTextBox"
					         AcceptsReturn="True"
					         AutomationProperties.Name="multi-line TextBox"
					         IsSpellCheckEnabled="True"
					         SelectionHighlightColor="DodgerBlue"
					         TextWrapping="Wrap" />
				</Grid>
			</ContentDialog>
		</Grid>
	</Grid>
</Page>
