<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Tunetastic.Views.MainPlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:Tunetastic.Common"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:Tunetastic"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:media="using:CommunityToolkit.WinUI.Media"
      SizeChanged="Page_SizeChanged"
      mc:Ignorable="d">

	<Page.Resources>

		<Storyboard x:Name="TiltInStoryboard">

			<DoubleAnimation Storyboard.TargetName="CoverArtTransform"
			                 Storyboard.TargetProperty="TranslateX"
			                 To="-110"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="CoverArtTransform"
			                 Storyboard.TargetProperty="ScaleX"
			                 To="0.93"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="CoverArtTransform"
			                 Storyboard.TargetProperty="ScaleY"
			                 To="0.93"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="CoverArtProjection"
			                 Storyboard.TargetProperty="RotationY"
			                 To="-38"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<!--  Fade in the left edge slab  -->
			<DoubleAnimation Storyboard.TargetName="LeftEdge"
			                 Storyboard.TargetProperty="Opacity"
			                 To="1"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<!--  Fade in the right-side darkening overlay  -->
			<DoubleAnimation Storyboard.TargetName="DepthShade"
			                 Storyboard.TargetProperty="Opacity"
			                 To="1"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<!--  Shadow grows when tilted  -->
			<DoubleAnimation Storyboard.TargetName="ShadowLayer"
			                 Storyboard.TargetProperty="Opacity"
			                 To="0.55"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

		</Storyboard>

		<Storyboard x:Name="TiltOutStoryboard">

			<DoubleAnimation Storyboard.TargetName="CoverArtTransform"
			                 Storyboard.TargetProperty="TranslateX"
			                 To="0"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="CoverArtTransform"
			                 Storyboard.TargetProperty="ScaleX"
			                 To="1"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="CoverArtTransform"
			                 Storyboard.TargetProperty="ScaleY"
			                 To="1"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="CoverArtProjection"
			                 Storyboard.TargetProperty="RotationY"
			                 To="0"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="LeftEdge"
			                 Storyboard.TargetProperty="Opacity"
			                 To="0"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="DepthShade"
			                 Storyboard.TargetProperty="Opacity"
			                 To="0"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

			<DoubleAnimation Storyboard.TargetName="ShadowLayer"
			                 Storyboard.TargetProperty="Opacity"
			                 To="0"
			                 Duration="0:0:0.55">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>

		</Storyboard>

		<Storyboard x:Name="LyricsFadeInStoryboard">
			<!--  Fade in  -->
			<DoubleAnimation Storyboard.TargetName="LyricsDisplay"
			                 Storyboard.TargetProperty="Opacity"
			                 From="0"
			                 To="1"
			                 Duration="0:0:0.65">
				<DoubleAnimation.EasingFunction>
					<CircleEase EasingMode="EaseOut" />
				</DoubleAnimation.EasingFunction>
			</DoubleAnimation>
			<!--  Clip width expands from 0 to full — this IS the left-to-right reveal  -->
			<ObjectAnimationUsingKeyFrames Storyboard.TargetName="LyricsClip"
			                               Storyboard.TargetProperty="Rect">
				<!--  We'll drive this from code since Rect isn't directly animatable  -->
			</ObjectAnimationUsingKeyFrames>
		</Storyboard>

	</Page.Resources>

	<Grid>
		<Grid HorizontalAlignment="Stretch"
		      VerticalAlignment="Stretch">
			<Image x:Name="BackgroundImage"
			       Opacity="0"
			       Stretch="Fill" />
			<Border x:Name="BlurBorder"
			        HorizontalAlignment="Stretch"
			        VerticalAlignment="Stretch"
			        BorderBrush="Transparent"
			        BorderThickness="0">
				<Border.Background>
					<media:BackdropBlurBrush x:Name="BlurEffect" />
				</Border.Background>
			</Border>
		</Grid>

		<Border x:Name="ShadowLayer"
		        Margin="0,60,0,60"
		        HorizontalAlignment="Center"
		        VerticalAlignment="Stretch"
		        Background="Transparent"
		        IsHitTestVisible="False"
		        Opacity="0">
			<Border.RenderTransform>
				<TranslateTransform X="30" Y="20" />
			</Border.RenderTransform>
			<Border Background="#CC000000"
			        CornerRadius="40">
				<Border.RenderTransform>
					<ScaleTransform ScaleX="0.88" ScaleY="0.96" />
				</Border.RenderTransform>
			</Border>
		</Border>

		<Grid x:Name="CoverArt"
		      Margin="0,0,0,40">

			<Grid.Projection>
				<PlaneProjection x:Name="CoverArtProjection"
				                 CenterOfRotationX="0.5"
				                 CenterOfRotationY="0.5"
				                 RotationY="0" />
			</Grid.Projection>

			<Grid.RenderTransform>
				<CompositeTransform x:Name="CoverArtTransform"
				                    ScaleX="1"
				                    ScaleY="1"
				                    TranslateX="0" />
			</Grid.RenderTransform>

			<Image x:Name="CoverArtImage"
			       Stretch="Fill" />

			<Border x:Name="LeftEdge"
			        Width="18"
			        HorizontalAlignment="Left"
			        IsHitTestVisible="False"
			        Opacity="0">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0" Color="#CCFFFFFF" />
						<GradientStop Offset="1" Color="#00FFFFFF" />
					</LinearGradientBrush>
				</Border.Background>
			</Border>

			<Border x:Name="DepthShade"
			        IsHitTestVisible="False"
			        Opacity="0">
				<Border.Background>
					<LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
						<GradientStop Offset="0" Color="#00000000" />
						<GradientStop Offset="0.6" Color="#00000000" />
						<GradientStop Offset="1" Color="#99000000" />
					</LinearGradientBrush>
				</Border.Background>
			</Border>

		</Grid>

		<Canvas x:Name="LyricsCanvas"
		        HorizontalAlignment="Stretch"
		        VerticalAlignment="Stretch"
		        IsHitTestVisible="True">
			<Grid x:Name="LyricsDisplay"
			      Opacity="0"
			      Visibility="Collapsed">
				<ScrollView VerticalScrollBarVisibility="Hidden">
					<StackPanel x:Name="LyricsPanel"
					            HorizontalAlignment="Center"
					            Spacing="0" />
				</ScrollView>
			</Grid>
		</Canvas>

		<Grid x:Name="MusicDetails"
		      Width="Auto"
		      Height="Auto"
		      Margin="-100,0,-100,5"
		      HorizontalAlignment="Center"
		      VerticalAlignment="Bottom"
		      Tapped="MusicDetails_Tapped">
			<Border Width="Auto"
			        Height="Auto"
			        MaxHeight="160"
			        Margin="140,-0,140,-0"
			        Padding="20,10,20,10"
			        VerticalAlignment="Bottom"
			        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
			        CornerRadius="25">
				<StackPanel VerticalAlignment="Center">
					<TextBlock Name="Title"
					           HorizontalAlignment="Center"
					           VerticalAlignment="Center"
					           FontWeight="ExtraBold"
					           HorizontalTextAlignment="Center"
					           TextAlignment="Center"
					           TextWrapping="WrapWholeWords" />
					<TextBlock Name="Artist"
					           HorizontalAlignment="Center"
					           VerticalAlignment="Center"
					           FontStyle="Italic"
					           FontWeight="Bold"
					           HorizontalTextAlignment="Center"
					           TextAlignment="Center"
					           TextWrapping="WrapWholeWords" />
					<TextBlock Name="Album"
					           HorizontalAlignment="Center"
					           VerticalAlignment="Center"
					           HorizontalTextAlignment="Center"
					           Style="{ThemeResource SubtitleTextBlockStyle}"
					           TextAlignment="Center"
					           TextWrapping="WrapWholeWords" />
				</StackPanel>
			</Border>
		</Grid>

		<Grid Width="Auto"
		      Height="Auto"
		      Margin="0,0,5,0"
		      HorizontalAlignment="Right"
		      VerticalAlignment="Bottom"
		      RowSpacing="5">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition />
			</Grid.RowDefinitions>
			<Button x:Name="MusicInfoButton"
			        Grid.Row="1"
			        Margin="5"
			        Padding="3"
			        Click="MusicInfoButton_Click"
			        Style="{ThemeResource AccentButtonStyle}"
			        ToolTipService.ToolTip="Song/Track Info">
				<FontIcon Glyph="&#xE90B;" />
			</Button>
			<Button x:Name="ShowLyricsButton"
			        Grid.Row="0"
			        Margin="5"
			        Padding="3"
			        Click="ShowLyricsButton_Click"
			        Style="{ThemeResource AccentButtonStyle}"
			        ToolTipService.ToolTip="Show Lyrics"
			        Visibility="Visible">
				<FontIcon Glyph="&#xE7BC;" />
			</Button>
			<Button x:Name="CloseLyricsButton"
			        Grid.Row="0"
			        Margin="5"
			        Padding="3"
			        Click="CloseLyricsButton_Click"
			        Style="{ThemeResource AccentButtonStyle}"
			        ToolTipService.ToolTip="Hide Lyrics"
			        Visibility="Collapsed">
				<FontIcon Glyph="&#xE89F;" />
			</Button>
		</Grid>
	</Grid>
</Page>
