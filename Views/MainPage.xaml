<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Tunetastic.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:Tunetastic.Common"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:Tunetastic"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="using:Microsoft.UI.Xaml"
      ActualThemeChanged="Page_ActualThemeChanged"
      Loaded="Page_Loaded"
      mc:Ignorable="d">

	<Grid>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<TitleBar x:Name="AppTitleBar"
			          IsBackButtonVisible="True"
			          IsPaneToggleButtonVisible="True">
				<TitleBar.LeftHeader>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ImageIcon x:Name="AppIcon"
						           Grid.Column="0"
						           Width="30"
						           Height="30"
						           Margin="5,0,10,0"
						           HorizontalAlignment="Center"
						           VerticalAlignment="Stretch"
						           Source="ms-appx:///Assets/AppIcon.png" />
						<dev:TextBlockStrokeView x:Name="AppTitle"
						                         Grid.Column="1"
						                         VerticalAlignment="Center"
						                         Animate="False"
						                         StrokeThickness="0">
							<TextBlock Margin="0,0,0,0"
							           VerticalAlignment="Center"
							           FontWeight="ExtraBold"
							           Style="{ThemeResource SubtitleTextBlockStyle}"
							           Text="Tunetastic" />
						</dev:TextBlockStrokeView>
					</Grid>
				</TitleBar.LeftHeader>
				<AutoSuggestBox x:Name="SearchBox"
				                MinWidth="320"
				                VerticalAlignment="Center"
				                PlaceholderText="Quick Search"
				                QueryIcon="Find"
				                QuerySubmitted="OnQuerySubmitted"
				                SuggestionChosen="SearchBox_SuggestionChosen"
				                TextChanged="OnTextChanged">
					<AutoSuggestBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal"
							            Spacing="8">
								<dev:SwitchPresenter TargetType="common:SearchItemType"
								                     Value="{Binding Key, Mode=OneWay}">
									<dev:Case Value="Artist">
										<FontIcon VerticalAlignment="Center"
										          FontFamily="Segoe MDL2 Assets"
										          Glyph="&#xE77B;" />
									</dev:Case>
									<dev:Case Value="Album">
										<FontIcon VerticalAlignment="Center"
										          FontFamily="Segoe MDL2 Assets"
										          Glyph="&#xE93C;" />
									</dev:Case>
									<dev:Case Value="Title">
										<FontIcon VerticalAlignment="Center"
										          FontFamily="Segoe MDL2 Assets"
										          Glyph="&#xE8D6;" />
									</dev:Case>
								</dev:SwitchPresenter>
								<TextBlock VerticalAlignment="Center"
								           Text="{Binding Value}"
								           TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</DataTemplate>
					</AutoSuggestBox.ItemTemplate>
				</AutoSuggestBox>
				<TitleBar.RightHeader>
					<Button x:Name="ThemeButton"
					        Height="32"
					        Margin="0,0,4,0"
					        Click="ThemeButton_Click"
					        Content="{dev:FontIcon GlyphCode=E793,
					                               FontSize=16}"
					        Style="{ThemeResource SubtleButtonStyle}"
					        ToolTipService.ToolTip="Toggle Theme" />
				</TitleBar.RightHeader>
			</TitleBar>

			<NavigationView x:Name="NavView"
			                Grid.Row="1"
			                IsBackButtonVisible="Collapsed"
			                IsBackEnabled="False"
			                IsPaneOpen="True"
			                IsPaneToggleButtonVisible="False"
			                ItemInvoked="NavView_ItemInvoked"
			                SelectionChanged="NavView_SelectionChanged">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="210" />
					</Grid.RowDefinitions>
					<Frame x:Name="NavFrame"
					       Grid.Row="0"
					       Margin="0,0,0,-75"
					       CacheSize="20" />
					<Frame x:Name="MusicControlsArea"
					       Grid.Row="1" />
				</Grid>
			</NavigationView>
		</Grid>
		<Grid Width="Auto"
		      Height="Auto"
		      HorizontalAlignment="Center"
		      VerticalAlignment="Center">
			<ContentDialog x:Name="AddPlaylistDialog"
			               Title="Create New Playlist"
			               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
			               DefaultButton="Primary"
			               IsPrimaryButtonEnabled="False"
			               PrimaryButtonText="Create"
			               SecondaryButtonText="Cancel"
			               Visibility="Collapsed">
				<StackPanel Spacing="10">
					<TextBox x:Name="PlaylistNameBox"
					         Width="400"
					         PlaceholderText="Enter playlist name"
					         TextChanged="OnPlaylistNameChanged" />
					<TextBlock x:Name="ErrorMessage"
					           Foreground="Red"
					           Text=""
					           TextWrapping="WrapWholeWords" />
					<StackPanel Width="400"
					            Orientation="Horizontal"
					            Spacing="10">
						<TextBlock x:Name="AddPlaylistDialogDescription"
						           Width="290"
						           VerticalAlignment="Center"
						           TextWrapping="WrapWholeWords">
							<Run Text="You can also select an existing playlist file." />
							<LineBreak />
							<Run Text="Supported formats: M3U, M3U8, PLS, WPL, ZPL" />
						</TextBlock>
						<Button Width="100"
						        Click="BrowseButton_Click"
						        Content="Browse"
						        Style="{StaticResource AccentButtonStyle}" />
					</StackPanel>
				</StackPanel>
			</ContentDialog>
			<ContentDialog x:Name="SongInfo"
			               Title="Song/Track Information"
			               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
			               CloseButtonText="Close"
			               DefaultButton="Close"
			               Visibility="Visible">
				<Grid RowSpacing="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid Grid.Row="0"
					      ColumnSpacing="10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="150" />
						</Grid.ColumnDefinitions>

						<Grid Grid.Column="0"
						      RowSpacing="10">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<Grid x:Name="TitleGrid"
							      Grid.Row="0"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Title:" />
								<TextBlock x:Name="SongTitle"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid x:Name="ArtistsGrid"
							      Grid.Row="1"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Artists:" />
								<TextBlock x:Name="SongArtists"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid x:Name="AlbumGrid"
							      Grid.Row="2"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Album:" />
								<TextBlock x:Name="SongAlbum"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
						</Grid>
						<Grid x:Name="CoverGrid"
						      Grid.Column="1"
						      Width="150"
						      Height="150"
						      HorizontalAlignment="Center"
						      VerticalAlignment="Center">
							<Grid Width="Auto"
							      Height="Auto"
							      HorizontalAlignment="Center"
							      VerticalAlignment="Center"
							      CornerRadius="10">
								<Image x:Name="SongCoverImage"
								       HorizontalAlignment="Center"
								       VerticalAlignment="Center" />
							</Grid>
						</Grid>

					</Grid>
					<Grid Grid.Row="1"
					      Width="Auto"
					      RowSpacing="10">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid Grid.Row="0"
						      RowSpacing="5">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<TextBlock Grid.Row="0"
							           FontWeight="ExtraBold"
							           Style="{ThemeResource BodyTextBlockStyle}"
							           Text="Genre:" />
							<TextBlock x:Name="SongGenre"
							           Grid.Row="1"
							           MaxLines="1"
							           Style="{ThemeResource BodyTextBlockStyle}"
							           TextTrimming="CharacterEllipsis" />
						</Grid>
						<Grid x:Name="OtherDetailsGrid"
						      Grid.Row="1"
						      ColumnSpacing="10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Grid Grid.Column="0"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Year:" />
								<TextBlock x:Name="SongYear"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid Grid.Column="1"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Duration:" />
								<TextBlock x:Name="SongDuration"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid Grid.Column="2"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Size:" />
								<TextBlock x:Name="SongSize"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid Grid.Column="3"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Added:" />
								<TextBlock x:Name="SongAdded"
								           Grid.Row="1"
								           MaxLines="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextTrimming="CharacterEllipsis" />
							</Grid>
						</Grid>
						<Grid x:Name="PathGrid"
						      Grid.Row="2"
						      RowSpacing="5">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<TextBlock Grid.Row="0"
							           FontWeight="ExtraBold"
							           Style="{ThemeResource BodyTextBlockStyle}"
							           Text="Path:" />
							<TextBlock x:Name="SongPath"
							           Grid.Row="1"
							           Style="{ThemeResource BodyTextBlockStyle}"
							           TextWrapping="WrapWholeWords" />
						</Grid>
						<Grid x:Name="CodecGrid"
						      Grid.Row="3"
						      ColumnSpacing="10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid Grid.Column="0"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Channel:" />
								<TextBlock x:Name="SongChannel"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid Grid.Column="1"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Bit rate:" />
								<TextBlock x:Name="SongBitrate"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid Grid.Column="2"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Sample rate:" />
								<TextBlock x:Name="SongSampleRate"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid Grid.Column="3"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Codec Description:" />
								<TextBlock x:Name="SongCodecDescription"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
						</Grid>
						<Grid x:Name="HistoryGrid"
						      Grid.Row="4"
						      ColumnSpacing="10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="50" />
							</Grid.ColumnDefinitions>
							<Grid Grid.Column="0">
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Style="{ThemeResource BodyTextBlockStyle}">
									<Run FontWeight="ExtraBold"
									     Text="Played Count: " />
									<Run x:Name="SongPlayCount" />
								</TextBlock>
							</Grid>
							<Grid Grid.Column="1">
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Style="{ThemeResource BodyTextBlockStyle}">
									<Run FontWeight="ExtraBold"
									     Text="Last Played: " />
									<Run x:Name="SongLastPlayed" />
								</TextBlock>
							</Grid>
							<Button x:Name="ClearButton"
							        Grid.Column="2"
							        Padding="5"
							        HorizontalAlignment="Center"
							        VerticalAlignment="Center"
							        HorizontalContentAlignment="Center"
							        VerticalContentAlignment="Center"
							        ToolTipService.ToolTip="Clear">
								<FontIcon Glyph="&#xE894;" />
								<Button.Flyout>
									<Flyout>
										<StackPanel Width="200"
										            Spacing="5">
											<TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
											           Text="Are you sure you want to clear Play count and Last Played Date-Time?"
											           TextWrapping="WrapWholeWords" />
											<Button Click="ClearButton_Click"
											        Content="Yes" />
										</StackPanel>
									</Flyout>
								</Button.Flyout>
							</Button>
						</Grid>
					</Grid>
				</Grid>
			</ContentDialog>
		</Grid>
	</Grid>
</Page>
