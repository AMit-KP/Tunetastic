<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Tunetastic.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:Tunetastic.Common"
      xmlns:controls="using:Tunetastic.Common.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:Tunetastic"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="using:Microsoft.UI.Xaml"
      ActualThemeChanged="Page_ActualThemeChanged"
      Loaded="Page_Loaded"
      mc:Ignorable="d">

	<Page.Resources>
		<Style x:Key="NewBadgeStyle"
		       TargetType="ContentControl">
			<Setter Property="IsTabStop" Value="False" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="ContentControl">
						<Border Padding="8,3,8,4"
						        HorizontalAlignment="Left"
						        VerticalAlignment="Center"
						        Background="{ThemeResource AccentFillColorDefaultBrush}"
						        CornerRadius="13">
							<TextBlock HorizontalAlignment="Center"
							           VerticalAlignment="Center"
							           CharacterSpacing="50"
							           FontSize="10"
							           FontWeight="Bold"
							           Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
							           Text="{TemplateBinding Content}" />
						</Border>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Page.Resources>

	<Grid>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<TitleBar x:Name="AppTitleBar"
			          IsBackButtonVisible="True"
			          IsPaneToggleButtonVisible="True">
				<TitleBar.LeftHeader>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ImageIcon x:Name="AppIcon"
						           Grid.Column="0"
						           Width="30"
						           Height="30"
						           Margin="5,0,10,0"
						           HorizontalAlignment="Center"
						           VerticalAlignment="Stretch"
						           Source="ms-appx:///Assets/AppIcon.png" />
						<dev:TextBlockStrokeView x:Name="AppTitle"
						                         Grid.Column="1"
						                         VerticalAlignment="Center"
						                         Animate="False"
						                         StrokeThickness="0">
							<TextBlock Margin="0,0,0,0"
							           VerticalAlignment="Center"
							           FontWeight="ExtraBold"
							           Style="{ThemeResource SubtitleTextBlockStyle}"
							           Text="Tunetastic" />
						</dev:TextBlockStrokeView>
						<TextBlock x:Name="VersionInfo"
						           Grid.Column="2"
						           Margin="4,8,0,0"
						           VerticalAlignment="Center"
						           Foreground="{ThemeResource TextFillColorDisabled}"
						           Style="{ThemeResource CaptionTextBlockStyle}"
						           Text="{x:Bind dev:ProcessInfoHelper.VersionWithPrefix}" />
					</Grid>
				</TitleBar.LeftHeader>
				<AutoSuggestBox x:Name="SearchBox"
				                Width="320"
				                VerticalAlignment="Center"
				                GotFocus="SearchBox_GotFocus"
				                LostFocus="SearchBox_LostFocus"
				                PlaceholderText="Quick Search"
				                QueryIcon="Find"
				                QuerySubmitted="OnQuerySubmitted"
				                SuggestionChosen="SearchBox_SuggestionChosen"
				                TextChanged="OnTextChanged"
				                TextMemberPath="Value">
					<AutoSuggestBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal"
							            Spacing="8">
								<dev:SwitchPresenter TargetType="common:SearchItemType"
								                     Value="{Binding Key, Mode=OneWay}">
									<dev:Case Value="Artist">
										<Viewbox Width="20"
										         Height="20">
											<Grid>
												<Path Data="M12,1.2A2.8,2.8 0 0,1 14.8,4V11A2.8,2.8 0 0,1 12,13.8A2.8,2.8 0 0,1 9.2,11V4A2.8,2.8 0 0,1 12,1.2M18.5,11A0.9,0.9 0 0,1 19.4,11.9C19.4,15.13 17.05,17.79 14,18.27V20.4H15.5A0.9,0.9 0 0,1 16.4,21.3A0.9,0.9 0 0,1 15.5,22.2H8.5A0.9,0.9 0 0,1 7.6,21.3A0.9,0.9 0 0,1 8.5,20.4H10V18.27C6.95,17.79 4.6,15.13 4.6,11.9A0.9,0.9 0 0,1 5.5,11A0.9,0.9 0 0,1 6.4,11.9C6.4,14.5 8.5,16.6 11.1,16.7H12.9C15.5,16.6 17.6,14.5 17.6,11.9A0.9,0.9 0 0,1 18.5,11M9.3,5.5H14.7V6.4H9.3V5.5M9.3,7.95H14.7V8.85H9.3V7.95M9.3,10.4H14.7V11.3H9.3V10.4Z"
												      Fill="{ThemeResource AccentFillColorDefaultBrush}"
												      Stroke="{ThemeResource TextFillColorPrimaryBrush}"
												      StrokeThickness="0" />

											</Grid>
										</Viewbox>
									</dev:Case>
									<dev:Case Value="Album">
										<Viewbox Width="20"
										         Height="20">
											<Grid>
												<Path Data="M 80,20 L 1320,20 A 60,60 0 0 1 1380,80 L 1380,1140 A 60,60 0 0 1 1320,1200 L 80,1200 A 60,60 0 0 1 20,1140 L 20,80 A 60,60 0 0 1 80,20 Z M 200,40 L 260,40 L 260,1010 A 30,30 0 0 1 200,1010 Z M 780,180 A 420,420 0 1 1 779.9,180 Z M 780,420 A 180,180 0 1 1 779.9,420 M 780,480 M 780,540 A 60,60 0 1 1 779.9,540"
												      Fill="{ThemeResource AccentFillColorDefaultBrush}"
												      Stroke="{ThemeResource TextFillColorPrimaryBrush}"
												      StrokeThickness="1" />
											</Grid>
										</Viewbox>

									</dev:Case>
									<dev:Case Value="Title">
										<Viewbox Width="20"
										         Height="20">
											<Grid>
												<Path Data="M11.5,3V16.15C11.05,15.95 10.55,15.85 10,15.85C8.41,15.85 7.15,17.16 7.15,19C7.15,20.84 8.41,22.15 10,22.15C11.59,22.15 12.85,20.84 12.85,19V7H19C19,5 17,3 14,3H11.5M2.2,9.5H3.4V14.5H2.2V9.5M4.4,7.5H5.6V16.5H4.4V7.5M6.6,8.5H7.8V15.5H6.6V8.5M8.8,9.5H10V14.5H8.8V9.5M15.6,8.5H16.8V15.5H15.6V8.5M17.8,7.5H19V16.5H17.8V7.5M20,9.5H21.2V14.5H20V9.5M22.2,10.5H23.4V13.5H22.2V10.5Z"
												      Fill="{ThemeResource AccentFillColorDefaultBrush}"
												      Stroke="{ThemeResource TextFillColorPrimaryBrush}"
												      StrokeThickness="0" />
											</Grid>
										</Viewbox>

									</dev:Case>
								</dev:SwitchPresenter>
								<TextBlock VerticalAlignment="Center"
								           Text="{Binding Value}"
								           TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</DataTemplate>
					</AutoSuggestBox.ItemTemplate>
				</AutoSuggestBox>
				<TitleBar.RightHeader>
					<Grid Margin="0,0,-50,0"
					      ColumnSpacing="5">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="100" />
						</Grid.ColumnDefinitions>
						<Button x:Name="ThemeButton"
						        Grid.Column="0"
						        Height="32"
						        Margin="0,0,4,0"
						        Click="ThemeButton_Click"
						        Content="{dev:FontIcon GlyphCode=E793,
						                               FontSize=16}"
						        Style="{ThemeResource SubtleButtonStyle}"
						        ToolTipService.ToolTip="Toggle Theme" />
						<Button x:Name="volumeMuteButton"
						        Grid.Column="1"
						        Click="VolumeMuteButton_Click"
						        Style="{ThemeResource SubtleButtonStyle}"
						        ToolTipService.ToolTip="Mute">
							<FontIcon x:Name="VolumeButtonGlyph"
							          Glyph="&#xE767;" />
						</Button>
						<Slider x:Name="VolumeSlider"
						        Grid.Column="2"
						        Height="32"
						        Maximum="100"
						        Value="0" />
					</Grid>
				</TitleBar.RightHeader>
			</TitleBar>

			<NavigationView x:Name="NavView"
			                Grid.Row="1"
			                IsBackButtonVisible="Collapsed"
			                IsBackEnabled="False"
			                IsPaneOpen="True"
			                IsPaneToggleButtonVisible="False"
			                ItemInvoked="NavView_ItemInvoked"
			                SelectionChanged="NavView_SelectionChanged">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="210" />
					</Grid.RowDefinitions>
					<Frame x:Name="NavFrame"
					       Grid.Row="0"
					       Margin="0,0,0,-75"
					       CacheSize="20" />
					<Frame x:Name="MusicControlsArea"
					       Grid.Row="1" />
				</Grid>
			</NavigationView>
		</Grid>
		<TeachingTip x:Name="SearchTeachingTip"
		             Title="Search tips"
		             Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
		             HeroContentPlacement="Bottom"
		             PreferredPlacement="RightBottom"
		             Target="{x:Bind SearchBox}">
			<TeachingTip.HeroContent>
				<Grid Margin="10"
				      HorizontalAlignment="Stretch"
				      VerticalAlignment="Stretch">
					<TextBlock x:Name="SearchTeachingTipContent"
					           LineHeight="20"
					           TextWrapping="Wrap">
					</TextBlock>
				</Grid>
			</TeachingTip.HeroContent>
		</TeachingTip>
		<Grid Width="Auto"
		      Height="Auto"
		      HorizontalAlignment="Center"
		      VerticalAlignment="Center">
			<ContentDialog x:Name="AddPlaylistDialog"
			               Title="Create New Playlist"
			               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
			               DefaultButton="Primary"
			               IsPrimaryButtonEnabled="False"
			               PrimaryButtonText="Create"
			               SecondaryButtonText="Cancel"
			               Visibility="Collapsed">
				<StackPanel Spacing="10">
					<TextBox x:Name="PlaylistNameBox"
					         Width="400"
					         PlaceholderText="Enter playlist name"
					         TextChanged="OnPlaylistNameChanged" />
					<TextBlock x:Name="ErrorMessage"
					           Foreground="Red"
					           Text=""
					           TextWrapping="WrapWholeWords" />
					<StackPanel Width="400"
					            Orientation="Horizontal"
					            Spacing="10">
						<TextBlock x:Name="AddPlaylistDialogDescription"
						           Width="290"
						           VerticalAlignment="Center"
						           TextWrapping="WrapWholeWords">
							<Run Text="You can also select an existing playlist file." />
							<LineBreak />
							<Run Text="Supported formats: M3U, M3U8, PLS, WPL, ZPL" />
						</TextBlock>
						<Button Width="100"
						        Click="BrowseButton_Click"
						        Content="Browse"
						        Style="{StaticResource AccentButtonStyle}" />
					</StackPanel>
				</StackPanel>
			</ContentDialog>
			<ContentDialog x:Name="SongInfo"
			               Title="Song/Track Information"
			               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
			               CloseButtonText="Close"
			               DefaultButton="Close"
			               PrimaryButtonText="Edit Details"
			               Visibility="Visible">
				<ContentDialog.Resources>
					<DataTemplate x:Key="LyricsTitleTemplate">
						<StackPanel VerticalAlignment="Center"
						            Orientation="Horizontal"
						            Spacing="10">
							<TextBlock Text="Song/Track Information" />
							<ContentControl Content="🎵 Has Lyrics"
							                Style="{StaticResource NewBadgeStyle}" />
						</StackPanel>
					</DataTemplate>

					<DataTemplate x:Key="SyncedLyricsTitleTemplate">
						<StackPanel VerticalAlignment="Center"
						            Orientation="Horizontal"
						            Spacing="10">
							<TextBlock Text="Song/Track Information" />
							<ContentControl Content="🎵 Has Synced Lyrics"
							                Style="{StaticResource NewBadgeStyle}" />
						</StackPanel>
					</DataTemplate>

					<DataTemplate x:Key="DefaultTitleTemplate">
						<TextBlock Text="Song/Track Information" />
					</DataTemplate>
				</ContentDialog.Resources>
				<Grid RowSpacing="10">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>
					<Grid Grid.Row="0"
					      ColumnSpacing="10">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="150" />
						</Grid.ColumnDefinitions>

						<Grid Grid.Column="0"
						      RowSpacing="10">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<Grid x:Name="TitleGrid"
							      Grid.Row="0"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Title:" />
								<TextBlock x:Name="SongTitle"
								           Grid.Row="1"
								           IsTextSelectionEnabled="True"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid x:Name="ArtistsGrid"
							      Grid.Row="1"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Artists:" />
								<TextBlock x:Name="SongArtists"
								           Grid.Row="1"
								           IsTextSelectionEnabled="True"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid x:Name="AlbumGrid"
							      Grid.Row="2"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Album:" />
								<TextBlock x:Name="SongAlbum"
								           Grid.Row="1"
								           IsTextSelectionEnabled="True"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
						</Grid>
						<Grid x:Name="CoverGrid"
						      Grid.Column="1"
						      Width="150"
						      Height="150"
						      HorizontalAlignment="Center"
						      VerticalAlignment="Center">
							<Grid Width="Auto"
							      Height="Auto"
							      HorizontalAlignment="Center"
							      VerticalAlignment="Center"
							      CornerRadius="10">
								<Image x:Name="SongCoverImage"
								       HorizontalAlignment="Center"
								       VerticalAlignment="Center" />
							</Grid>
						</Grid>

					</Grid>
					<Grid Grid.Row="1"
					      Width="Auto"
					      RowSpacing="10">
						<Grid.RowDefinitions>
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>
						<Grid Grid.Row="0"
						      RowSpacing="5">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<TextBlock Grid.Row="0"
							           FontWeight="ExtraBold"
							           Style="{ThemeResource BodyTextBlockStyle}"
							           Text="Genre:" />
							<TextBlock x:Name="SongGenre"
							           Grid.Row="1"
							           IsTextSelectionEnabled="True"
							           MaxLines="1"
							           Style="{ThemeResource BodyTextBlockStyle}"
							           TextTrimming="CharacterEllipsis" />
						</Grid>
						<Grid x:Name="OtherDetailsGrid"
						      Grid.Row="1"
						      ColumnSpacing="10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
							</Grid.ColumnDefinitions>
							<Grid Grid.Column="0"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Year:" />
								<TextBlock x:Name="SongYear"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid Grid.Column="1"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Duration:" />
								<TextBlock x:Name="SongDuration"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid Grid.Column="2"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Size:" />
								<TextBlock x:Name="SongSize"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid Grid.Column="3"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Added:" />
								<TextBlock x:Name="SongAdded"
								           Grid.Row="1"
								           MaxLines="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextTrimming="CharacterEllipsis" />
							</Grid>
						</Grid>
						<Grid x:Name="PathGrid"
						      Grid.Row="2"
						      RowSpacing="5">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>
							<TextBlock Grid.Row="0"
							           FontWeight="ExtraBold"
							           Style="{ThemeResource BodyTextBlockStyle}"
							           Text="Path:" />
							<Grid Grid.Row="1"
							      ColumnSpacing="5">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="50" />
								</Grid.ColumnDefinitions>
								<TextBlock x:Name="SongPath"
								           Grid.Column="0"
								           IsTextSelectionEnabled="True"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
								<Button x:Name="OpenContainingFolderButton"
								        Grid.Column="1"
								        Padding="-1"
								        HorizontalAlignment="Center"
								        VerticalAlignment="Center"
								        HorizontalContentAlignment="Center"
								        VerticalContentAlignment="Center"
								        Click="OpenContainingFolderButton_Click"
								        Style="{ThemeResource SubtleButtonStyle}"
								        ToolTipService.ToolTip="Open Containing Folder">
									<FontIcon Glyph="&#xE8DA;" />
								</Button>
							</Grid>
						</Grid>
						<Grid x:Name="CodecGrid"
						      Grid.Row="3"
						      ColumnSpacing="10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
							</Grid.ColumnDefinitions>
							<Grid Grid.Column="0"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Channel:" />
								<TextBlock x:Name="SongChannel"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid Grid.Column="1"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Bit rate:" />
								<TextBlock x:Name="SongBitrate"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid Grid.Column="2"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Sample rate:" />
								<TextBlock x:Name="SongSampleRate"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
							<Grid Grid.Column="3"
							      RowSpacing="5">
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Grid.Row="0"
								           FontWeight="ExtraBold"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           Text="Codec Description:" />
								<TextBlock x:Name="SongCodecDescription"
								           Grid.Row="1"
								           Style="{ThemeResource BodyTextBlockStyle}"
								           TextWrapping="WrapWholeWords" />
							</Grid>
						</Grid>
						<Grid x:Name="HistoryGrid"
						      Grid.Row="4"
						      ColumnSpacing="10">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="Auto" />
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="50" />
							</Grid.ColumnDefinitions>
							<Grid Grid.Column="0">
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Style="{ThemeResource BodyTextBlockStyle}">
									<Run FontWeight="ExtraBold"
									     Text="Played Count: " />
									<Run x:Name="SongPlayCount" />
								</TextBlock>
							</Grid>
							<Grid Grid.Column="1">
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Style="{ThemeResource BodyTextBlockStyle}">
									<Run FontWeight="ExtraBold"
									     Text="Last Played: " />
									<Run x:Name="SongLastPlayed" />
								</TextBlock>
							</Grid>
							<Button x:Name="ClearButton"
							        Grid.Column="2"
							        Padding="5"
							        HorizontalAlignment="Center"
							        VerticalAlignment="Center"
							        HorizontalContentAlignment="Center"
							        VerticalContentAlignment="Center"
							        Style="{ThemeResource SubtleButtonStyle}"
							        ToolTipService.ToolTip="Clear">
								<FontIcon Glyph="&#xE894;" />
								<Button.Flyout>
									<Flyout>
										<StackPanel Width="200"
										            Spacing="5">
											<TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
											           Text="Are you sure you want to clear Play count and Last Played Date-Time?"
											           TextWrapping="WrapWholeWords" />
											<Button Click="ClearButton_Click"
											        Content="Yes" />
										</StackPanel>
									</Flyout>
								</Button.Flyout>
							</Button>
						</Grid>
					</Grid>
				</Grid>
			</ContentDialog>

			<ContentDialog x:Name="EditSongInfo"
			               Title="Edit Song/Track Info"
			               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
			               CloseButtonText="Cancel"
			               DefaultButton="Primary"
			               IsPrimaryButtonEnabled="False"
			               PrimaryButtonText="Save">

				<ScrollViewer Width="550"
				              HorizontalAlignment="Stretch"
				              VerticalScrollBarVisibility="Visible">
					<StackPanel Width="530"
					            Margin="8"
					            HorizontalAlignment="Stretch"
					            Spacing="15">

						<StackPanel Spacing="4">
							<StackPanel Orientation="Horizontal"
							            Spacing="8">
								<TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
								           Text="Cover Art" />
								<ContentControl x:Name="CoverArtChanged"
								                Content="CHANGED"
								                Style="{StaticResource NewBadgeStyle}"
								                Visibility="Collapsed" />
							</StackPanel>
							<Border Height="300"
							        Margin="0,0,0,8"
							        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
							        BorderBrush="{ThemeResource CardBackgroundFillColorDefault}"
							        BorderThickness="1"
							        CornerRadius="6">
								<Grid>
									<StackPanel x:Name="CoverArtPlaceholder"
									            HorizontalAlignment="Center"
									            VerticalAlignment="Center"
									            Spacing="8">
										<FontIcon FontSize="36"
										          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
										          Glyph="&#xE8B9;" />
										<TextBlock HorizontalAlignment="Center"
										           FontSize="12"
										           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
										           Text="No artwork" />
									</StackPanel>
									<Image x:Name="CoverArtImage"
									       Margin="6"
									       Stretch="Fill"
									       Visibility="Collapsed" />
								</Grid>
							</Border>
							<Grid ColumnSpacing="10">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Button x:Name="BrowseCoverArtButton"
								        Grid.Column="0"
								        HorizontalAlignment="Stretch"
								        Click="BrowseCoverArtButton_Click"
								        Content="Browse new Cover art" />
								<Button x:Name="RemoveCoverArtButton"
								        Grid.Column="1"
								        HorizontalAlignment="Stretch"
								        Click="RemoveCoverArtButton_Click"
								        Content="Remove Cover art" />
							</Grid>
						</StackPanel>

						<StackPanel Spacing="4">
							<StackPanel Orientation="Horizontal"
							            Spacing="8">
								<TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
								           Text="Title" />
								<ContentControl x:Name="TitleChanged"
								                Content="CHANGED"
								                Style="{StaticResource NewBadgeStyle}"
								                Visibility="Collapsed" />
							</StackPanel>
							<TextBox x:Name="TitleTextBox"
							         PlaceholderText="Enter title"
							         TextChanged="TitleTextBox_TextChanged"
							         TextWrapping="Wrap" />
						</StackPanel>

						<StackPanel Spacing="4">
							<StackPanel Orientation="Horizontal"
							            Spacing="8">
								<TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
								           Text="Artist(s)" />
								<ContentControl x:Name="ArtistChanged"
								                Content="CHANGED"
								                Style="{StaticResource NewBadgeStyle}"
								                Visibility="Collapsed" />
							</StackPanel>
							<controls:InlineSuggestBox x:Name="ArtistTextBox"
							                           CaseSensitiveSuggestion="False"
							                           GotFocus="ArtistTextBox_GotFocus"
							                           LostFocus="ArtistTextBox_LostFocus"
							                           MultiSuggestEnabled="True"
							                           PlaceholderText="Enter Artist Name(s)"
							                           SplitRules="{x:Bind ArtistSplitRules}"
							                           SuggestionSource="{x:Bind ArtistSuggestions}"
							                           SuggestionSuffix=" [Press →]"
							                           TextChanged="ArtistTextBox_TextChanged"
							                           TextWrapping="Wrap" />

							<TeachingTip x:Name="ArtistTeachingTip"
							             Title="Inline auto-suggestion for existing albums."
							             Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
							             BackgroundSizing="InnerBorderEdge"
							             HeroContentPlacement="Bottom"
							             Target="{x:Bind ArtistTextBox}">
								<TeachingTip.HeroContent>
									<StackPanel Margin="10"
									            HorizontalAlignment="Stretch"
									            VerticalAlignment="Stretch">
										<TextBlock Name="ArtistTeachingTipContent"
										           TextWrapping="Wrap" />
										<Grid x:Name="DelimitersGrid">
											<Grid.ColumnDefinitions>
												<ColumnDefinition Width="70" />
												<ColumnDefinition Width="70" />
											</Grid.ColumnDefinitions>
										</Grid>
									</StackPanel>
								</TeachingTip.HeroContent>
							</TeachingTip>

						</StackPanel>

						<StackPanel Spacing="4">
							<StackPanel Orientation="Horizontal"
							            Spacing="8">
								<TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
								           Text="Album" />
								<ContentControl x:Name="AlbumChanged"
								                Content="CHANGED"
								                Style="{StaticResource NewBadgeStyle}"
								                Visibility="Collapsed" />
							</StackPanel>

							<controls:InlineSuggestBox x:Name="AlbumTextBox"
							                           CaseSensitiveSuggestion="False"
							                           GotFocus="AlbumTextBox_GotFocus"
							                           LostFocus="AlbumTextBox_LostFocus"
							                           PlaceholderText="Enter Album Name"
							                           SuggestionSource="{x:Bind AlbumSuggestions}"
							                           SuggestionSuffix=" [Press →]"
							                           TextChanged="AlbumTextBox_TextChanged"
							                           TextWrapping="Wrap" />
							<TeachingTip x:Name="AlbumTeachingTip"
							             Title="Inline auto-suggestion for existing albums."
							             Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
							             BackgroundSizing="InnerBorderEdge"
							             HeroContentPlacement="Bottom"
							             Target="{x:Bind AlbumTextBox}">
								<TeachingTip.HeroContent>
									<Grid Margin="10"
									      HorizontalAlignment="Stretch"
									      VerticalAlignment="Stretch">
										<TextBlock x:Name="AlbumTeachingTipContent"
										           TextWrapping="Wrap">
										</TextBlock>
									</Grid>
								</TeachingTip.HeroContent>
							</TeachingTip>
						</StackPanel>

						<Grid ColumnSpacing="8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*" />
								<ColumnDefinition Width="160" />
							</Grid.ColumnDefinitions>

							<StackPanel Grid.Column="0"
							            Spacing="4">
								<StackPanel Orientation="Horizontal"
								            Spacing="8">
									<TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
									           Text="Genre" />
									<ContentControl x:Name="GenreChanged"
									                Content="CHANGED"
									                Style="{StaticResource NewBadgeStyle}"
									                Visibility="Collapsed" />
								</StackPanel>
								<controls:InlineSuggestBox x:Name="GenreAutoSuggestBox"
								                           CaseSensitiveSuggestion="False"
								                           GotFocus="GenreAutoSuggestBox_GotFocus"
								                           LostFocus="GenreAutoSuggestBox_LostFocus"
								                           PlaceholderText="Enter genre"
								                           SuggestionSource="{x:Bind GenreSuggestions}"
								                           SuggestionSuffix=" [Press →]"
								                           TextChanged="GenreAutoSuggestBox_TextChanged"
								                           TextWrapping="Wrap" />
								<TeachingTip x:Name="GenreTeachingTip"
								             Title="Inline auto-suggestion for existing genres."
								             Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
								             BackgroundSizing="InnerBorderEdge"
								             HeroContentPlacement="Bottom"
								             Target="{x:Bind GenreAutoSuggestBox}">
									<TeachingTip.HeroContent>
										<Grid Margin="10"
										      HorizontalAlignment="Stretch"
										      VerticalAlignment="Stretch">
											<TextBlock x:Name="GenreTeachingTipContent"
											           TextWrapping="Wrap">
											</TextBlock>
										</Grid>
									</TeachingTip.HeroContent>
								</TeachingTip>
							</StackPanel>

							<StackPanel Grid.Column="1"
							            Spacing="4">
								<StackPanel Orientation="Horizontal"
								            Spacing="8">
									<TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
									           Text="Year" />
									<ContentControl x:Name="YearChanged"
									                Content="CHANGED"
									                Style="{StaticResource NewBadgeStyle}"
									                Visibility="Collapsed" />
								</StackPanel>
								<TextBox x:Name="YearNumberBox"
								         MaxLength="4"
								         PlaceholderText="Enter Year"
								         TextChanged="YearNumberBox_TextChanged" />
							</StackPanel>
						</Grid>

						<Grid Height="400"
						      RowSpacing="4">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
							</Grid.RowDefinitions>
							<StackPanel Orientation="Horizontal"
							            Spacing="8">
								<TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
								           Text="Lyrics" />
								<ContentControl x:Name="LyricsChanged"
								                Content="CHANGED"
								                Style="{StaticResource NewBadgeStyle}"
								                Visibility="Collapsed" />
							</StackPanel>
							<TextBox x:Name="LyricsTextBox"
							         Grid.Row="1"
							         AcceptsReturn="True"
							         AutomationProperties.Name="multi-line TextBox"
							         IsSpellCheckEnabled="True"
							         PlaceholderText="Enter Lyrics"
							         TextChanged="LyricsTextBox_TextChanged"
							         TextWrapping="Wrap" />
						</Grid>

					</StackPanel>
				</ScrollViewer>
				<ContentDialog.Resources>
					<x:Double x:Key="ContentDialogMaxWidth">600</x:Double>
					<x:Double x:Key="ContentDialogMinWidth">550</x:Double>
				</ContentDialog.Resources>
			</ContentDialog>
		</Grid>
	</Grid>
</Page>
