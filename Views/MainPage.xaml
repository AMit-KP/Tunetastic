<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Tunetastic.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:Tunetastic.Common"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:Tunetastic"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="using:Microsoft.UI.Xaml"
      ActualThemeChanged="Page_ActualThemeChanged"
      Loaded="Page_Loaded"
      mc:Ignorable="d">

	<Grid>
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition />
			</Grid.RowDefinitions>

			<TitleBar x:Name="AppTitleBar"
			          IsBackButtonVisible="True"
			          IsPaneToggleButtonVisible="True">
				<TitleBar.LeftHeader>
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<ImageIcon x:Name="AppIcon"
						           Grid.Column="0"
						           Width="30"
						           Height="30"
						           Margin="5,0,10,0"
						           HorizontalAlignment="Center"
						           VerticalAlignment="Stretch"
						           Source="ms-appx:///Assets/AppIcon.png" />
						<dev:TextBlockStrokeView x:Name="AppTitle"
						                         Grid.Column="1"
						                         VerticalAlignment="Center"
						                         Animate="False"
						                         StrokeThickness="0">
							<TextBlock Margin="0,0,0,0"
							           VerticalAlignment="Center"
							           FontWeight="ExtraBold"
							           Style="{ThemeResource SubtitleTextBlockStyle}"
							           Text="Tunetastic" />
						</dev:TextBlockStrokeView>
					</Grid>
				</TitleBar.LeftHeader>
				<AutoSuggestBox x:Name="SearchBox"
				                MinWidth="320"
				                VerticalAlignment="Center"
				                PlaceholderText="Quick Search"
				                QueryIcon="Find"
				                QuerySubmitted="OnQuerySubmitted"
				                SuggestionChosen="SearchBox_SuggestionChosen"
				                TextChanged="OnTextChanged">
					<AutoSuggestBox.ItemTemplate>
						<DataTemplate>
							<StackPanel Orientation="Horizontal"
							            Spacing="8">
								<dev:SwitchPresenter TargetType="common:SearchItemType"
								                     Value="{Binding Key, Mode=OneWay}">
									<dev:Case Value="Artist">
										<FontIcon VerticalAlignment="Center"
										          FontFamily="Segoe MDL2 Assets"
										          Glyph="&#xE77B;" />
									</dev:Case>
									<dev:Case Value="Album">
										<FontIcon VerticalAlignment="Center"
										          FontFamily="Segoe MDL2 Assets"
										          Glyph="&#xE93C;" />
									</dev:Case>
									<dev:Case Value="Title">
										<FontIcon VerticalAlignment="Center"
										          FontFamily="Segoe MDL2 Assets"
										          Glyph="&#xE8D6;" />
									</dev:Case>
								</dev:SwitchPresenter>
								<TextBlock VerticalAlignment="Center"
								           Text="{Binding Value}"
								           TextTrimming="CharacterEllipsis" />
							</StackPanel>
						</DataTemplate>
					</AutoSuggestBox.ItemTemplate>
				</AutoSuggestBox>
				<TitleBar.RightHeader>
					<Button x:Name="ThemeButton"
					        Height="32"
					        Margin="0,0,4,0"
					        Click="ThemeButton_Click"
					        Content="{dev:FontIcon GlyphCode=E793,
					                               FontSize=16}"
					        Style="{ThemeResource SubtleButtonStyle}"
					        ToolTipService.ToolTip="Toggle Theme" />
				</TitleBar.RightHeader>
			</TitleBar>

			<NavigationView x:Name="NavView"
			                Grid.Row="1"
			                IsBackButtonVisible="Collapsed"
			                IsBackEnabled="False"
			                IsPaneOpen="True"
			                IsPaneToggleButtonVisible="False"
			                ItemInvoked="NavView_ItemInvoked"
			                SelectionChanged="NavView_SelectionChanged">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
						<RowDefinition Height="210" />
					</Grid.RowDefinitions>
					<Frame x:Name="NavFrame"
					       Grid.Row="0"
					       Margin="0,0,0,-75" />
					<Frame x:Name="MusicControlsArea"
					       Grid.Row="1" />
				</Grid>
			</NavigationView>
		</Grid>
		<Grid Width="Auto"
		      Height="Auto"
		      HorizontalAlignment="Center"
		      VerticalAlignment="Center">
			<ContentDialog x:Name="AddPlaylistDialog"
			               Title="Create New Playlist"
			               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
			               DefaultButton="Primary"
			               IsPrimaryButtonEnabled="False"
			               PrimaryButtonText="Create"
			               SecondaryButtonText="Cancel"
			               Visibility="Collapsed">
				<StackPanel Spacing="10">
					<TextBox x:Name="PlaylistNameBox"
					         Width="400"
					         PlaceholderText="Enter playlist name"
					         TextChanged="OnPlaylistNameChanged" />
					<TextBlock x:Name="ErrorMessage"
					           Foreground="Red"
					           Text=""
					           TextWrapping="WrapWholeWords" />
					<StackPanel Width="400"
					            Orientation="Horizontal"
					            Spacing="10">
						<TextBlock x:Name="AddPlaylistDialogDescription"
						           Width="290"
						           VerticalAlignment="Center"
						           TextWrapping="WrapWholeWords">
							<Run Text="You can also select an existing playlist file." />
							<LineBreak />
							<Run Text="Supported formats: M3U, M3U8, PLS, WPL, ZPL" />
						</TextBlock>
						<Button Width="100"
						        Click="BrowseButton_Click"
						        Content="Browse"
						        Style="{StaticResource AccentButtonStyle}" />
					</StackPanel>
				</StackPanel>
			</ContentDialog>
		</Grid>
	</Grid>
</Page>
