<?xml version="1.0" encoding="utf-8" ?>
<views:SongListPageBase x:Class="Tunetastic.Views.PlaylistViews.PlayListTemplate"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:services="using:Tunetastic.Common.Services"
                        xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
                        xmlns:common="using:Tunetastic.Common"
                        xmlns:controls="using:CommunityToolkit.WinUI.Controls"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:dev="using:DevWinUI"
                        xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:views="using:Tunetastic.Views.Common"
                        x:Name="PlayListTemplatePage"
                        Loaded="Page_Loaded"
                        mc:Ignorable="d">

	<views:SongListPageBase.Resources>
		<MenuFlyout x:Key="RightClickMenu"
		            Opened="MenuFlyout_Opened">
			<MenuFlyoutItem x:Uid="Action_Play" Click="MenuFlyoutItemPlay_OnClick"
			                Text="{services:Loc Key=Action_Play.Text}"
			                ToolTipService.ToolTip="{services:Loc Key=Action_Play_ToolTip}">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE768;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutSubItem x:Name="AddToPlaylist" x:Uid="Action_AddToPlaylist"
			                   Text="{services:Loc Key=Action_AddToPlaylist.Text}">
				<MenuFlyoutSubItem.Icon>
					<FontIcon Glyph="&#xE728;" />
				</MenuFlyoutSubItem.Icon>
			</MenuFlyoutSubItem>
			<MenuFlyoutItem x:Uid="Action_AddToQueue" Click="MenuFlyoutItemAddToQueue_OnClick"
			                Text="{services:Loc Key=Action_AddToQueue.Text}"
			                ToolTipService.ToolTip="{services:Loc Key=Action_AddToQueue_ToolTip}">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE84F;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutSubItem Tag="Move" x:Uid="PlayList_MoveSubItem" Text="{services:Loc Key=PlayList_MoveSubItem.Text}">
				<MenuFlyoutSubItem.Icon>
					<FontIcon Glyph="&#xE7C2;" />
				</MenuFlyoutSubItem.Icon>
				<MenuFlyoutItem x:Uid="PlayList_MoveToTop" Click="MoveToTop_Click"
				                Text="{services:Loc Key=PlayList_MoveToTop.Text}"
				                ToolTipService.ToolTip="{services:Loc Key=PlayList_MoveToTop_ToolTip}">
					<MenuFlyoutItem.Icon>
						<FontIcon Glyph="&#xE898;" />
					</MenuFlyoutItem.Icon>
				</MenuFlyoutItem>
				<MenuFlyoutItem x:Uid="PlayList_MoveUp" Click="MoveUp_Click"
				                Text="{services:Loc Key=PlayList_MoveUp.Text}"
				                ToolTipService.ToolTip="{services:Loc Key=PlayList_MoveUp_ToolTip}">
					<MenuFlyoutItem.Icon>
						<FontIcon Glyph="&#xE74A;" />
					</MenuFlyoutItem.Icon>
				</MenuFlyoutItem>
				<MenuFlyoutItem x:Uid="PlayList_MoveDown" Click="MoveDown_Click"
				                Text="{services:Loc Key=PlayList_MoveDown.Text}"
				                ToolTipService.ToolTip="{services:Loc Key=PlayList_MoveDown_ToolTip}">
					<MenuFlyoutItem.Icon>
						<FontIcon Glyph="&#xE74B;" />
					</MenuFlyoutItem.Icon>
				</MenuFlyoutItem>
				<MenuFlyoutItem x:Uid="PlayList_MoveToBottom" Click="MoveToBottom_Click"
				                Text="{services:Loc Key=PlayList_MoveToBottom.Text}"
				                ToolTipService.ToolTip="{services:Loc Key=PlayList_MoveToBottom_ToolTip}">
					<MenuFlyoutItem.Icon>
						<FontIcon Glyph="&#xE896;" />
					</MenuFlyoutItem.Icon>
				</MenuFlyoutItem>
			</MenuFlyoutSubItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutItem x:Uid="Action_InfoTag" Click="MenuFlyoutItemInfoTag_OnClick"
			                Text="{services:Loc Key=Action_InfoTag.Text}">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE946;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutItem x:Uid="PlayList_RemoveTrack" Click="MenuFlyoutItemRemove_OnClick"
			                Text="{services:Loc Key=PlayList_RemoveTrack.Text}"
			                ToolTipService.ToolTip="{services:Loc Key=PlayList_RemoveTrack_ToolTip}">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xECC9;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutItem x:Uid="Action_DeleteTrack" Click="MenuFlyoutItemDelete_OnClick"
			                Text="{services:Loc Key=Action_DeleteTrack.Text}"
			                ToolTipService.ToolTip="{services:Loc Key=Action_DeleteTrack_ToolTip}">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE74D;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
		</MenuFlyout>
	</views:SongListPageBase.Resources>

	<Grid Margin="10,10,10,-10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid Grid.Row="0"
		      Margin="15,10,45,10"
		      ColumnSpacing="15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<dev:AutoScrollView IsPlaying="True"
			                    ScrollingPixelsPreSecond="20">
				<TextBlock x:Name="PlaylistHeader"
				           Grid.Column="0"
				           HorizontalAlignment="Left"
				           Style="{ThemeResource TitleTextBlockStyle}" />
			</dev:AutoScrollView>

			<StackPanel x:Name="PageButtons"
			            Grid.Column="1"
			            HorizontalAlignment="Right"
			            Orientation="Horizontal"
			            Spacing="15">
				<ToggleButton x:Name="ReorderButton" x:Uid="PlayList_ReorderButton"
				              Click="ReorderButton_Click"
				              ToolTipService.ToolTip="{services:Loc Key=PlayList_ReorderButton_ToolTip}">
					<FontIcon Glyph="&#xE70F;" />
				</ToggleButton>
				<ToggleButton x:Name="MultiSelectButton" x:Uid="ActionBar_MultiSelect"
				              Click="MultiSelectButton_Click"
				              ToolTipService.ToolTip="{services:Loc Key=ActionBar_MultiSelect_ToolTip}">
					<FontIcon Glyph="&#xE73A;" />
				</ToggleButton>
				<StackPanel x:Name="PlayAllButtonStackPanel"
				            Orientation="Horizontal"
				            Spacing="5">
					<Button x:Name="ShuffleAndPlay" x:Uid="ActionBar_ShuffleAndPlay"
					        HorizontalAlignment="Right"
					        Click="ShuffleAndPlayButton_OnClick"
					        ToolTipService.ToolTip="{services:Loc Key=ActionBar_ShuffleAndPlay_ToolTip}">
						<FontIcon Glyph="&#xE8B1;" />
					</Button>
					<Button x:Name="PlayAll" x:Uid="ActionBar_PlayAll"
					        HorizontalAlignment="Right"
					        Click="PlayAllButton_OnClick"
					        ToolTipService.ToolTip="{services:Loc Key=ActionBar_PlayAll_ToolTip}">
						<FontIcon Glyph="&#xF5B0;" />
					</Button>
				</StackPanel>
				<DropDownButton x:Name="ViewButton"
				                HorizontalAlignment="Right">
					<DropDownButton.Flyout>
						<MenuFlyout x:Name="ViewStyle"
						            Placement="BottomEdgeAlignedRight">
							<RadioMenuFlyoutItem x:Name="ListViewStyle"
							                     Click="ViewButton_OnClick"
							                     GroupName="View"
							                     Tag="List View" x:Uid="ViewStyle_List" Text="{services:Loc Key=ViewStyle_List.Text}">
								<RadioMenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE8FD;" />
								</RadioMenuFlyoutItem.Icon>
							</RadioMenuFlyoutItem>
							<RadioMenuFlyoutItem x:Name="CompactViewStyle"
							                     Click="ViewButton_OnClick"
							                     GroupName="View"
							                     Tag="Compact View" x:Uid="ViewStyle_Compact" Text="{services:Loc Key=ViewStyle_Compact.Text}">
								<RadioMenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE71D;" />
								</RadioMenuFlyoutItem.Icon>
							</RadioMenuFlyoutItem>
						</MenuFlyout>
					</DropDownButton.Flyout>
				</DropDownButton>
				<Button x:Name="SettingsButton" x:Uid="PlayList_SettingsButton"
				        ToolTipService.ToolTip="{services:Loc Key=PlayList_SettingsButton_ToolTip}">
					<FontIcon Glyph="&#xE713;" />
					<Button.Flyout>
						<MenuFlyout x:Name="Settings"
						            Placement="BottomEdgeAlignedRight">
							<MenuFlyoutSubItem x:Name="SortPlayList" x:Uid="PlayList_SortPlaylist"
							                   Text="{services:Loc Key=PlayList_SortPlaylist.Text}">
								<MenuFlyoutSubItem.Icon>
									<FontIcon Glyph="&#xE8CB;" />
								</MenuFlyoutSubItem.Icon>
								<MenuFlyoutSubItem x:Uid="PlayList_Sort_Title" Text="{services:Loc Key=PlayList_Sort_Title.Text}">
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="TitleAsc"
									                Text="{services:Loc Key=Sort_Ascending.Text}" />
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="TitleDesc"
									                Text="{services:Loc Key=Sort_Descending.Text}" />
								</MenuFlyoutSubItem>
								<MenuFlyoutSubItem x:Uid="PlayList_Sort_Artists" Text="{services:Loc Key=PlayList_Sort_Artists.Text}">
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="ArtistsAsc"
									                Text="{services:Loc Key=Sort_Ascending.Text}" />
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="ArtistsDesc"
									                Text="{services:Loc Key=Sort_Descending.Text}" />
								</MenuFlyoutSubItem>
								<MenuFlyoutSubItem x:Uid="PlayList_Sort_Album" Text="{services:Loc Key=PlayList_Sort_Album.Text}">
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="AlbumAsc"
									                Text="{services:Loc Key=Sort_Ascending.Text}" />
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="AlbumDesc"
									                Text="{services:Loc Key=Sort_Descending.Text}" />
								</MenuFlyoutSubItem>
								<MenuFlyoutSubItem x:Uid="PlayList_Sort_Year" Text="{services:Loc Key=PlayList_Sort_Year.Text}">
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="YearAsc"
									                Text="{services:Loc Key=Sort_Ascending.Text}" />
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="YearDesc"
									                Text="{services:Loc Key=Sort_Descending.Text}" />
								</MenuFlyoutSubItem>
								<MenuFlyoutSubItem x:Uid="PlayList_Sort_Duration" Text="{services:Loc Key=PlayList_Sort_Duration.Text}">
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="DurationAsc"
									                Text="{services:Loc Key=Sort_Ascending.Text}" />
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="DurationDesc"
									                Text="{services:Loc Key=Sort_Descending.Text}" />
								</MenuFlyoutSubItem>
								<MenuFlyoutSubItem x:Uid="PlayList_Sort_Track" Text="{services:Loc Key=PlayList_Sort_Track.Text}">
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="TrackAsc"
									                Text="{services:Loc Key=Sort_Ascending.Text}" />
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="TrackDesc"
									                Text="{services:Loc Key=Sort_Descending.Text}" />
								</MenuFlyoutSubItem>
								<MenuFlyoutSubItem x:Uid="PlayList_Sort_PlayCount" Text="{services:Loc Key=PlayList_Sort_PlayCount.Text}">
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="PlayCountAsc"
									                Text="{services:Loc Key=Sort_Ascending.Text}" />
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="PlayCountDesc"
									                Text="{services:Loc Key=Sort_Descending.Text}" />
								</MenuFlyoutSubItem>
								<MenuFlyoutSubItem x:Uid="PlayList_Sort_ModifiedTime" Text="{services:Loc Key=PlayList_Sort_ModifiedTime.Text}">
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="ModifiedTimeAsc"
									                Text="{services:Loc Key=Sort_Ascending.Text}" />
									<MenuFlyoutItem Click="SortPlayList_Click"
									                Tag="ModifiedTimeDesc"
									                Text="{services:Loc Key=Sort_Descending.Text}" />
								</MenuFlyoutSubItem>
							</MenuFlyoutSubItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Click="RenamePlayList_Click"
							                x:Uid="PlayList_RenamePlaylist" Text="{services:Loc Key=PlayList_RenamePlaylist.Text}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE8AC;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutItem x:Name="ExportPlayList"
							                Click="ExportPlayList_Click"
							                x:Uid="PlayList_ExportPlaylist" Text="{services:Loc Key=PlayList_ExportPlaylist.Text}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xEDE1;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem x:Uid="PlayList_DeletePlaylist" Click="DeletePlayList_Click"
							                Text="{services:Loc Key=PlayList_DeletePlaylist.Text}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE74D;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
				<Button x:Name="MoreButton"
				        Visibility="Collapsed">
					<FontIcon Glyph="&#xE712;" />
					<Button.Flyout>
						<MenuFlyout x:Name="More"
						            Opened="MenuFlyout_Opened"
						            Placement="BottomEdgeAlignedRight">
							<MenuFlyoutSubItem x:Uid="ActionBar_Multi_AddToPlaylist" Text="{services:Loc Key=ActionBar_Multi_AddToPlaylist.Text}">
								<MenuFlyoutSubItem.Icon>
									<FontIcon Glyph="&#xE728;" />
								</MenuFlyoutSubItem.Icon>
							</MenuFlyoutSubItem>
							<MenuFlyoutItem x:Uid="ActionBar_Multi_AddToQueue" Click="MenuFlyoutMultiItemAddToQueue_OnClick"
							                Text="{services:Loc Key=ActionBar_Multi_AddToQueue.Text}"
							                ToolTipService.ToolTip="{services:Loc Key=ActionBar_Multi_AddToQueue_ToolTip}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE84F;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutSubItem Tag="Move" x:Uid="PlayList_MoveSubItem" Text="{services:Loc Key=PlayList_MoveSubItem.Text}">
								<MenuFlyoutSubItem.Icon>
									<FontIcon Glyph="&#xE7C2;" />
								</MenuFlyoutSubItem.Icon>
								<MenuFlyoutItem x:Uid="PlayList_MultiMoveToTop" Click="MoveMultiToTop_Click"
								                Text="{services:Loc Key=PlayList_MultiMoveToTop.Text}"
								                ToolTipService.ToolTip="{services:Loc Key=PlayList_MultiMoveToTop_ToolTip}">
									<MenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE898;" />
									</MenuFlyoutItem.Icon>
								</MenuFlyoutItem>
								<MenuFlyoutItem x:Uid="PlayList_MultiMoveUp" Click="MoveMultiUp_Click"
								                Text="{services:Loc Key=PlayList_MultiMoveUp.Text}"
								                ToolTipService.ToolTip="{services:Loc Key=PlayList_MultiMoveUp_ToolTip}">
									<MenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE74A;" />
									</MenuFlyoutItem.Icon>
								</MenuFlyoutItem>
								<MenuFlyoutItem x:Uid="PlayList_MultiMoveDown" Click="MoveMultiDown_Click"
								                Text="{services:Loc Key=PlayList_MultiMoveDown.Text}"
								                ToolTipService.ToolTip="{services:Loc Key=PlayList_MultiMoveDown_ToolTip}">
									<MenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE74B;" />
									</MenuFlyoutItem.Icon>
								</MenuFlyoutItem>
								<MenuFlyoutItem x:Uid="PlayList_MultiMoveToBottom" Click="MoveMultiToBottom_Click"
								                Text="{services:Loc Key=PlayList_MultiMoveToBottom.Text}"
								                ToolTipService.ToolTip="{services:Loc Key=PlayList_MultiMoveToBottom_ToolTip}">
									<MenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE896;" />
									</MenuFlyoutItem.Icon>
								</MenuFlyoutItem>
							</MenuFlyoutSubItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem x:Uid="PlayList_MultiRemoveTrack" Click="MenuFlyoutMultiItemRemove_OnClick"
							                Text="{services:Loc Key=PlayList_MultiRemoveTrack.Text}"
							                ToolTipService.ToolTip="{services:Loc Key=PlayList_MultiRemoveTrack_ToolTip}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xECC9;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutItem x:Uid="ActionBar_Multi_Delete" Click="MenuFlyoutMultiItemDelete_OnClick"
							                Text="{services:Loc Key=ActionBar_Multi_Delete.Text}"
							                ToolTipService.ToolTip="{services:Loc Key=ActionBar_Multi_Delete_ToolTip}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE74D;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</StackPanel>
		</Grid>
		<Grid Grid.Row="1">
			<StackPanel x:Name="GoToSettings"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            ToolTipService.ToolTip="{services:Loc Key=EmptyState_NoSongs.Text}"
			            Visibility="Visible">
				<TextBlock x:Name="GoToSettingsTextBlock"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           HorizontalTextAlignment="Center"
				           Style="{ThemeResource SubtitleTextBlockStyle}"
				           TextAlignment="Center"
				           TextWrapping="WrapWholeWords" />
				<Button x:Uid="EmptyState_OpenSettings" HorizontalAlignment="Center" VerticalAlignment="Center" Click="GotoSettigsButton_Click" Content="Open Settings" />
			</StackPanel>
			<Grid x:Name="NoResultsGrid"
			      HorizontalAlignment="Center"
			      VerticalAlignment="Center"
			      ToolTipService.ToolTip="{services:Loc Key=EmptyState_PlaylistEmpty.Text}"
			      Visibility="Collapsed">
				<TextBlock x:Name="NoResultsTextBlock"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           HorizontalTextAlignment="Center"
				           Style="{ThemeResource SubtitleTextBlockStyle}"
				           TextAlignment="Center"
				           TextTrimming="CharacterEllipsis"
				           TextWrapping="WrapWholeWords">
				</TextBlock>
			</Grid>
			<StackPanel x:Name="LoadingProgress"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            Visibility="Collapsed">
				<dev:LoadingIndicator Mode="Arcs" />
				<Grid x:Name="CustomProgressBar"
				      Width="400"
				      Height="50"
				      Background="{ThemeResource AccentAAFillColorDisabled}"
				      BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
				      BorderThickness="2"
				      CornerRadius="5">
					<Rectangle x:Name="ProgressFill"
					           Height="50"
					           HorizontalAlignment="Left"
					           Fill="{ThemeResource AccentAAFillColorDefaultBrush}" />
					<Grid>
						<TextBlock x:Name="ProgressFillText"
						           HorizontalAlignment="Center"
						           VerticalAlignment="Center"
						           Style="{ThemeResource BodyStrongTextBlockStyle}" />
					</Grid>
				</Grid>
			</StackPanel>
			<Grid Width="Auto"
			      Height="Auto"
			      HorizontalAlignment="Center"
			      VerticalAlignment="Center">
				<ContentDialog x:Name="DeleteDialog" x:Uid="DeleteDialog_ConfirmDialog"
				               Title="Confirm Deletion"
				               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
				               DefaultButton="Secondary"
				               PrimaryButtonText="Delete"
				               SecondaryButtonText="Cancel"
				               Visibility="Collapsed">
					<StackPanel Spacing="10">
						<TextBlock x:Name="DeleteDialogText"
						           Style="{ThemeResource BodyTextBlockStyle}"
						           TextWrapping="WrapWholeWords" />
						<TextBlock x:Uid="DeleteDialog_UndoneWarning" Foreground="Red" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="This action cannot be undone."
						           TextWrapping="WrapWholeWords" />
					</StackPanel>
				</ContentDialog>
			</Grid>
			<Grid Width="Auto"
			      Height="Auto"
			      HorizontalAlignment="Center"
			      VerticalAlignment="Center">
				<ContentDialog x:Name="ExportDialog" x:Uid="ExportDialog_Window"
				               Title="Export"
				               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
				               DefaultButton="Primary"
				               PrimaryButtonText="Export"
				               SecondaryButtonText="Cancel"
				               Visibility="Visible">
					<StackPanel Orientation="Vertical"
					            Spacing="10">
						<TextBlock x:Uid="ExportDialog_Notice" Text="The playlist will be exported as choosen format and saved to Downloads folder."
						           TextWrapping="WrapWholeWords" />
						<StackPanel Orientation="Horizontal"
						            Spacing="10">
							<TextBox x:Name="ExportTextBox"
							         x:Uid="ExportDialog_TextBox"
							         Width="380"
							         PlaceholderText="Enter Playlist file name"
							         TextChanged="OnPlaylistExportNameChanged" />
							<ComboBox x:Name="ExportFormat"
							          Width="100"
							          SelectedIndex="0">
								<ComboBoxItem x:Uid="ExportFormat_M3U8" Content="M3U8"
								              ToolTipService.ToolTip="M3U UTF-8" />
								<ComboBoxItem x:Uid="ExportFormat_M3U" Content="M3U"
								              ToolTipService.ToolTip="MP3 URL" />
								<ComboBoxItem x:Uid="ExportFormat_PLS" Content="PLS"
								              ToolTipService.ToolTip="Playlist File" />
								<ComboBoxItem x:Uid="ExportFormat_WPL" Content="WPL"
								              ToolTipService.ToolTip="Windows Media Player Playlist" />
								<ComboBoxItem x:Uid="ExportFormat_ZPL" Content="ZPL"
								              ToolTipService.ToolTip="Zune Playlist" />
							</ComboBox>
						</StackPanel>
						<TextBlock x:Name="ExportErrorMessage"
						           Foreground="Red"
						           Text=""
						           TextWrapping="WrapWholeWords" />
					</StackPanel>
				</ContentDialog>
			</Grid>
			<Grid Width="Auto"
			      Height="Auto"
			      HorizontalAlignment="Center"
			      VerticalAlignment="Center">
				<ContentDialog x:Name="RenamePlaylistDialog"
				               x:Uid="RenamePlaylistDialog"
				               Title="Rename Playlist"
				               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
				               DefaultButton="Primary"
				               IsPrimaryButtonEnabled="False"
				               PrimaryButtonText="Rename"
				               SecondaryButtonText="Cancel"
				               Visibility="Collapsed">
					<StackPanel>
						<TextBox x:Name="PlaylistNameBox"
						         x:Uid="RenamePlaylistDialog_NameBox"
						         PlaceholderText="Enter new playlist name"
						         TextChanged="OnPlaylistNameChanged" />
						<TextBlock x:Name="ErrorMessage"
						           Foreground="Red" />
					</StackPanel>
				</ContentDialog>
			</Grid>
			<Grid x:Name="PlayListSongsListViewGrid">
				<ListView x:Name="PlayListSongsListView"
				          Margin="10,10,10,10"
				          Padding="0,0,35,0"
				          VerticalAlignment="Top"
				          AllowDrop="False"
				          CanDragItems="False"
				          CanReorderItems="False"
				          DragItemsCompleted="ListView_DragItemsCompleted"
				          IsItemClickEnabled="True"
				          IsMultiSelectCheckBoxEnabled="False"
				          IsRightTapEnabled="True"
				          ItemClick="ListView_ItemClick"
				          ItemsSource="{x:Bind PlayListSongs}"
				          ScrollViewer.CanContentRenderOutsideBounds="False"
				          ScrollViewer.VerticalScrollBarVisibility="Visible"
				          ScrollViewer.VerticalScrollMode="Enabled"
				          SelectionChanged="ListView_SelectionChanged"
				          SelectionMode="Single">

					<ListView.ItemsPanel>
						<ItemsPanelTemplate>
							<ItemsStackPanel Orientation="Vertical" />
						</ItemsPanelTemplate>
					</ListView.ItemsPanel>

					<ListView.Header>
						<Border Height="40"
						        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
						        BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
						        BorderThickness="0,0,0,2"
						        CornerRadius="8">

							<interactivity:Interaction.Behaviors>
								<behaviors:StickyHeaderBehavior />
							</interactivity:Interaction.Behaviors>

							<controls:DataTable x:Name="Header"
							                    Margin="12,0,0,0"
							                    ColumnSpacing="10">
								<controls:DataColumn DesiredWidth="40" />
								<controls:DataColumn Content="{services:Loc Key=ColumnHeader_Title}"
								                     DesiredWidth="350"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
								<controls:DataColumn Content="{services:Loc Key=ColumnHeader_Artists}"
								                     DesiredWidth="*"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
								<controls:DataColumn DesiredWidth="*">
									<TextBlock FontWeight="Bold"
									           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
									           Text="{services:Loc Key=ColumnHeader_Album}" />
								</controls:DataColumn>
								<controls:DataColumn Content="{services:Loc Key=ColumnHeader_Duration}"
								                     DesiredWidth="120"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
							</controls:DataTable>
						</Border>
					</ListView.Header>

					<ListView.ItemTemplate>
						<DataTemplate x:DataType="common:Song">
							<Grid Background="Transparent">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Path Grid.Column="0"
								      Width="14"
								      Height="16"
								      Margin="0,0,10,0"
								      VerticalAlignment="Center"
								      Data="M 48,2.5 Q 50,0 52,2.5 L 71.5,26 Q 73.5,28 70.5,28 L 29.5,28 Q 26.5,28 28.5,26 Z M 3,37 L 97,37 A 3,3 0 0 1 97,43 L 3,43 A 3,3 0 0 1 3,37 Z M 3,56 L 97,56 A 3,3 0 0 1 97,62 L 3,62 A 3,3 0 0 1 3,56 Z M 3,75 L 97,75 A 3,3 0 0 1 97,81 L 3,81 A 3,3 0 0 1 3,75 Z M 29.5,90 L 70.5,90 Q 73.5,90 71.5,92 L 52,115.5 Q 50,118 48,115.5 L 28.5,92 Q 26.5,90 29.5,90 Z"
								      Fill="{ThemeResource TextFillColorSecondaryBrush}"
								      Stretch="Uniform"
								      Visibility="{Binding IsReorderMode, ElementName=PlayListTemplatePage, Converter={StaticResource BoolToVisibility}}" />
								<controls:DataRow Grid.Column="1"
								                  HorizontalAlignment="Left"
								                  Background="Transparent"
								                  ContextFlyout="{StaticResource RightClickMenu}">
									<Grid Width="40"
									      Height="60"
									      Margin="0,2,0,2"
									      CornerRadius="10">
										<Image VerticalAlignment="Center"
										       Source="{x:Bind Cover, Converter={StaticResource CoverImageConverter}}" />
									</Grid>
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           Text="{x:Bind Title}"
									           TextTrimming="CharacterEllipsis">
										<ToolTipService.ToolTip>
											<TextBlock TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<Run Text="{services:Loc Key=Tooltip_Title}" />
												<Run FontWeight="Bold"
												     Text="{x:Bind Title}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           Text="{x:Bind Artists}"
									           TextTrimming="CharacterEllipsis">
										<ToolTipService.ToolTip>
											<TextBlock TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<Run Text="{services:Loc Key=Tooltip_Artists}" />
												<Run FontWeight="Bold"
												     Text="{x:Bind Artists}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           Text="{x:Bind Album}"
									           TextTrimming="CharacterEllipsis">
										<ToolTipService.ToolTip>
											<TextBlock TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<Run Text="{services:Loc Key=Tooltip_Album}" />
												<Run FontWeight="Bold"
												     Text="{x:Bind Album}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           HorizontalTextAlignment="Left"
									           Text="{x:Bind Duration, Converter={StaticResource DurationConverter}}"
									           TextTrimming="CharacterEllipsis">
										<ToolTipService.ToolTip>
											<TextBlock TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<Run Text="{services:Loc Key=Tooltip_Duration}" />
												<Run FontWeight="Bold"
												     Text="{x:Bind Duration, Converter={StaticResource DurationToFullTimeConverter}}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
								</controls:DataRow>
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
					<ListView.ItemContainerStyle>
						<Style BasedOn="{StaticResource DefaultListViewItemStyle}"
						       TargetType="ListViewItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListView.ItemContainerStyle>
					<ListView.ItemContainerTransitions>
						<TransitionCollection>
							<AddDeleteThemeTransition />
							<ReorderThemeTransition />
						</TransitionCollection>
					</ListView.ItemContainerTransitions>
				</ListView>
			</Grid>
			<Grid x:Name="PlayListSongsCompactViewGrid">
				<ListView x:Name="PlayListSongsCompactView"
				          Margin="10,10,10,10"
				          Padding="0,0,35,0"
				          VerticalAlignment="Top"
				          AllowDrop="False"
				          CanDragItems="False"
				          CanReorderItems="False"
				          DragItemsCompleted="ListView_DragItemsCompleted"
				          IsItemClickEnabled="True"
				          IsMultiSelectCheckBoxEnabled="False"
				          IsRightTapEnabled="True"
				          ItemClick="ListView_ItemClick"
				          ItemsSource="{x:Bind PlayListSongs}"
				          ScrollViewer.CanContentRenderOutsideBounds="False"
				          ScrollViewer.VerticalScrollBarVisibility="Visible"
				          ScrollViewer.VerticalScrollMode="Enabled"
				          SelectionChanged="ListView_SelectionChanged"
				          SelectionMode="Single">

					<ListView.ItemsPanel>
						<ItemsPanelTemplate>
							<ItemsStackPanel Orientation="Vertical" />
						</ItemsPanelTemplate>
					</ListView.ItemsPanel>

					<ListView.ItemTemplate>
						<DataTemplate x:DataType="common:Song">
							<Grid Background="Transparent"
							      ContextFlyout="{StaticResource RightClickMenu}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="Auto" />
								</Grid.ColumnDefinitions>
								<Path Grid.Column="0"
								      Width="15"
								      Height="18"
								      Margin="0,0,15,0"
								      VerticalAlignment="Center"
								      Data="M 48,2.5 Q 50,0 52,2.5 L 71.5,26 Q 73.5,28 70.5,28 L 29.5,28 Q 26.5,28 28.5,26 Z M 3,37 L 97,37 A 3,3 0 0 1 97,43 L 3,43 A 3,3 0 0 1 3,37 Z M 3,56 L 97,56 A 3,3 0 0 1 97,62 L 3,62 A 3,3 0 0 1 3,56 Z M 3,75 L 97,75 A 3,3 0 0 1 97,81 L 3,81 A 3,3 0 0 1 3,75 Z M 29.5,90 L 70.5,90 Q 73.5,90 71.5,92 L 52,115.5 Q 50,118 48,115.5 L 28.5,92 Q 26.5,90 29.5,90 Z"
								      Fill="{ThemeResource TextFillColorSecondaryBrush}"
								      Stretch="Uniform"
								      Visibility="{Binding IsReorderMode, ElementName=PlayListTemplatePage, Converter={StaticResource BoolToVisibility}}" />
								<Grid Grid.Column="1"
								      HorizontalAlignment="Left"
								      VerticalAlignment="Center">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="100" />
											<ColumnDefinition Width="20" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Grid Grid.Column="0"
										      Width="100"
										      Height="100"
										      Margin="0,10,0,10">
											<Grid Width="Auto"
											      Height="Auto"
											      HorizontalAlignment="Center"
											      VerticalAlignment="Center"
											      CornerRadius="10">
												<Image HorizontalAlignment="Center"
												       VerticalAlignment="Center"
												       Source="{x:Bind Cover, Converter={StaticResource CoverImageConverter}}" />
											</Grid>
										</Grid>
										<StackPanel Grid.Column="2"
										            HorizontalAlignment="Center"
										            VerticalAlignment="Center"
										            Orientation="Vertical"
										            Spacing="5">
											<TextBlock HorizontalAlignment="Left"
											           VerticalAlignment="Center"
											           MaxLines="2"
											           Style="{ThemeResource SubtitleTextBlockStyle}"
											           Text="{x:Bind Title}"
											           TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<ToolTipService.ToolTip>
													<TextBlock TextTrimming="CharacterEllipsis"
													           TextWrapping="WrapWholeWords">
														<Run Text="{services:Loc Key=Tooltip_Title}" />
														<Run FontWeight="Bold"
														     Text="{x:Bind Title}" />
													</TextBlock>
												</ToolTipService.ToolTip>
											</TextBlock>
											<TextBlock HorizontalAlignment="Left"
											           VerticalAlignment="Center"
											           MaxLines="2"
											           Style="{ThemeResource BodyStrongTextBlockStyle}"
											           Text="{x:Bind Artists}"
											           TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<ToolTipService.ToolTip>
													<TextBlock TextTrimming="CharacterEllipsis"
													           TextWrapping="WrapWholeWords">
														<Run Text="{services:Loc Key=Tooltip_Artists}" />
														<Run FontWeight="Bold"
														     Text="{x:Bind Artists}" />
													</TextBlock>
												</ToolTipService.ToolTip>
											</TextBlock>
											<TextBlock HorizontalAlignment="Left"
											           VerticalAlignment="Center"
											           MaxLines="2"
											           Style="{ThemeResource BodyStrongTextBlockStyle}"
											           Text="{x:Bind Album}"
											           TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<ToolTipService.ToolTip>
													<TextBlock TextTrimming="CharacterEllipsis"
													           TextWrapping="WrapWholeWords">
														<Run Text="{services:Loc Key=Tooltip_Album}" />
														<Run FontWeight="Bold"
														     Text="{x:Bind Album}" />
													</TextBlock>
												</ToolTipService.ToolTip>
											</TextBlock>
										</StackPanel>
									</Grid>
								</Grid>
								<Grid Grid.Column="2"
								      Width="120"
								      HorizontalAlignment="Right"
								      VerticalAlignment="Center">
									<Grid.RowDefinitions>
										<RowDefinition Height="60" />
										<RowDefinition Height="45" />
									</Grid.RowDefinitions>
									<Grid Grid.Row="1"
									      VerticalAlignment="Center">
										<TextBlock HorizontalAlignment="Right"
										           VerticalAlignment="Bottom"
										           HorizontalTextAlignment="Right"
										           Style="{ThemeResource BodyStrongTextBlockStyle}"
										           Text="{x:Bind Duration, Converter={StaticResource DurationConverter}}">
											<ToolTipService.ToolTip>
												<TextBlock TextTrimming="CharacterEllipsis"
												           TextWrapping="WrapWholeWords">
													<Run Text="{services:Loc Key=Tooltip_Duration}" />
													<Run FontWeight="Bold"
													     Text="{x:Bind Duration, Converter={StaticResource DurationToFullTimeConverter}}" />
												</TextBlock>
											</ToolTipService.ToolTip>
										</TextBlock>
									</Grid>
									<Grid Grid.Row="0"
									      VerticalAlignment="Center">
										<TextBlock HorizontalAlignment="Right"
										           VerticalAlignment="Top"
										           Style="{ThemeResource BodyStrongTextBlockStyle}"
										           Text="{x:Bind Year}">
											<ToolTipService.ToolTip>
												<TextBlock TextTrimming="CharacterEllipsis"
												           TextWrapping="WrapWholeWords">
													<Run Text="{services:Loc Key=Tooltip_Year}" />
													<Run FontWeight="Bold"
													     Text="{x:Bind Year}" />
												</TextBlock>
											</ToolTipService.ToolTip>
										</TextBlock>
									</Grid>
								</Grid>
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
					<ListView.ItemContainerStyle>
						<Style BasedOn="{StaticResource DefaultListViewItemStyle}"
						       TargetType="ListViewItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListView.ItemContainerStyle>

					<ListView.ItemContainerTransitions>
						<TransitionCollection>
							<AddDeleteThemeTransition />
							<ReorderThemeTransition />
						</TransitionCollection>
					</ListView.ItemContainerTransitions>

				</ListView>
			</Grid>
		</Grid>
	</Grid>
</views:SongListPageBase>
