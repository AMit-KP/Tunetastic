<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Tunetastic.Views.PlaylistViews.PlayListTemplate"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
      xmlns:common="using:Tunetastic.Common"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:local="using:Tunetastic.Generated.Protos"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

	<Grid Margin="10,10,10,0">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition />
		</Grid.RowDefinitions>
		<Grid Grid.Row="0"
		      Margin="15,10,45,10"
		      ColumnSpacing="15">
			<Grid.ColumnDefinitions>
				<ColumnDefinition />
				<ColumnDefinition Width="Auto" />
			</Grid.ColumnDefinitions>
			<dev:AutoScrollView IsPlaying="True"
			                    ScrollingPixelsPreSecond="20">
				<TextBlock x:Name="PlaylistHeader"
				           Grid.Column="0"
				           HorizontalAlignment="Left"
				           Style="{ThemeResource TitleTextBlockStyle}" />
			</dev:AutoScrollView>

			<StackPanel x:Name="PageButtons"
			            Grid.Column="1"
			            HorizontalAlignment="Right"
			            Orientation="Horizontal"
			            Spacing="15">

				<Button ToolTipService.ToolTip="Delete this playlist">
					<FontIcon Glyph="&#xE74D;" />
					<Button.Flyout>
						<Flyout>
							<Flyout.FlyoutPresenterStyle>
								<Style TargetType="FlyoutPresenter">
									<Setter Property="Background" Value="{ThemeResource LayerOnMicaBaseAltFillColorDefault}" />
								</Style>
							</Flyout.FlyoutPresenterStyle>
							<StackPanel Spacing="5">
								<TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
								           Text="Are you sure you want to delete this playlist?" />
				<Button Click="DeletePlayList_Click"
								        Content="Yes" />
							</StackPanel>
						</Flyout>
					</Button.Flyout>
				</Button>
			</StackPanel>
		</Grid>

	</Grid>
</Page>
