<?xml version="1.0" encoding="utf-8" ?>
<views:SongListPageBase x:Class="Tunetastic.Views.PlaylistViews.RecentlyAdded"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:services="using:Tunetastic.Common.Services"
                        xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
                        xmlns:common="using:Tunetastic.Common"
                        xmlns:controls="using:CommunityToolkit.WinUI.Controls"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:dev="using:DevWinUI"
                        xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:views="using:Tunetastic.Views.Common"
                        x:Name="RecentlyAddedPage"
                        Loaded="Page_Loaded"
                        Unloaded="RecentlyAdded_Unloaded">

	<views:SongListPageBase.Resources>
		<MenuFlyout x:Key="RightClickMenu"
		            Opened="MenuFlyout_Opened">
			<MenuFlyoutItem x:Uid="Action_Play" Click="MenuFlyoutItemPlay_OnClick"
			                Text="{services:Loc Key=Action_Play.Text}"
			                ToolTipService.ToolTip="{services:Loc Key=Action_Play_ToolTip}">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE768;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutSubItem x:Name="AddToPlaylist" x:Uid="Action_AddToPlaylist"
			                   Text="{services:Loc Key=Action_AddToPlaylist.Text}">
				<MenuFlyoutSubItem.Icon>
					<FontIcon Glyph="&#xE728;" />
				</MenuFlyoutSubItem.Icon>
			</MenuFlyoutSubItem>
			<MenuFlyoutItem x:Uid="Action_AddToQueue" Click="MenuFlyoutItemAddToQueue_OnClick"
			                Text="{services:Loc Key=Action_AddToQueue.Text}"
			                ToolTipService.ToolTip="{services:Loc Key=Action_AddToQueue_ToolTip}">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE84F;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutItem x:Uid="Action_InfoTag" Click="MenuFlyoutItemInfoTag_OnClick"
			                Text="{services:Loc Key=Action_InfoTag.Text}">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE946;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutItem x:Uid="Action_DeleteTrack" Click="MenuFlyoutItemDelete_OnClick"
			                Text="{services:Loc Key=Action_DeleteTrack.Text}"
			                ToolTipService.ToolTip="{services:Loc Key=Action_DeleteTrack_ToolTip}">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE74D;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
		</MenuFlyout>
	</views:SongListPageBase.Resources>

	<Grid Margin="10,10,10,-10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid Grid.Row="0"
		      Margin="15,10,45,10">
			<TextBlock x:Uid="RecentlyAdded_Title" HorizontalAlignment="Left" Style="{ThemeResource TitleTextBlockStyle}"
			           Text="{services:Loc Key=RecentlyAdded_Title.Text}"
			           ToolTipService.ToolTip="{services:Loc Key=RecentlyAdded_Title_ToolTip}" />

			<StackPanel x:Name="PageButtons"
			            HorizontalAlignment="Right"
			            Orientation="Horizontal"
			            Spacing="15">
				<ToggleButton x:Name="MultiSelectButton" x:Uid="ActionBar_MultiSelect"
				              Click="MultiSelectButton_Click"
				              ToolTipService.ToolTip="{services:Loc Key=ActionBar_MultiSelect_ToolTip}">
					<FontIcon Glyph="&#xE73A;" />
				</ToggleButton>
				<StackPanel x:Name="PlayAllButtonStackPanel"
				            Orientation="Horizontal"
				            Spacing="5">
					<Button x:Name="ShuffleAndPlay" x:Uid="ActionBar_ShuffleAndPlay"
					        HorizontalAlignment="Right"
					        Click="ShuffleAndPlayButton_OnClick"
					        ToolTipService.ToolTip="{services:Loc Key=ActionBar_ShuffleAndPlay_ToolTip}">
						<FontIcon Glyph="&#xE8B1;" />
					</Button>
					<Button x:Name="PlayAll" x:Uid="ActionBar_PlayAll"
					        HorizontalAlignment="Right"
					        Click="PlayAllButton_OnClick"
					        ToolTipService.ToolTip="{services:Loc Key=ActionBar_PlayAll_ToolTip}">
						<FontIcon Glyph="&#xF5B0;" />
					</Button>
				</StackPanel>
				<StackPanel x:Name="LimitAndViewButtonPanel"
				            Orientation="Horizontal"
				            Spacing="5">
					<DropDownButton x:Name="MaxLimitDropDown"
					                HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="MaxLimit"
							            Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="Limit50" x:Uid="MaxLimit_50" Click="MaxLimitButton_OnClick" GroupName="Limit" Tag="50" Text="{services:Loc Key=MaxLimit_50.Text}" />
								<RadioMenuFlyoutItem x:Name="Limit100" x:Uid="MaxLimit_100" Click="MaxLimitButton_OnClick" GroupName="Limit" Tag="100" Text="{services:Loc Key=MaxLimit_100.Text}" />
								<RadioMenuFlyoutItem x:Name="Limit200" x:Uid="MaxLimit_200" Click="MaxLimitButton_OnClick" GroupName="Limit" Tag="200" Text="{services:Loc Key=MaxLimit_200.Text}" />
								<RadioMenuFlyoutItem x:Name="Limit500" x:Uid="MaxLimit_500" Click="MaxLimitButton_OnClick" GroupName="Limit" Tag="500" Text="{services:Loc Key=MaxLimit_500.Text}" />
								<MenuFlyoutSeparator />
								<RadioMenuFlyoutItem x:Name="Unlimited"
								                     Click="MaxLimitButton_OnClick"
								                     GroupName="Limit"
								                     Tag="Unlimited"
								                     x:Uid="MaxLimit_Unlimited"
								                     Text="{services:Loc Key=MaxLimit_Unlimited.Text}" />
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
					<DropDownButton x:Name="TimeFieldType"
					                HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="TimeFieldStyle"
							            Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="DateStyle"
								                     Click="TimeStyle_Click"
								                     GroupName="Time"
								                     Tag="DateStyle" x:Uid="TimeStyle_Date" Text="{services:Loc Key=TimeStyle_Date.Text}">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE787;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
								<RadioMenuFlyoutItem x:Name="RelativeTimeStyle"
								                     Click="TimeStyle_Click"
								                     GroupName="Time"
								                     Tag="RelativeTimeStyle" x:Uid="TimeStyle_Relative" Text="{services:Loc Key=TimeStyle_Relative.Text}">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xEC92;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
					<DropDownButton x:Name="ViewButton"
					                HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="ViewStyle"
							            Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="ListViewStyle"
								                     Click="ViewButton_OnClick"
								                     GroupName="View"
								                     Tag="List View" x:Uid="ViewStyle_List" Text="{services:Loc Key=ViewStyle_List.Text}">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE8FD;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
								<RadioMenuFlyoutItem x:Name="CompactViewStyle"
								                     Click="ViewButton_OnClick"
								                     GroupName="View"
								                     Tag="Compact View" x:Uid="ViewStyle_Compact" Text="{services:Loc Key=ViewStyle_Compact.Text}">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE71D;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
				</StackPanel>
				<Button x:Name="MoreButton"
				        Visibility="Collapsed">
					<FontIcon Glyph="&#xE712;" />
					<Button.Flyout>
						<MenuFlyout x:Name="More"
						            Opened="MenuFlyout_Opened"
						            Placement="BottomEdgeAlignedRight">
							<MenuFlyoutSubItem x:Uid="ActionBar_Multi_AddToPlaylist" Text="{services:Loc Key=ActionBar_Multi_AddToPlaylist.Text}">
								<MenuFlyoutSubItem.Icon>
									<FontIcon Glyph="&#xE728;" />
								</MenuFlyoutSubItem.Icon>
							</MenuFlyoutSubItem>
							<MenuFlyoutItem x:Uid="ActionBar_Multi_AddToQueue" Click="MenuFlyoutMultiItemAddToQueue_OnClick"
							                Text="{services:Loc Key=ActionBar_Multi_AddToQueue.Text}"
							                ToolTipService.ToolTip="{services:Loc Key=ActionBar_Multi_AddToQueue_ToolTip}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE84F;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem x:Uid="ActionBar_Multi_Delete" Click="MenuFlyoutMultiItemDelete_OnClick"
							                Text="{services:Loc Key=ActionBar_Multi_Delete.Text}"
							                ToolTipService.ToolTip="{services:Loc Key=ActionBar_Multi_Delete_ToolTip}">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE74D;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</StackPanel>
		</Grid>
		<Grid Grid.Row="1">
			<StackPanel x:Name="GoToSettings"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            ToolTipService.ToolTip="{services:Loc Key=EmptyState_NoSongs.Text}"
			            Visibility="Visible">
				<TextBlock x:Name="GoToSettingsTextBlock"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           HorizontalTextAlignment="Center"
				           Style="{ThemeResource SubtitleTextBlockStyle}"
				           TextAlignment="Center"
				           TextWrapping="WrapWholeWords" />
				<Button x:Uid="EmptyState_OpenSettings" HorizontalAlignment="Center" VerticalAlignment="Center" Click="GotoSettigsButton_Click" Content="{services:Loc Key=EmptyState_OpenSettings.Content}" />
			</StackPanel>
			<StackPanel x:Name="LoadingProgress"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            Visibility="Collapsed">
				<dev:LoadingIndicator Mode="Arcs" />
				<Grid x:Name="CustomProgressBar"
				      Width="400"
				      Height="50"
				      Background="{ThemeResource AccentAAFillColorDisabled}"
				      BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
				      BorderThickness="2"
				      CornerRadius="5">
					<Rectangle x:Name="ProgressFill"
					           Height="50"
					           HorizontalAlignment="Left"
					           Fill="{ThemeResource AccentAAFillColorDefaultBrush}" />
					<Grid>
						<TextBlock x:Name="ProgressFillText"
						           HorizontalAlignment="Center"
						           VerticalAlignment="Center"
						           Style="{ThemeResource BodyStrongTextBlockStyle}" />
					</Grid>
				</Grid>
			</StackPanel>
			<Grid Width="Auto"
			      Height="Auto"
			      HorizontalAlignment="Center"
			      VerticalAlignment="Center">
				<ContentDialog x:Name="DeleteDialog" x:Uid="DeleteDialog_ConfirmDialog"
				               Title="Confirm Deletion"
				               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
				               DefaultButton="Secondary"
				               PrimaryButtonText="Delete"
				               SecondaryButtonText="Cancel"
				               Visibility="Collapsed">
					<StackPanel Spacing="10">
						<TextBlock x:Name="DeleteDialogText"
						           Style="{ThemeResource BodyTextBlockStyle}"
						           TextWrapping="WrapWholeWords" />
						<TextBlock x:Uid="DeleteDialog_UndoneWarning" Foreground="Red" Style="{ThemeResource BodyStrongTextBlockStyle}" Text="This action cannot be undone."
						           TextWrapping="WrapWholeWords" />
					</StackPanel>
				</ContentDialog>
			</Grid>
			<Grid x:Name="RecentlyAddedSongsListViewGrid">
				<ListView x:Name="RecentlyAddedSongsListView"
				          Margin="10,10,10,10"
				          Padding="0,0,35,0"
				          VerticalAlignment="Top"
				          IsItemClickEnabled="True"
				          IsMultiSelectCheckBoxEnabled="False"
				          IsRightTapEnabled="True"
				          ItemClick="ListView_ItemClick"
				          ItemsSource="{x:Bind RecentlyAddedSongs}"
				          ScrollViewer.CanContentRenderOutsideBounds="False"
				          ScrollViewer.VerticalScrollBarVisibility="Visible"
				          ScrollViewer.VerticalScrollMode="Enabled"
				          SelectionChanged="ListView_SelectionChanged"
				          SelectionMode="Single">

					<ListView.ItemsPanel>
						<ItemsPanelTemplate>
							<ItemsStackPanel Orientation="Vertical" />
						</ItemsPanelTemplate>
					</ListView.ItemsPanel>

					<ListView.Header>
						<Border Height="40"
						        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
						        BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
						        BorderThickness="0,0,0,2"
						        CornerRadius="8">

							<interactivity:Interaction.Behaviors>
								<behaviors:StickyHeaderBehavior />
							</interactivity:Interaction.Behaviors>

							<controls:DataTable x:Name="Header"
							                    Margin="12,0,0,0"
							                    ColumnSpacing="10">
								<controls:DataColumn DesiredWidth="40" />
								<controls:DataColumn Content="{services:Loc Key=ColumnHeader_Title}"
								                     DesiredWidth="230"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
								<controls:DataColumn Content="{services:Loc Key=ColumnHeader_Artists}"
								                     DesiredWidth="*"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
								<controls:DataColumn DesiredWidth="*">
									<TextBlock FontWeight="Bold"
									           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
									           Text="{services:Loc Key=ColumnHeader_Album}" />
								</controls:DataColumn>
								<controls:DataColumn Content="{services:Loc Key=ColumnHeader_Duration}"
								                     DesiredWidth="75"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
								<controls:DataColumn DesiredWidth="165"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}">
									<TextBlock FontWeight="Bold"
									           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
									           Text="{services:Loc Key=ColumnHeader_ModifiedOn}"
									           TextWrapping="WrapWholeWords" />
								</controls:DataColumn>
							</controls:DataTable>
						</Border>
					</ListView.Header>

					<ListView.ItemTemplate>
						<DataTemplate x:DataType="common:Song">
							<controls:DataRow HorizontalAlignment="Left"
							                  Background="Transparent"
							                  ContextFlyout="{StaticResource RightClickMenu}">
								<Grid Width="40"
								      Height="60"
								      Margin="0,2,0,2"
								      CornerRadius="10">
									<Image VerticalAlignment="Center"
									       Source="{x:Bind Cover, Converter={StaticResource CoverImageConverter}}" />
								</Grid>
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Text="{x:Bind Title}"
								           TextTrimming="CharacterEllipsis">
									<ToolTipService.ToolTip>
										<TextBlock TextTrimming="CharacterEllipsis"
										           TextWrapping="WrapWholeWords">
											<Run Text="{services:Loc Key=Tooltip_Title}" />
											<Run FontWeight="Bold"
											     Text="{x:Bind Title}" />
										</TextBlock>
									</ToolTipService.ToolTip>
								</TextBlock>
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Text="{x:Bind Artists}">
									<ToolTipService.ToolTip>
										<TextBlock TextTrimming="CharacterEllipsis"
										           TextWrapping="WrapWholeWords">
											<Run Text="{services:Loc Key=Tooltip_Artists}" />
											<Run FontWeight="Bold"
											     Text="{x:Bind Artists}" />
										</TextBlock>
									</ToolTipService.ToolTip>
								</TextBlock>
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Text="{x:Bind Album}">
									<ToolTipService.ToolTip>
										<TextBlock TextTrimming="CharacterEllipsis"
										           TextWrapping="WrapWholeWords">
											<Run Text="{services:Loc Key=Tooltip_Album}" />
											<Run FontWeight="Bold"
											     Text="{x:Bind Album}" />
										</TextBlock>
									</ToolTipService.ToolTip>
								</TextBlock>
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           HorizontalTextAlignment="Left"
								           Text="{x:Bind Duration, Converter={StaticResource DurationConverter}}">
									<ToolTipService.ToolTip>
										<TextBlock>
											<Run Text="{services:Loc Key=Tooltip_Duration}" />
											<Run FontWeight="Bold"
											     Text="{x:Bind Duration, Converter={StaticResource DurationToFullTimeConverter}}" />
										</TextBlock>
									</ToolTipService.ToolTip>
								</TextBlock>
								<Grid>
									<TextBlock HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           HorizontalTextAlignment="Left"
									           Text="{x:Bind DateAdded, Converter={StaticResource DateFormatConverter}}"
									           TextTrimming="CharacterEllipsis"
									           TextWrapping="WrapWholeWords"
									           Visibility="{Binding IsRelativeDisplayMode, ElementName=RecentlyAddedPage, Converter={StaticResource BoolToVisibility}, ConverterParameter=True}">
										<ToolTipService.ToolTip>
											<TextBlock TextWrapping="WrapWholeWords">
												<Run x:Name="DateTooltip"
												     FontWeight="Bold"
												     Text="{x:Bind DateAdded, Converter={StaticResource RelativeTimeConverter}}" />
												<Underline />
												<LineBreak />
												<Run Text="{services:Loc Key=Tooltip_DateAdded}" />
												<Run FontWeight="Bold"
												     Text="{x:Bind DateAdded, Converter={StaticResource DateFormatConverter}, ConverterParameter='D'}" />
												<LineBreak />
												<Run Text="{services:Loc Key=Tooltip_TimeAdded}" />
												<Run FontWeight="Bold"
												     Text="{x:Bind DateAdded, Converter={StaticResource DateFormatConverter}, ConverterParameter='T'}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
									<TextBlock x:Name="RelativeTime"
									           HorizontalAlignment="Left"
									           VerticalAlignment="Center"
									           HorizontalTextAlignment="Left"
									           Text="{x:Bind DateAdded, Converter={StaticResource RelativeTimeConverter}}"
									           TextTrimming="CharacterEllipsis"
									           TextWrapping="WrapWholeWords"
									           Visibility="{Binding IsRelativeDisplayMode, ElementName=RecentlyAddedPage, Converter={StaticResource BoolToVisibility}}">
										<ToolTipService.ToolTip>
											<TextBlock TextWrapping="WrapWholeWords">
												<Run x:Name="RelativeTimeTooltip"
												     FontWeight="Bold"
												     Text="{x:Bind DateAdded, Converter={StaticResource RelativeTimeConverter}}" />
												<Underline />
												<LineBreak />
												<Run Text="{services:Loc Key=Tooltip_DateAdded}" />
												<Run FontWeight="Bold"
												     Text="{x:Bind DateAdded, Converter={StaticResource DateFormatConverter}, ConverterParameter='D'}" />
												<LineBreak />
												<Run Text="{services:Loc Key=Tooltip_TimeAdded}" />
												<Run FontWeight="Bold"
												     Text="{x:Bind DateAdded, Converter={StaticResource DateFormatConverter}, ConverterParameter='T'}" />
											</TextBlock>
										</ToolTipService.ToolTip>
									</TextBlock>
								</Grid>
							</controls:DataRow>
						</DataTemplate>
					</ListView.ItemTemplate>
					<ListView.ItemContainerStyle>
						<Style BasedOn="{StaticResource DefaultListViewItemStyle}"
						       TargetType="ListViewItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListView.ItemContainerStyle>
					<ListView.ItemContainerTransitions>
						<TransitionCollection>
							<AddDeleteThemeTransition />
						</TransitionCollection>
					</ListView.ItemContainerTransitions>
				</ListView>
			</Grid>
			<Grid x:Name="RecentlyAddedSongsCompactViewGrid">
				<ListView x:Name="RecentlyAddedSongsCompactView"
				          Margin="10,10,10,10"
				          Padding="0,0,35,0"
				          VerticalAlignment="Top"
				          IsItemClickEnabled="True"
				          IsMultiSelectCheckBoxEnabled="False"
				          IsRightTapEnabled="True"
				          ItemClick="ListView_ItemClick"
				          ItemsSource="{x:Bind RecentlyAddedSongs}"
				          ScrollViewer.CanContentRenderOutsideBounds="False"
				          ScrollViewer.VerticalScrollBarVisibility="Visible"
				          ScrollViewer.VerticalScrollMode="Enabled"
				          SelectionChanged="ListView_SelectionChanged"
				          SelectionMode="Single">

					<ListView.ItemsPanel>
						<ItemsPanelTemplate>
							<ItemsStackPanel Orientation="Vertical" />
						</ItemsPanelTemplate>
					</ListView.ItemsPanel>

					<ListView.ItemTemplate>
						<DataTemplate x:DataType="common:Song">
							<Grid Background="Transparent"
							      ContextFlyout="{StaticResource RightClickMenu}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="120" />
								</Grid.ColumnDefinitions>
								<Grid Grid.Column="0"
								      HorizontalAlignment="Left"
								      VerticalAlignment="Center">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="100" />
											<ColumnDefinition Width="20" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Grid Grid.Column="0"
										      Width="100"
										      Height="100"
										      Margin="0,10,0,10">
											<Grid Width="Auto"
											      Height="Auto"
											      HorizontalAlignment="Center"
											      VerticalAlignment="Center"
											      CornerRadius="10">
												<Image HorizontalAlignment="Center"
												       VerticalAlignment="Center"
												       Source="{x:Bind Cover, Converter={StaticResource CoverImageConverter}}" />
											</Grid>
										</Grid>
										<StackPanel Grid.Column="2"
										            HorizontalAlignment="Center"
										            VerticalAlignment="Center"
										            Orientation="Vertical"
										            Spacing="5">
											<TextBlock HorizontalAlignment="Left"
											           VerticalAlignment="Center"
											           MaxLines="2"
											           Style="{ThemeResource SubtitleTextBlockStyle}"
											           Text="{x:Bind Title}"
											           TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<ToolTipService.ToolTip>
													<TextBlock TextTrimming="CharacterEllipsis"
													           TextWrapping="WrapWholeWords">
														<Run Text="{services:Loc Key=Tooltip_Title}" />
														<Run FontWeight="Bold"
														     Text="{x:Bind Title}" />
													</TextBlock>
												</ToolTipService.ToolTip>
											</TextBlock>
											<TextBlock HorizontalAlignment="Left"
											           VerticalAlignment="Center"
											           MaxLines="2"
											           Style="{ThemeResource BodyStrongTextBlockStyle}"
											           Text="{x:Bind Artists}"
											           TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<ToolTipService.ToolTip>
													<TextBlock TextTrimming="CharacterEllipsis"
													           TextWrapping="WrapWholeWords">
														<Run Text="{services:Loc Key=Tooltip_Artists}" />
														<Run FontWeight="Bold"
														     Text="{x:Bind Artists}" />
													</TextBlock>
												</ToolTipService.ToolTip>
											</TextBlock>
											<TextBlock HorizontalAlignment="Left"
											           VerticalAlignment="Center"
											           MaxLines="2"
											           Style="{ThemeResource BodyStrongTextBlockStyle}"
											           Text="{x:Bind Album}"
											           TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<ToolTipService.ToolTip>
													<TextBlock TextTrimming="CharacterEllipsis"
													           TextWrapping="WrapWholeWords">
														<Run Text="{services:Loc Key=Tooltip_Album}" />
														<Run FontWeight="Bold"
														     Text="{x:Bind Album}" />
													</TextBlock>
												</ToolTipService.ToolTip>
											</TextBlock>
										</StackPanel>
									</Grid>
								</Grid>
								<Grid Grid.Column="1"
								      Width="120"
								      HorizontalAlignment="Right"
								      VerticalAlignment="Center">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="10" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="5" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Grid Grid.Row="0"
									      VerticalAlignment="Center">
										<TextBlock HorizontalAlignment="Right"
										           VerticalAlignment="Center"
										           FontWeight="Bold"
										           Style="{ThemeResource BodyStrongTextBlockStyle}"
										           Text="{x:Bind DateAdded, Converter={StaticResource DateFormatConverter}}"
										           Visibility="{Binding IsRelativeDisplayMode, ElementName=RecentlyAddedPage, Converter={StaticResource BoolToVisibility}, ConverterParameter=True}">
											<ToolTipService.ToolTip>
												<TextBlock TextWrapping="WrapWholeWords">
													<Run x:Name="DateTooltip"
													     FontWeight="Bold"
													     Text="{x:Bind DateAdded, Converter={StaticResource RelativeTimeConverter}}" />
													<Underline />
													<LineBreak />
													<Run Text="{services:Loc Key=Tooltip_DateAdded}" />
													<Run FontWeight="Bold"
													     Text="{x:Bind DateAdded, Converter={StaticResource DateFormatConverter}, ConverterParameter='D'}" />
													<LineBreak />
													<Run Text="{services:Loc Key=Tooltip_TimeAdded}" />
													<Run FontWeight="Bold"
													     Text="{x:Bind DateAdded, Converter={StaticResource DateFormatConverter}, ConverterParameter='T'}" />
												</TextBlock>
											</ToolTipService.ToolTip>
										</TextBlock>
										<TextBlock x:Name="RelativeTime"
										           HorizontalAlignment="Right"
										           VerticalAlignment="Center"
										           FontWeight="Bold"
										           Style="{ThemeResource BodyStrongTextBlockStyle}"
										           Text="{x:Bind DateAdded, Converter={StaticResource RelativeTimeConverter}}"
										           Visibility="{Binding IsRelativeDisplayMode, ElementName=RecentlyAddedPage, Converter={StaticResource BoolToVisibility}}">
											<ToolTipService.ToolTip>
												<TextBlock TextWrapping="WrapWholeWords">
													<Run x:Name="RelativeTimeTooltip"
													     FontWeight="Bold"
													     Text="{x:Bind DateAdded, Converter={StaticResource RelativeTimeConverter}}" />
													<Underline />
													<LineBreak />
													<Run Text="{services:Loc Key=Tooltip_DateAdded}" />
													<Run FontWeight="Bold"
													     Text="{x:Bind DateAdded, Converter={StaticResource DateFormatConverter}, ConverterParameter='D'}" />
													<LineBreak />
													<Run Text="{services:Loc Key=Tooltip_TimeAdded}" />
													<Run FontWeight="Bold"
													     Text="{x:Bind DateAdded, Converter={StaticResource DateFormatConverter}, ConverterParameter='T'}" />
												</TextBlock>
											</ToolTipService.ToolTip>
										</TextBlock>
									</Grid>
									<Grid Grid.Row="2"
									      VerticalAlignment="Center">
										<TextBlock HorizontalAlignment="Right"
										           VerticalAlignment="Center"
										           Style="{ThemeResource BodyStrongTextBlockStyle}"
										           Text="{x:Bind Year}">
											<ToolTipService.ToolTip>
												<TextBlock>
													<Run Text="{services:Loc Key=Tooltip_Year}" />
													<Run FontWeight="Bold"
													     Text="{x:Bind Year}" />
												</TextBlock>
											</ToolTipService.ToolTip>
										</TextBlock>
									</Grid>
									<Grid Grid.Row="4"
									      VerticalAlignment="Center">
										<TextBlock HorizontalAlignment="Right"
										           VerticalAlignment="Center"
										           HorizontalTextAlignment="Right"
										           Style="{ThemeResource BodyStrongTextBlockStyle}"
										           Text="{x:Bind Duration, Converter={StaticResource DurationConverter}}">
											<ToolTipService.ToolTip>
												<TextBlock>
													<Run Text="{services:Loc Key=Tooltip_Duration}" />
													<Run FontWeight="Bold"
													     Text="{x:Bind Duration, Converter={StaticResource DurationToFullTimeConverter}}" />
												</TextBlock>
											</ToolTipService.ToolTip>
										</TextBlock>
									</Grid>
								</Grid>
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
					<ListView.ItemContainerStyle>
						<Style BasedOn="{StaticResource DefaultListViewItemStyle}"
						       TargetType="ListViewItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListView.ItemContainerStyle>

					<ListView.ItemContainerTransitions>
						<TransitionCollection>
							<AddDeleteThemeTransition />
						</TransitionCollection>
					</ListView.ItemContainerTransitions>

				</ListView>
			</Grid>
		</Grid>
	</Grid>
</views:SongListPageBase>
