<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="Tunetastic.Views.PlaylistViews.MostPlayed"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:behaviors="using:CommunityToolkit.WinUI.Behaviors"
      xmlns:common="using:Tunetastic.Common"
      xmlns:controls="using:CommunityToolkit.WinUI.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:interactivity="using:Microsoft.Xaml.Interactivity"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Loaded="Page_Loaded"
      Unloaded="Page_Unloaded">

	<Page.Resources>
		<MenuFlyout x:Key="RightClickMenu"
		            Opened="MenuFlyout_Opened">
			<MenuFlyoutItem Click="MenuFlyoutItemPlay_OnClick"
			                Text="Play"
			                ToolTipService.ToolTip="Play this song/track">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE768;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutSubItem x:Name="AddToPlaylist"
			                   Text="Add to playlist">
				<MenuFlyoutSubItem.Icon>
					<FontIcon Glyph="&#xE728;" />
				</MenuFlyoutSubItem.Icon>
			</MenuFlyoutSubItem>
			<MenuFlyoutItem Click="MenuFlyoutItemAddToQueue_OnClick"
			                Text="Add to queue"
			                ToolTipService.ToolTip="Add this song/track to the queue">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE84F;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutItem Click="MenuFlyoutItemInfoTag_OnClick"
			                Text="Info/Tag">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE946;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
			<MenuFlyoutSeparator />
			<MenuFlyoutItem Click="MenuFlyoutItemDelete_OnClick"
			                Text="Delete"
			                ToolTipService.ToolTip="Delete this song/track">
				<MenuFlyoutItem.Icon>
					<FontIcon Glyph="&#xE74D;" />
				</MenuFlyoutItem.Icon>
			</MenuFlyoutItem>
		</MenuFlyout>
	</Page.Resources>

	<Grid Margin="10,10,10,0">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>
		<Grid Grid.Row="0"
		      Margin="15,10,45,10">
			<TextBlock HorizontalAlignment="Left"
			           Style="{ThemeResource TitleTextBlockStyle}"
			           Text="Mostly Played"
			           ToolTipService.ToolTip="Mostly Played songs/tracks will be displayed here" />

			<StackPanel x:Name="PageButtons"
			            HorizontalAlignment="Right"
			            Orientation="Horizontal"
			            Spacing="15">
				<ToggleButton x:Name="MultiSelectButton"
				              Click="MultiSelectButton_Click"
				              ToolTipService.ToolTip="Turn on multi-select mode">
					<FontIcon Glyph="&#xE73A;" />
				</ToggleButton>
				<StackPanel x:Name="PlayAllButtonStackPanel"
				            Orientation="Horizontal"
				            Spacing="5">
					<Button x:Name="ShuffleAndPlay"
					        HorizontalAlignment="Right"
					        Click="ShuffleAndPlayButton_OnClick"
					        ToolTipService.ToolTip="Shuffle And Play All">
						<FontIcon Glyph="&#xE8B1;" />
					</Button>
					<Button x:Name="PlayAll"
					        HorizontalAlignment="Right"
					        Click="PlayAllButton_OnClick"
					        ToolTipService.ToolTip="Play All">
						<FontIcon Glyph="&#xF5B0;" />
					</Button>
				</StackPanel>
				<StackPanel x:Name="LimitAndViewButtonPanel"
				            Orientation="Horizontal"
				            Spacing="5">
					<DropDownButton x:Name="MaxLimitDropDown"
					                HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="MaxLimit"
							            Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="Limit50"
								                     Click="MaxLimitButton_OnClick"
								                     GroupName="Limit"
								                     Text="50" />
								<RadioMenuFlyoutItem x:Name="Limit100"
								                     Click="MaxLimitButton_OnClick"
								                     GroupName="Limit"
								                     Text="100" />
								<RadioMenuFlyoutItem x:Name="Limit200"
								                     Click="MaxLimitButton_OnClick"
								                     GroupName="Limit"
								                     Text="200" />
								<RadioMenuFlyoutItem x:Name="Limit500"
								                     Click="MaxLimitButton_OnClick"
								                     GroupName="Limit"
								                     Text="500" />
								<MenuFlyoutSeparator />
								<RadioMenuFlyoutItem x:Name="Unlimited"
								                     Click="MaxLimitButton_OnClick"
								                     GroupName="Limit"
								                     Text="Unlimited" />
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
					<DropDownButton x:Name="ViewButton"
					                HorizontalAlignment="Right">
						<DropDownButton.Flyout>
							<MenuFlyout x:Name="ViewStyle"
							            Placement="BottomEdgeAlignedRight">
								<RadioMenuFlyoutItem x:Name="ListViewStyle"
								                     Click="ViewButton_OnClick"
								                     GroupName="View"
								                     Text="List View">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE8FD;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
								<RadioMenuFlyoutItem x:Name="CompactViewStyle"
								                     Click="ViewButton_OnClick"
								                     GroupName="View"
								                     Text="Compact View">
									<RadioMenuFlyoutItem.Icon>
										<FontIcon Glyph="&#xE71D;" />
									</RadioMenuFlyoutItem.Icon>
								</RadioMenuFlyoutItem>
							</MenuFlyout>
						</DropDownButton.Flyout>
					</DropDownButton>
				</StackPanel>
				<Button x:Name="MoreButton"
				        Visibility="Collapsed">
					<FontIcon Glyph="&#xE712;" />
					<Button.Flyout>
						<MenuFlyout x:Name="More"
						            Opened="MenuFlyout_Opened"
						            Placement="BottomEdgeAlignedRight">
							<MenuFlyoutSubItem Text="Add to playlist">
								<MenuFlyoutSubItem.Icon>
									<FontIcon Glyph="&#xE728;" />
								</MenuFlyoutSubItem.Icon>
							</MenuFlyoutSubItem>
							<MenuFlyoutItem Click="MenuFlyoutMultiItemAddToQueue_OnClick"
							                Text="Add to queue"
							                ToolTipService.ToolTip="Add selected songs/tracks to the queue">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE84F;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
							<MenuFlyoutSeparator />
							<MenuFlyoutItem Click="MenuFlyoutMultiItemDelete_OnClick"
							                Text="Delete"
							                ToolTipService.ToolTip="Delete selected songs/tracks">
								<MenuFlyoutItem.Icon>
									<FontIcon Glyph="&#xE74D;" />
								</MenuFlyoutItem.Icon>
							</MenuFlyoutItem>
						</MenuFlyout>
					</Button.Flyout>
				</Button>
			</StackPanel>
		</Grid>
		<Grid Grid.Row="1">
			<StackPanel x:Name="GoToSettings"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            ToolTipService.ToolTip="No songs or tracks found. Please, check your settings to ensure your libraries are added and songs/tracks have been scanned."
			            Visibility="Visible">
				<TextBlock x:Name="GoToSettingsTextBlock"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           HorizontalTextAlignment="Center"
				           Style="{ThemeResource SubtitleTextBlockStyle}"
				           TextAlignment="Center"
				           TextWrapping="WrapWholeWords" />
				<Button HorizontalAlignment="Center"
				        VerticalAlignment="Center"
				        Click="GotoSettigsButton_Click"
				        Content="Open Settings" />
			</StackPanel>
			<Grid x:Name="NoResultsGrid"
			      HorizontalAlignment="Center"
			      VerticalAlignment="Center"
			      Visibility="Collapsed">
				<TextBlock x:Name="NoResultsTextBlock"
				           HorizontalAlignment="Center"
				           VerticalAlignment="Center"
				           HorizontalTextAlignment="Center"
				           Style="{ThemeResource SubtitleTextBlockStyle}"
				           TextAlignment="Center"
				           TextWrapping="WrapWholeWords" />
			</Grid>
			<StackPanel x:Name="LoadingProgress"
			            HorizontalAlignment="Center"
			            VerticalAlignment="Center"
			            Orientation="Vertical"
			            Spacing="30"
			            Visibility="Collapsed">
				<dev:LoadingIndicator Mode="Arcs" />
				<Grid x:Name="CustomProgressBar"
				      Width="400"
				      Height="50"
				      Background="{ThemeResource AccentAAFillColorDisabled}"
				      BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
				      BorderThickness="2"
				      CornerRadius="5">
					<Rectangle x:Name="ProgressFill"
					           Height="50"
					           HorizontalAlignment="Left"
					           Fill="{ThemeResource AccentAAFillColorDefaultBrush}" />
					<Grid>
						<TextBlock x:Name="ProgressFillText"
						           HorizontalAlignment="Center"
						           VerticalAlignment="Center"
						           Style="{ThemeResource BodyStrongTextBlockStyle}" />
					</Grid>
				</Grid>
			</StackPanel>
			<Grid Width="Auto"
			      Height="Auto"
			      HorizontalAlignment="Center"
			      VerticalAlignment="Center">
				<ContentDialog x:Name="DeleteDialog"
				               Title="Confirm Deletion"
				               Background="{ThemeResource AcrylicBackgroundFillColorBaseBrush}"
				               DefaultButton="Secondary"
				               PrimaryButtonText="Delete"
				               SecondaryButtonText="Cancel"
				               Visibility="Collapsed">
					<StackPanel Spacing="10">
						<TextBlock x:Name="DeleteDialogText"
						           Style="{ThemeResource BodyTextBlockStyle}"
						           TextWrapping="WrapWholeWords" />
						<TextBlock Foreground="Red"
						           Style="{ThemeResource BodyStrongTextBlockStyle}"
						           Text="This action cannot be undone."
						           TextWrapping="WrapWholeWords" />
					</StackPanel>
				</ContentDialog>
			</Grid>
			<Grid x:Name="MostPlayedSongsListViewGrid">
				<ListView x:Name="MostPlayedSongsListView"
				          Margin="10,10,10,10"
				          Padding="0,0,35,0"
				          VerticalAlignment="Top"
				          IsItemClickEnabled="True"
				          IsMultiSelectCheckBoxEnabled="False"
				          IsRightTapEnabled="True"
				          ItemClick="ListView_ItemClick"
				          ItemsSource="{x:Bind MostPlayedSongs}"
				          ScrollViewer.CanContentRenderOutsideBounds="False"
				          ScrollViewer.VerticalScrollBarVisibility="Visible"
				          ScrollViewer.VerticalScrollMode="Enabled"
				          SelectionChanged="ListView_SelectionChanged"
				          SelectionMode="Single">

					<ListView.ItemsPanel>
						<ItemsPanelTemplate>
							<ItemsStackPanel Orientation="Vertical" />
						</ItemsPanelTemplate>
					</ListView.ItemsPanel>

					<ListView.Header>
						<Border Height="40"
						        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
						        BorderBrush="{ThemeResource AccentAAFillColorDefaultBrush}"
						        BorderThickness="0,0,0,2"
						        CornerRadius="8">

							<interactivity:Interaction.Behaviors>
								<behaviors:StickyHeaderBehavior />
							</interactivity:Interaction.Behaviors>

							<controls:DataTable x:Name="Header"
							                    Margin="12,0,0,0"
							                    ColumnSpacing="10">
								<controls:DataColumn DesiredWidth="40" />
								<controls:DataColumn Content="Title"
								                     DesiredWidth="250"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
								<controls:DataColumn Content="Artists"
								                     DesiredWidth="*"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
								<controls:DataColumn DesiredWidth="*">
									<TextBlock FontWeight="Bold"
									           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
									           Text="Album" />
								</controls:DataColumn>
								<controls:DataColumn Content="Duration"
								                     DesiredWidth="75"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
								<controls:DataColumn Content="Played"
								                     DesiredWidth="115"
								                     FontWeight="Bold"
								                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
							</controls:DataTable>
						</Border>
					</ListView.Header>

					<ListView.ItemTemplate>
						<DataTemplate x:DataType="common:Song">
							<controls:DataRow HorizontalAlignment="Left"
							                  Background="Transparent"
							                  ContextFlyout="{StaticResource RightClickMenu}">
								<Grid Width="40"
								      Height="60"
								      Margin="0,2,0,2"
								      CornerRadius="10">
									<Image VerticalAlignment="Center"
									       Source="{x:Bind Cover}" />
								</Grid>
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Text="{x:Bind Title}"
								           TextTrimming="CharacterEllipsis">
									<ToolTipService.ToolTip>
										<TextBlock TextTrimming="CharacterEllipsis"
										           TextWrapping="WrapWholeWords">
											<Run Text="Title: " />
											<Run FontWeight="Bold"
											     Text="{x:Bind Title}" />
										</TextBlock>
									</ToolTipService.ToolTip>
								</TextBlock>
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Text="{x:Bind Artists}">
									<ToolTipService.ToolTip>
										<TextBlock TextTrimming="CharacterEllipsis"
										           TextWrapping="WrapWholeWords">
											<Run Text="Artists: " />
											<Run FontWeight="Bold"
											     Text="{x:Bind Artists}" />
										</TextBlock>
									</ToolTipService.ToolTip>
								</TextBlock>
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Text="{x:Bind Album}">
									<ToolTipService.ToolTip>
										<TextBlock TextTrimming="CharacterEllipsis"
										           TextWrapping="WrapWholeWords">
											<Run Text="Album: " />
											<Run FontWeight="Bold"
											     Text="{x:Bind Album}" />
										</TextBlock>
									</ToolTipService.ToolTip>
								</TextBlock>
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           HorizontalTextAlignment="Left"
								           Text="{x:Bind Duration, Converter={StaticResource DurationConverter}}">
									<ToolTipService.ToolTip>
										<TextBlock>
											<Run Text="Duration: " />
											<Run FontWeight="Bold"
											     Text="{x:Bind Duration, Converter={StaticResource DurationToFullTimeConverter}}" />
										</TextBlock>
									</ToolTipService.ToolTip>
								</TextBlock>
								<TextBlock HorizontalAlignment="Left"
								           VerticalAlignment="Center"
								           Text="{x:Bind PlayCount}">
									<ToolTipService.ToolTip>
										<TextBlock>
											<Run Text="Times played: " />
											<Run FontWeight="Bold"
											     Text="{x:Bind PlayCount}" />
										</TextBlock>
									</ToolTipService.ToolTip>
								</TextBlock>
							</controls:DataRow>
						</DataTemplate>
					</ListView.ItemTemplate>
					<ListView.ItemContainerStyle>
						<Style BasedOn="{StaticResource DefaultListViewItemStyle}"
						       TargetType="ListViewItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListView.ItemContainerStyle>
					<ListView.ItemContainerTransitions>
						<TransitionCollection>
							<AddDeleteThemeTransition />
							<ContentThemeTransition />
						</TransitionCollection>
					</ListView.ItemContainerTransitions>
				</ListView>
			</Grid>
			<Grid x:Name="MostPlayedSongsCompactViewGrid">
				<ListView x:Name="MostPlayedSongsCompactView"
				          Margin="10,10,10,10"
				          Padding="0,0,35,0"
				          VerticalAlignment="Top"
				          IsItemClickEnabled="True"
				          IsMultiSelectCheckBoxEnabled="False"
				          IsRightTapEnabled="True"
				          ItemClick="ListView_ItemClick"
				          ItemsSource="{x:Bind MostPlayedSongs}"
				          ScrollViewer.CanContentRenderOutsideBounds="False"
				          ScrollViewer.VerticalScrollBarVisibility="Visible"
				          ScrollViewer.VerticalScrollMode="Enabled"
				          SelectionChanged="ListView_SelectionChanged"
				          SelectionMode="Single">

					<ListView.ItemsPanel>
						<ItemsPanelTemplate>
							<ItemsStackPanel Orientation="Vertical" />
						</ItemsPanelTemplate>
					</ListView.ItemsPanel>

					<ListView.ItemTemplate>
						<DataTemplate x:DataType="common:Song">
							<Grid Background="Transparent"
							      ContextFlyout="{StaticResource RightClickMenu}">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*" />
									<ColumnDefinition Width="120" />
								</Grid.ColumnDefinitions>
								<Grid Grid.Column="0"
								      HorizontalAlignment="Left"
								      VerticalAlignment="Center">
									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="100" />
											<ColumnDefinition Width="20" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<Grid Grid.Column="0"
										      Width="100"
										      Height="100"
										      Margin="0,10,0,10">
											<Grid Width="Auto"
											      Height="Auto"
											      HorizontalAlignment="Center"
											      VerticalAlignment="Center"
											      CornerRadius="10">
												<Image HorizontalAlignment="Center"
												       VerticalAlignment="Center"
												       Source="{x:Bind Cover}" />
											</Grid>
										</Grid>
										<StackPanel Grid.Column="2"
										            HorizontalAlignment="Center"
										            VerticalAlignment="Center"
										            Orientation="Vertical"
										            Spacing="5">
											<TextBlock HorizontalAlignment="Left"
											           VerticalAlignment="Center"
											           MaxLines="2"
											           Style="{ThemeResource SubtitleTextBlockStyle}"
											           Text="{x:Bind Title}"
											           TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<ToolTipService.ToolTip>
													<TextBlock TextTrimming="CharacterEllipsis"
													           TextWrapping="WrapWholeWords">
														<Run Text="Title: " />
														<Run FontWeight="Bold"
														     Text="{x:Bind Title}" />
													</TextBlock>
												</ToolTipService.ToolTip>
											</TextBlock>
											<TextBlock HorizontalAlignment="Left"
											           VerticalAlignment="Center"
											           MaxLines="2"
											           Style="{ThemeResource BodyStrongTextBlockStyle}"
											           Text="{x:Bind Artists}"
											           TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<ToolTipService.ToolTip>
													<TextBlock TextTrimming="CharacterEllipsis"
													           TextWrapping="WrapWholeWords">
														<Run Text="Artists: " />
														<Run FontWeight="Bold"
														     Text="{x:Bind Artists}" />
													</TextBlock>
												</ToolTipService.ToolTip>
											</TextBlock>
											<TextBlock HorizontalAlignment="Left"
											           VerticalAlignment="Center"
											           MaxLines="2"
											           Style="{ThemeResource BodyStrongTextBlockStyle}"
											           Text="{x:Bind Album}"
											           TextTrimming="CharacterEllipsis"
											           TextWrapping="WrapWholeWords">
												<ToolTipService.ToolTip>
													<TextBlock TextTrimming="CharacterEllipsis"
													           TextWrapping="WrapWholeWords">
														<Run Text="Album: " />
														<Run FontWeight="Bold"
														     Text="{x:Bind Album}" />
													</TextBlock>
												</ToolTipService.ToolTip>
											</TextBlock>
										</StackPanel>
									</Grid>
								</Grid>
								<Grid Grid.Column="1"
								      Width="120"
								      HorizontalAlignment="Right"
								      VerticalAlignment="Center">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="10" />
										<RowDefinition Height="Auto" />
										<RowDefinition Height="5" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>
									<Grid Grid.Row="0"
									      VerticalAlignment="Center">
										<TextBlock HorizontalAlignment="Right"
										           VerticalAlignment="Center"
										           FontWeight="Bold"
										           Style="{ThemeResource BodyStrongTextBlockStyle}"
										           Text="{x:Bind PlayCount}">
											<ToolTipService.ToolTip>
												<TextBlock>
													<Run Text="Times played: " />
													<Run FontWeight="Bold"
													     Text="{x:Bind PlayCount}" />
												</TextBlock>
											</ToolTipService.ToolTip>
										</TextBlock>
									</Grid>
									<Grid Grid.Row="2"
									      VerticalAlignment="Center">
										<TextBlock HorizontalAlignment="Right"
										           VerticalAlignment="Center"
										           Style="{ThemeResource BodyStrongTextBlockStyle}"
										           Text="{x:Bind Year}">
											<ToolTipService.ToolTip>
												<TextBlock>
													<Run Text="Year: " />
													<Run FontWeight="Bold"
													     Text="{x:Bind Year}" />
												</TextBlock>
											</ToolTipService.ToolTip>
										</TextBlock>
									</Grid>
									<Grid Grid.Row="4"
									      VerticalAlignment="Center">
										<TextBlock HorizontalAlignment="Right"
										           VerticalAlignment="Center"
										           HorizontalTextAlignment="Right"
										           Style="{ThemeResource BodyStrongTextBlockStyle}"
										           Text="{x:Bind Duration, Converter={StaticResource DurationConverter}}">
											<ToolTipService.ToolTip>
												<TextBlock>
													<Run Text="Duration: " />
													<Run FontWeight="Bold"
													     Text="{x:Bind Duration, Converter={StaticResource DurationToFullTimeConverter}}" />
												</TextBlock>
											</ToolTipService.ToolTip>
										</TextBlock>
									</Grid>
								</Grid>
							</Grid>
						</DataTemplate>
					</ListView.ItemTemplate>
					<ListView.ItemContainerStyle>
						<Style BasedOn="{StaticResource DefaultListViewItemStyle}"
						       TargetType="ListViewItem">
							<Setter Property="HorizontalContentAlignment" Value="Stretch" />
						</Style>
					</ListView.ItemContainerStyle>

					<ListView.ItemContainerTransitions>
						<TransitionCollection>
							<AddDeleteThemeTransition />
							<ContentThemeTransition />
						</TransitionCollection>
					</ListView.ItemContainerTransitions>

				</ListView>
			</Grid>
		</Grid>
	</Grid>
</Page>
