<?xml version="1.0" encoding="utf-8" ?>

<Page x:Class="Tunetastic.Views.MusicControl"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:helpers="using:Tunetastic.Common.Controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="140" />
		</Grid.RowDefinitions>
		<Grid x:Name="MusicControls"
		      Grid.Row="1"
		      Margin="0,0,0,0"
		      VerticalAlignment="Bottom">
			<Grid.RowDefinitions>
				<RowDefinition Height="*" />
				<RowDefinition Height="40" />
			</Grid.RowDefinitions>
			<Grid Grid.Row="1">
				<helpers:SmoothProgressBar x:Name="BottomProgressBar"
				                           Margin="10,-25,10,0"
				                           VerticalAlignment="Center" />
			</Grid>
			<Grid Grid.Row="0"
			      Margin="10,0,10,15">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*" />
					<ColumnDefinition Width="Auto" />
					<ColumnDefinition Width="*" />
				</Grid.ColumnDefinitions>

				<Grid Grid.Column="0"
				      HorizontalAlignment="Stretch">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="70" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="40" />
					</Grid.ColumnDefinitions>

					<TextBlock x:Name="CurrentDurationConverter"
					           Grid.Column="0"
					           HorizontalAlignment="Center"
					           VerticalAlignment="Center"
					           FontSize="15"
					           Style="{ThemeResource BodyTextBlockStyle}"
					           Text="{Binding ElementName=BottomProgressBar, Path=Position, Converter={StaticResource DurationConverter}}" />

					<ToggleButton x:Name="ShuffleButton"
					              Grid.Column="2"
					              Width="55"
					              Height="55"
					              Command="{x:Bind ViewModel.ShuffleToggleCommand}"
					              CornerRadius="23"
					              IsChecked="{x:Bind ViewModel.IsShuffleToggled, Mode=TwoWay}"
					              ToolTipService.ToolTip="{x:Bind ViewModel.ToolTipTextShuffleButton, Mode=OneWay}">
						<FontIcon Glyph="&#xE8B1;" />
					</ToggleButton>
				</Grid>

				<StackPanel Grid.Column="1"
				            VerticalAlignment="Center"
				            Orientation="Horizontal">
					<RepeatButton x:Name="RewindButton"
					              Width="55"
					              Height="55"
					              Margin="5,0"
					              ClickMode="Press"
					              Command="{x:Bind ViewModel.RewindSongCommand}"
					              CornerRadius="23"
					              ToolTipService.ToolTip="1 sec Rewind">
						<FontIcon Glyph="&#xEB9E;" />
					</RepeatButton>

					<Button x:Name="PrevButton"
					        Width="55"
					        Height="55"
					        Margin="5,0"
					        Command="{x:Bind ViewModel.PreviousSongCommand}"
					        CornerRadius="23"
					        ToolTipService.ToolTip="Previos Track">
						<SymbolIcon Symbol="Previous" />
					</Button>

					<Button x:Name="PlayPauseButton"
					        Width="90"
					        Height="65"
					        Margin="10,0"
					        Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
					        CornerRadius="30"
					        Style="{StaticResource AccentButtonStyle}"
					        ToolTipService.ToolTip="{x:Bind ViewModel.ToolTipTextPlayPause, Mode=OneWay}">
						<FontIcon Glyph="{x:Bind ViewModel.FontIconPlayPause, Mode=OneWay}" />
					</Button>

					<Button x:Name="NextButton"
					        Width="55"
					        Height="55"
					        Margin="5,0"
					        ClickMode="Press"
					        Command="{x:Bind ViewModel.NextSongCommand}"
					        CornerRadius="23"
					        ToolTipService.ToolTip="Next Track">
						<SymbolIcon Symbol="Next" />
					</Button>

					<RepeatButton x:Name="ForwardButton"
					              Width="55"
					              Height="55"
					              Margin="5,0"
					              Command="{x:Bind ViewModel.ForwardSongCommand}"
					              CornerRadius="23"
					              ToolTipService.ToolTip="1 sec Forward">
						<FontIcon Glyph="&#xEB9D;" />
					</RepeatButton>
				</StackPanel>

				<Grid Grid.Column="2"
				      HorizontalAlignment="Stretch">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="40" />
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="70" />
					</Grid.ColumnDefinitions>

					<Button x:Name="RepeatButton"
					        Grid.Column="1"
					        Width="55"
					        Height="55"
					        Command="{x:Bind ViewModel.RepeatButtonToggleCommand}"
					        CornerRadius="23"
					        Style="{x:Bind ViewModel.RepeatButtonStyle, Mode=OneWay}"
					        ToolTipService.ToolTip="{x:Bind ViewModel.ToolTipTextRepeatButton, Mode=OneWay}">
						<FontIcon Glyph="{x:Bind ViewModel.RepeatButtonFontIcon, Mode=OneWay}" />
					</Button>

					<TextBlock Grid.Column="3"
					           HorizontalAlignment="Center"
					           VerticalAlignment="Center"
					           FontSize="15"
					           Style="{ThemeResource BodyTextBlockStyle}"
					           Text="{x:Bind ViewModel.DurationOfSong, Converter={StaticResource DurationConverter}, Mode=OneWay}" />
				</Grid>
			</Grid>
		</Grid>
		<Grid Background="Transparent"
		      IsHitTestVisible="False">
			<Grid Width="Auto"
			      Height="64"
			      Margin="20,5,0,0"
			      HorizontalAlignment="Left"
			      VerticalAlignment="Top">
				<Grid.RenderTransform>
					<TranslateTransform x:Name="SongInfoTransform" Y="0" />
				</Grid.RenderTransform>
				<Border x:Name="TrackInfo"
				        VerticalAlignment="Bottom"
				        Background="{ThemeResource LayerOnMicaBaseAltFillColorDefault}"
				        BorderThickness="1"
				        CornerRadius="23"
				        Opacity="0">
					<StackPanel Padding="5,2,5,2"
					            Orientation="Horizontal"
					            Spacing="3">
						<Grid>
							<Border Width="50"
							        Height="50"
							        CornerRadius="50">
								<Image x:Name="AlbumCover"
								       Source="{x:Bind ViewModel.Cover, Mode=OneWay}"
								       Stretch="Fill" />
							</Border>
						</Grid>

						<StackPanel Width="auto"
						            VerticalAlignment="Center"
						            Orientation="Vertical">
							<TextBlock HorizontalAlignment="Left"
							           VerticalAlignment="Center"
							           FontWeight="ExtraBold"
							           HorizontalTextAlignment="Center"
							           Text="{x:Bind ViewModel.Title, Mode=OneWay}"
							           TextAlignment="Center"
							           TextTrimming="CharacterEllipsis"
							           TextWrapping="NoWrap" />
							<TextBlock HorizontalAlignment="Left"
							           VerticalAlignment="Center"
							           FontStyle="Italic"
							           FontWeight="SemiBold"
							           HorizontalTextAlignment="Center"
							           Text="{x:Bind ViewModel.Artist, Mode=OneWay}"
							           TextAlignment="Center"
							           TextTrimming="CharacterEllipsis"
							           TextWrapping="NoWrap" />
						</StackPanel>

					</StackPanel>
				</Border>
			</Grid>
		</Grid>
	</Grid>
</Page>
